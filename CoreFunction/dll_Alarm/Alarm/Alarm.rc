    CONTROL         "",IDC_MONTHCALENDAR_FROM,"SysMonthCal32",MCS_NOTODAY | MCS_NOTODAYCIRCLE | WS_TABSTOP,7,18,125,72
    CONTROL         "",IDC_MONTHCALENDAR_TO,"SysMonthCal32",MCS_NOTODAY | MCS_NOTODAYCIRCLE | WS_TABSTOP,7,103,125,72
    CTEXT           "Alarm CODE",IDC_STATIC,7,194,44,17,SS_CENTERIMAGE | WS_BORDER
