IDD_DLG_ALARM DIALOGEX 0, 0, 650, 550
STYLE DS_SETFONT | WS_CHILD | WS_BORDER
FONT 9, "굴림", 400, 0, 0x81
BEGIN
    CTEXT           "ALARM",IDC_STATIC_ALARM_TITLE,0,7,650,18,SS_CENTERIMAGE | WS_BORDER
    CONTROL         "",IDC_LIST_ALARM,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,0,378,650,165
    CONTROL         "",IDC_STATIC_ALARM_MODULE,"Static",SS_BLACKFRAME,40,26,570,350
    CTEXT           "IDC_FPSPREAD_RESULT_DATA",IDC_FPSPREAD_RESULT_DATA,0,26,11,15,SS_CENTERIMAGE | NOT WS_VISIBLE
END

IDD_DLG_ALARM_MODULE DIALOGEX 0, 0, 570, 350
STYLE DS_SETFONT | WS_CHILD | WS_BORDER
FONT 9, "굴림", 400, 0, 0x81
BEGIN
    CTEXT           "-----",IDC_STATIC_ALARM_ID,79,22,202,28,SS_CENTERIMAGE | WS_BORDER
    CTEXT           "-----",IDC_STATIC_ALARM_TYPE,79,54,410,28,SS_CENTERIMAGE | WS_BORDER
    CTEXT           "-----",IDC_STATIC_ALARM_MODULE,287,22,202,28,SS_CENTERIMAGE | WS_BORDER
    CTEXT           "-----",IDC_STATIC_ALARM_COMMAND,79,86,410,28,SS_CENTERIMAGE | WS_BORDER
    CTEXT           "-----",IDC_STATIC_ALARM_TEXT,79,118,410,121,SS_CENTERIMAGE | WS_BORDER
    LTEXT           "IGNORE : Work Successed and Continue ( !!!  Be careful of handling)\r\n\r\n STOP :  Work Stop and change the maintenance mode",IDC_STATIC_ALARM_DESC,79,299,410,28,SS_CENTERIMAGE
    PUSHBUTTON      "IGNORE",IDC_BUTTON_ALARM_MODULE_IGNORE,291,248,82,38
    PUSHBUTTON      "STOP",IDC_BUTTON_ALARM_MODULE_STOP,391,248,82,38
    PUSHBUTTON      "INIT + RETRY",IDC_BUTTON_ALARM_MODULE_INIT_RETRY,191,248,82,38
    PUSHBUTTON      "RETRY",IDC_BUTTON_ALARM_MODULE_RETRY,91,248,82,38
END

IDD_DLG_ALARM_WARNING DIALOGEX 0, 0, 401, 200
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Warning Message"
FONT 10, "Tahoma", 0, 0, 0x1
BEGIN
