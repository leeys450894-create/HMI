			if (g_inRcpInfo.LoadRcpFile (strName)) {

				if (!g_inRcpInfo.GetAlignRecipeName().IsEmpty()) m_pAlignRcpDlg->LoadAlignRecipe (g_inRcpInfo.GetAlignRecipeName ());
