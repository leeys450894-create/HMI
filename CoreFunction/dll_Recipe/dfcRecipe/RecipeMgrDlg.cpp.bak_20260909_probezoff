void	C_RecipeMgrDlg::UpdateUI ()
{
	static BOOL bEnable = TRUE;

	if (m_pRecipeMem->m_sRunState.m_nRunStatus == M_RUN_NONE) {
		if (bEnable) {
			EnableControls (TRUE);
			m_pMakeCellDlg->EnableControls (TRUE);
			m_pSelectCellDlg->EnableControls (TRUE);
			m_pAlignRcpDlg->EnableControls (TRUE);

			bEnable = FALSE;
		}
	}
	else {
		if (!bEnable) {
			EnableControls (FALSE);
			m_pMakeCellDlg->EnableControls (FALSE);
			m_pSelectCellDlg->EnableControls (FALSE);
			m_pAlignRcpDlg->EnableControls (FALSE);

			bEnable = TRUE;
		}
	}

	if (m_pRecipeMem->m_sRunState.m_nRunStatus == M_RUN_END) {	//완료 처리
		if (m_pRecipeMem->m_sRunState.m_dwData1 == M_CMD_GLASS_GET_POS) {
			m_pAlignRcpDlg->SetAlignPos (m_pRecipeMem->m_sRunState.m_fData);
		}
		else if (m_pRecipeMem->m_sRunState.m_dwData1 == M_CMD_PROBE_GET_POS) {
			m_pAlignRcpDlg->SetProbePos (m_pRecipeMem->m_sRunState.m_fData);
		}
		else if (m_pRecipeMem->m_sRunState.m_dwData1 == M_CMD_GLASS_PROC) {
			m_pAlignRcpDlg->SetAlignEndPos (m_pRecipeMem->m_sRunState.m_fData, 0);
		}
		else if (m_pRecipeMem->m_sRunState.m_dwData1 == M_CMD_PROBE_PROC) {
			m_pAlignRcpDlg->SetAlignEndPos (m_pRecipeMem->m_sRunState.m_fData, 1);
		}
		else if (m_pRecipeMem->m_sRunState.m_dwData1 == M_CMD_STAGE_GET_POS) {
			SetStageGetPos (m_pRecipeMem->m_sRunState.m_fData);
		}
		else if (m_pRecipeMem->m_sRunState.m_dwData1 == M_CMD_HEAD_GET_POS) {
			SetHeadGetPos (m_pRecipeMem->m_sRunState.m_fData);
		}

		m_pRecipeMem->m_sRunState.m_nRunStatus = M_RUN_NONE;
	}
	else if (m_pRecipeMem->m_sRunState.m_nRunStatus == M_RUN_NG) { //실패 처리

		m_pRecipeMem->m_sRunState.m_nRunStatus = M_RUN_NONE;
	}
}

void	C_RecipeMgrDlg::AlignRcpEventProc (int nItem, int nItem2)
{
	m_pRecipeMem->m_sRunState.Clear ();

	////m_dwData1
	if		(nItem == M_ALIGN_SHOW_REFIMG)    m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_SHOW_REF_SET;
	else if (nItem == M_ALIGN_PATTERN_SEARCH) m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_PATTERN_SEARCH;
	else if (nItem == M_ALIGN_CCD_SET)		  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_CCD_SET;
	else if (nItem == M_ALIGN_GLASS_GET_POS)  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_GLASS_GET_POS;
	else if (nItem == M_ALIGN_GLASS_MOVE)	  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_GLASS_MOVE;
	else if (nItem == M_ALIGN_PROBE_GET_POS)  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_PROBE_GET_POS;
	else if (nItem == M_ALIGN_PROBE_MOVE)     m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_PROBE_MOVE;
	else if (nItem == M_ALIGN_GLASS_PROC)	  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_GLASS_PROC;
	else if (nItem == M_ALIGN_PROBE_PROC)	  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_PROBE_PROC;
	else if (nItem == M_ALIGN_RESET)		  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_RESET;
	else if (nItem == M_RCP_LAMP_SET)		  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_LAMP_SET;
	else if (nItem == M_RCP_CONTACT_SET)	  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_CONTACT_SET;
	else if (nItem == M_RCP_STAGE_GET_POS)    m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_STAGE_GET_POS;
	else if (nItem == M_RCP_STAGE_MOVE)		  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_STAGE_MOVE;
	else if (nItem == M_RCP_PROBE_MOVE)		  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_STAGE_PROBE_MOVE;
	else if (nItem == M_RCP_HEAD_GET_POS)	  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_HEAD_GET_POS;
	else if (nItem == M_RCP_HEAD_MOVE)		  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_HEAD_MOVE;
	else if (nItem == M_RCP_SRM_LAMP_SET)	  m_pRecipeMem->m_sRunState.m_dwData1 = M_CMD_SRM_LAMP_SET;

	////m_dwData2
	if (nItem == M_ALIGN_SHOW_REFIMG || nItem == M_ALIGN_PATTERN_SEARCH || nItem == M_ALIGN_CCD_SET || nItem == M_RCP_LAMP_SET || nItem == M_RCP_SRM_LAMP_SET) {
		if		(/*m_pAlignRcpDlg->GetSelHead ()*/nItem2 == ALG_FRONT_LEFT)  m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_FRONT_LEFT;
		else if (/*m_pAlignRcpDlg->GetSelHead ()*/nItem2 == ALG_FRONT_RIGHT) m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_FRONT_RIGHT;
		else if (/*m_pAlignRcpDlg->GetSelHead ()*/nItem2 == ALG_BACK_LEFT)   m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_BACK_LEFT;
		else if (/*m_pAlignRcpDlg->GetSelHead ()*/nItem2 == ALG_BACK_RIGHT)  m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_BACK_RIGHT;
		else if (/*m_pAlignRcpDlg->GetSelHead ()*/nItem2 == ALG_FRONT)  m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_FRONT;
		else if (/*m_pAlignRcpDlg->GetSelHead ()*/nItem2 == ALG_BACK)  m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_BACK;
		else  m_pRecipeMem->m_sRunState.m_dwData2 = 0;
	}
	else if (nItem == M_RCP_CONTACT_SET) {
//		if (nItem2 == 4) m_pRecipeMem->m_sRunState.m_dwData2 = M_PROBE_MOVE_POS; //Contact + OD
		if (nItem2 == 0 || nItem2 == 1) m_pRecipeMem->m_sRunState.m_dwData2 = M_PROBE_MOVE_POS; //Ready or Pre-Contact
		else							m_pRecipeMem->m_sRunState.m_dwData2 = M_PROBE_MOVE_OD;  //Contact + OD
	}
	else if (nItem == M_RCP_HEAD_GET_POS || nItem == M_RCP_HEAD_MOVE) {
		if (m_nHeadSel == RCP_HEAD_LEFT) m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_LEFT;
		else							 m_pRecipeMem->m_sRunState.m_dwData2 = M_HEAD_RIGHT;
	}

	////m_dwData3
	if (nItem == M_RCP_HEAD_GET_POS || nItem == M_RCP_HEAD_MOVE) {
		if		(m_nHeadMode == RCP_MODE_REVIEW)  m_pRecipeMem->m_sRunState.m_dwData3 = M_TYPE_REVIEW;
		else if (m_nHeadMode == RCP_MODE_SPEC)    m_pRecipeMem->m_sRunState.m_dwData3 = M_TYPE_SPEC;
		else if (m_nHeadMode == RCP_MODE_QUALITY) m_pRecipeMem->m_sRunState.m_dwData3 = M_TYPE_QUALITY;
		else if (m_nHeadMode == RCP_MODE_COLOR)   m_pRecipeMem->m_sRunState.m_dwData3 = M_TYPE_COLOR;
		else if (m_nHeadMode == RCP_MODE_ANGLE)   m_pRecipeMem->m_sRunState.m_dwData3 = M_TYPE_ANGLE;		
	}

	////nData or fData
	if (nItem == M_ALIGN_PATTERN_SEARCH) {
		wcscpy_s (m_pRecipeMem->m_sRunState.m_chData1, m_pAlignRcpDlg->GetRefImageName ());
		m_pRecipeMem->m_sRunState.m_nData[0] = m_pAlignRcpDlg->GetMatchingScore ();

	}
	else if	(nItem == M_ALIGN_CCD_SET)	  m_pAlignRcpDlg->GetCcdCurrentVal (m_pRecipeMem->m_sRunState.m_nData);
	else if (nItem == M_ALIGN_GLASS_MOVE)
	{ 
		m_pRecipeMem->m_sRunState.m_nData[0] = m_pAlignRcpDlg->GetProbeSel();
		m_pAlignRcpDlg->GetAlignPos(m_pRecipeMem->m_sRunState.m_fData);
	}
	else if (nItem == M_ALIGN_PROBE_MOVE) {
		m_pRecipeMem->m_sRunState.m_nData[0] = m_pAlignRcpDlg->GetProbeSel ();
		m_pAlignRcpDlg->GetProbePos (m_pRecipeMem->m_sRunState.m_fData);
	}
	else if (nItem == M_ALIGN_GLASS_PROC || nItem == M_ALIGN_PROBE_PROC) {
		m_pRecipeMem->m_sAlign.Clear ();

		if		(nItem == M_ALIGN_GLASS_PROC) m_pAlignRcpDlg->GetGlassAlignData (TRUE, &m_pRecipeMem->m_sAlign.m_sGlsAlign);
		else if (nItem == M_ALIGN_PROBE_PROC) {
			m_pRecipeMem->m_sRunState.m_nData[0] = m_pAlignRcpDlg->GetProbeSel ();
			m_pAlignRcpDlg->GetProbeAlignData (TRUE, &m_pRecipeMem->m_sAlign.m_sProbeAlign);
		}

		m_pAlignRcpDlg->GetCcdSetMntData (TRUE, &m_pRecipeMem->m_sAlign.m_sCcdSet);
		m_pAlignRcpDlg->GetRefImageData (TRUE, &m_pRecipeMem->m_sAlign);
		m_pAlignRcpDlg->GetMarginData (TRUE, &m_pRecipeMem->m_sAlign.m_sMargin);
	}
	else if (nItem == M_RCP_LAMP_SET) {
		if (!GetLampData (m_pRecipeMem->m_sRunState.m_nData, nItem2)) return;
	}
	else if (nItem == M_RCP_CONTACT_SET) {
		if (!GetContactData (m_pRecipeMem->m_sRunState.m_fData, nItem2)) return;
	}
	else if (nItem == M_RCP_STAGE_MOVE || nItem == M_RCP_PROBE_MOVE) {
		if (!GetStageMoveData (m_pRecipeMem->m_sRunState.m_fData)) return;
	}
	else if (nItem == M_RCP_HEAD_MOVE) {
		if (!GetHeadGetPos (m_pRecipeMem->m_sRunState.m_fData)) return;
	}
	else if (nItem == M_RCP_SRM_LAMP_SET) {
		if (!GetSRMLampData(m_pRecipeMem->m_sRunState.m_nData, nItem2)) return;
	}

	//진행 요청
	m_pRecipeMem->m_sRunState.m_nRunStatus = M_RUN_REQ;
}

void	C_RecipeMgrDlg::WritePPIDFile (CString strModel)
{
	m_iniPPID.WriteProfileInt (strModel, _T("m_nCellWidthNum"), g_inRcpInfo.GetCellCount (0));
	m_iniPPID.WriteProfileInt (strModel, _T("m_nCellHeightNum"), g_inRcpInfo.GetStickCount ());

	m_iniPPID.WriteProfileInt (strModel, _T("m_nAttachDirection"), 1);
	m_iniPPID.WriteProfileInt (strModel, _T("m_nProbePinCompCount"), 1);
	m_iniPPID.WriteProfileInt (strModel, _T("m_nProbeContactCellIdx"), 1);
	m_iniPPID.WriteProfileInt (strModel, _T("m_nProbeContactPadIdx"), 1);

	m_iniPPID.WriteProfileString (strModel, _T("m_lfCellSizeWidth"), dfcStr (g_inRcpInfo.m_recipeMgr.m_sMap.m_fCellSize.x));
	m_iniPPID.WriteProfileString (strModel, _T("m_lfCellSizeHeight"), dfcStr (g_inRcpInfo.m_recipeMgr.m_sMap.m_fCellSize.y));
	m_iniPPID.WriteProfileString (strModel, _T("m_lfGlassSizeWidth"), dfcStr ((double)RCP_GLASS_SIZE_X));
	m_iniPPID.WriteProfileString (strModel, _T("m_lfGlassSizeHeight"), dfcStr ((double)RCP_GLASS_SIZE_Y));

	for (int i = 0; i < CAD_ROW_P1_1; i++) {//CAD_ROW_A ~ CAD_ROW_X7
		m_iniPPID.WriteProfileString (strModel, dfcStr (_T("m_lfCellDist[%d]"), i), dfcStr (g_inRcpInfo.m_recipeMgr.m_sMap.m_fCadData[i]));
	}

	for (int i = 0; i < CAD_ROW_END - CAD_ROW_P1_1; i++) {//CAD_ROW_P1_1 ~ CAD_ROW_P5_2
		m_iniPPID.WriteProfileString (strModel, dfcStr (_T("m_szMachingProbeRFID[%d]"), i), g_inRcpInfo.m_recipeMgr.m_sMap.m_chCadData[i]);
	}
}

void C_RecipeMgrDlg::MakeRcpList ()
