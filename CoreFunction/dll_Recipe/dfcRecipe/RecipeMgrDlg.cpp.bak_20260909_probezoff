void	C_RecipeMgrDlg::OnSelAlignRcp (NMHDR *pNMHDR, LRESULT *pResult)
{
	NM_GRIDVIEW*	pNMLV = reinterpret_cast<NM_GRIDVIEW*>(pNMHDR);

	if (pNMLV->iColumn != 1 || pNMLV->iRow != 7) return;

	CString strfilePath, strName;
	strfilePath.Format (_T("%s*.alg"), theApp.m_strAlignFolder);
	CFileDialog dlg (TRUE, _T("alg"), strfilePath, OFN_FILEMUSTEXIST | OFN_NOCHANGEDIR, _T("Recipe Files (*.alg)|*.alg|"));

	if (dlg.DoModal() == IDOK)
	{			
		strName = dlg.GetFileName ();

		if (!strName.IsEmpty ()) {
			int nFind = strName.Find (_T(".alg"));

			if (nFind > 0)	strName = strName.Left (nFind);
			else			strName = strName;

			SetAlignName (strName);
		}
		else {
			AfxMessageBox (_T("선택된 레시피가 없습니다."));
			return;
		}
	}	
}

void	C_RecipeMgrDlg::OnSetCcdLamp (NMHDR *pNMHDR, LRESULT *pResult)
{
	NM_GRIDVIEW*	pNMLV = reinterpret_cast<NM_GRIDVIEW*>(pNMHDR);
	if (pNMLV->iColumn != 2) return;

	CString strCcd;
	if		(pNMLV->iRow == ALG_FRONT_LEFT)  strCcd = _T("특성축 Left");
	else if (pNMLV->iRow == ALG_FRONT_RIGHT) strCcd = _T("특성축 Right");
	else if (pNMLV->iRow == ALG_BACK_LEFT)   strCcd = _T("화질축 Left");
	else if (pNMLV->iRow == ALG_BACK_RIGHT)  strCcd = _T("화질축 Right");

	if (AfxMessageBox (dfcStr (_T("%s CCD 조명 값을 적용 합니다.\n 계속 하시겠습니까?"), strCcd), MB_YESNO|MB_ICONQUESTION) != IDYES) return;

	::PostMessage (GetSafeHwnd (), WM_RECIPE_EVENT, (WPARAM)M_RCP_LAMP_SET, pNMLV->iRow);
}

void	C_RecipeMgrDlg::OnSetSRMLamp(NMHDR* pNMHDR, LRESULT* pResult)
{
	NM_GRIDVIEW* pNMLV = reinterpret_cast<NM_GRIDVIEW*>(pNMHDR);
	if (pNMLV->iColumn != 2) return;

	CString strCcd;
	if (pNMLV->iRow == ALG_FRONT_LEFT)  strCcd = _T("RED");
	else if (pNMLV->iRow == ALG_FRONT_RIGHT) strCcd = _T("GREEN");
	else if (pNMLV->iRow == ALG_BACK_LEFT)   strCcd = _T("BLUE");
	else if (pNMLV->iRow == ALG_BACK_RIGHT)  strCcd = _T("WHITE");

