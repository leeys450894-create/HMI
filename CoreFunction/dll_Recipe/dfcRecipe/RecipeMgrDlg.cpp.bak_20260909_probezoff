	if (!GetSRMLampData())		  return FALSE;	//SRM Lamp
	if (!GetContactData ())		  return FALSE;	//Contact Pos
	if (!GetStageMoveData ())	  return FALSE;	//Stage Pos
	if (!GetHeadZData ())		  return FALSE;	//Z Axis Pos
	if (!GetUserOffsetData ())	  return FALSE;	//User Offset
	if (!GetHeadMoveData ())	  return FALSE;	//Head Pos
	if (!GetSubZ())				  return FALSE;	//Sub Z
	if (!GetAngleAxis())		  return FALSE;	//Angle Axis

	return TRUE;
}

