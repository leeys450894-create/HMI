void	C_RecipeMgrDlg::SetHeadMoveData (int nStick)
{
	int nCnt = g_inRcpInfo.GetCellCount (nStick);
	InitHeadMove (nCnt);

	S_CellInfo sCell;
	for (int i = 0; i < nCnt; i++) {
		sCell = g_inRcpInfo.GetCellItem (nStick, i);

		m_gridHeadMoveData.SetItemText (i, 0, dfcStr (i + 1));
		m_gridHeadMoveData.SetItemText (i, 3, dfcStr (sCell.m_chCellID));
		m_gridHeadMoveData.SetItemText (i, 4, dfcStr (sCell.m_fCellY));
		m_gridHeadMoveData.SetItemText (i, 5, dfcStr (sCell.m_fCellX));
	}
}

BOOL	C_RecipeMgrDlg::GetHeadMoveData (int nStick)
{
	int nCellCnt = g_inRcpInfo.GetCellCount (nStick);

	S_CellInfo sCell;

	for (int i = 0; i < g_inRcpInfo.GetStickCount (); i++) {
		for (int j = 0; j < nCellCnt; j++) {
			sCell = g_inRcpInfo.GetCellItem (i, j);

			//wcscpy_s (sCell.m_chCellID, m_gridHeadMoveData.GetItemText (j, 3));
			sCell.m_fCellY = _wtof (m_gridHeadMoveData.GetItemText (j, 4));
			sCell.m_fCellX = _wtof (m_gridHeadMoveData.GetItemText (j, 5));

			g_inRcpInfo.SetCellItem (i, j, sCell);
		}
	}

	return TRUE;
}

