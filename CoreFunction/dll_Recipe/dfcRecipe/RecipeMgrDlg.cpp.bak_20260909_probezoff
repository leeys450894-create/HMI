	CStringArray arrRcp;
	arrRcp.RemoveAll ();

	//파일 찾기
	BOOL bExist = FALSE;
	CFileFind finder;
	BOOL bWorking = finder.FindFile (strPath);
	while (bWorking) {
		bWorking = finder.FindNextFile ();
		if (finder.IsDots () || finder.IsDirectory ()) continue;

		arrRcp.Add (finder.GetFileName ());
	}
	finder.Close ();
	//

	//List 생성
	CString strTime;
	int nCnt = (int) arrRcp.GetSize ();

