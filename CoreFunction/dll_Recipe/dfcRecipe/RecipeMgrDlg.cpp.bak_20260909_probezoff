				//		pOut->LoadAlignRcpFile(g_inRcpInfo.GetAlignRecipeName());
				//}
				//// Notify App (DlgMainForm) to refresh cell display
				//CWnd* pParent = GetParent();  // DlgSubRecipe
				//if (pParent && pParent->GetParent())
				//	pParent->GetParent()->PostMessage(WM_MSG_RECIPE_LOADED, NULL, NULL);
			}
			else {
				AfxMessageBox (_T("레시피 열기 실패!!."));
