LRESULT	C_RecipeMgrDlg::OnRecipeEvent (WPARAM wParam, LPARAM lParam)
{
	int nItem = (int)wParam;

	switch (nItem) {
		case M_MAKE_CELL_SET:
			SetRecipeView ();
			SendAlignKeyPos ();
			break;
		case M_ALIGN_SHOW_REFIMG:
		case M_ALIGN_PATTERN_SEARCH:
		case M_ALIGN_CCD_SET:
		case M_ALIGN_GLASS_GET_POS:
		case M_ALIGN_GLASS_MOVE:
		case M_ALIGN_PROBE_GET_POS:
		case M_ALIGN_PROBE_MOVE:
		case M_ALIGN_GLASS_PROC:
		case M_ALIGN_PROBE_PROC:
		case M_ALIGN_RESET:
		case M_RCP_LAMP_SET:
		case M_RCP_CONTACT_SET:
		case M_RCP_STAGE_GET_POS:
		case M_RCP_STAGE_MOVE:
		case M_RCP_PROBE_MOVE:
		case M_RCP_HEAD_GET_POS:
		case M_RCP_HEAD_MOVE:
		case M_RCP_SRM_LAMP_SET:
			AlignRcpEventProc (nItem, (int)lParam);
			break;
		case M_RCP_TEST_MODE:	// LYS 2026-07-02 (data already set by DlgTestMode, do not clear)
			m_pRecipeMem->m_sRunState.m_nRunStatus = M_RUN_REQ;
			break;
		case 0:
		{
			GetContactData();
			SetContactData();

			Invalidate(FALSE);
		}
			break;
	}

	return 0;
}

void C_RecipeMgrDlg::OnTimer (UINT_PTR nIDEvent)
{
	static int nTime = 0;
	static int nSec	 = 0;
	static bool bOdd = false;

	int nSel = 0;

	switch (nTime%3) {//각 case 마다 300ms 주기
		case 0:
			UpdateUI ();
		break;

		case 1:
			nSel = m_gridColorData.GetItemCurSel(0, 0);
			if (nSel >= 0)
			{
				if (nSel <= theApp.m_arrColorPosZ.GetSize()) {

					if (nSel != m_nSelOld) {
						m_gridColorData.SetItemText(0, 1, theApp.m_arrColorPosZ.GetAt(nSel));
						m_nSelOld = nSel;
						Invalidate(FALSE);
					}
				}
			}
		break;

		case 2:
			if (bOdd) {//600ms 주기
			}
			bOdd = !bOdd;
		break;
	}

	nTime++;
	if (nTime >= 3) {
		nTime = 0;
	}

	CDialogEx::OnTimer (nIDEvent);
}

