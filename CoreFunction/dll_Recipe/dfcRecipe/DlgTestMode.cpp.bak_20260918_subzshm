CDlgTestMode::CDlgTestMode(CWnd* pParent)
	: C_BaseDialog(IDD_DLG_TEST_MODE, pParent)
	, m_hWnd(pParent)
	, m_nTestMode(0)
	, m_nBfRowGlass(0)
	, m_nBColGlass(0)
	, m_nBfcrBkColour(COLOR_WHITE)
	, m_nCamSel(0)	// LYS 2026-09-16
{
	m_pRecipeMem = nullptr;
	m_pRecipeMem = g_pSysMapView;
}

CDlgTestMode::~CDlgTestMode()
{
}

