CDlgPLC::CDlgPLC(CWnd* pParent /*=NULL*/)
	: CDialog(CDlgPLC::IDD, pParent)
{
	m_strReceiveLog.Empty();
	memset(m_chReceiveLog, NULL, 2000);		// eh.kim 20170719 add.

	m_nMode = 0;
	m_nSocketIndex = 1;
	m_nStationNum = 5;
	m_nUseSize = 2;
	m_nUseGap  = 0;
	

	int i=0;
	for (i=0; i<dfMAXFDCITEM; i++)
	{
		m_bFilterUse[i] = FALSE;
		m_bFilter_Min[i] = 0;
		m_bFilter_Max[i] = 100;
		m_bFilter_Standard[i] = 50;
		m_bFilterValue[i] = FALSE;
	}

	ZeroMemory(&m_valArray, sizeof(m_valArray));

	for(i=0 ; i<dfMAXFDCITEM; i++)		// gdh 20180321 add
	{
		m_bShowFLog[i] = FALSE;
	}

	// eh.kim 20170206
	m_iStartSafetyTime	= 0;
	m_bStartSafety		= FALSE;
	//

	m_bStartSafetyPLCRead = FALSE;		// eh.kim 20171101 add.

	// eh.kim 20180104 add.
	m_bStartSafetyDefault = FALSE;	
	m_iStartSafetyDefaultCount = 0;
	//
	
	m_bSendOK = FALSE;

//	m_strArray.RemoveAll();
	m_strArrayForFLogList.RemoveAll();
}

CDlgPLC::~CDlgPLC()
{
}

void CDlgPLC::DoDataExchange(CDataExchange* pDX)
{
	CDialog::DoDataExchange(pDX);
	DDX_Control(pDX, IDC_LIST_PLC_LOG, m_lbPlcLog);
	DDX_Control(pDX, IDC_LIST_DPLC_LOG, m_lbDPlcLog);
}

void CDlgPLC::SetMainPoint(void* pvoid)
{
	g_pdlgMainPLC = (CFDCSenseDlg*) pvoid;
}


