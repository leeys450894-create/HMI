//sypark 20180529 add
int CDlgPLC::getPOW(int nNum)
{
	int nRnt =1; 

	for(int i= 0; i< nNum; i++)
		nRnt *= 10;

	return nRnt;
}

BOOL CDlgPLC::PreTranslateMessage(MSG* pMsg)
{
	// TODO: 여기에 특수화된 코드를 추가 및/또는 기본 클래스를 호출합니다.
	switch( pMsg->wParam )
	{
	case VK_ESCAPE:
	case VK_RETURN:
		return TRUE;
	}

	return CDialog::PreTranslateMessage(pMsg);
}

int CDlgPLC::WriteFDC_OffsetData(void)
{
	int i = 0;
	double dMfDataArray[dfMAXFDCITEM];
	FDCSPRED SpredData;
	ZeroMemory(&SpredData, sizeof(SpredData));
	ZeroMemory(&dMfDataArray, sizeof(dMfDataArray));

	for (i=0; i < dfMAXFDCITEM; i++)
	{
		if( g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion > 0 )
			dMfDataArray[i] = (double)( m_valArray[i] * getPOW(g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion));	
		else if( g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion < 0 )
			dMfDataArray[i] = (double)( m_valArray[i] / getPOW(g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion * -1));	
		else
			dMfDataArray[i] = (double)( m_valArray[i]);

		SpredData.dVal    = dMfDataArray[i]; 
		g_pdlgMainPLC->SetSpredData(i, SpredData);

		m_valArray[i] = dMfDataArray[i];
	}

	return 0;
}
