void CDlgPLC::OnBnClickedBtnConnetPlc()
{
	// TODO: Add your control notification handler code here
	GetConfig();

	SOCKET_OPEN stSockOpen;
	stSockOpen.nSockMode = SOCKET_MODE_CLIENT;
	stSockOpen.nPort = m_nPlcPort;
	_tcscpy_s(stSockOpen.szIPAddr, _countof(stSockOpen.szIPAddr), m_szIPAddress);
	CreateSocket(stSockOpen);
}


BOOL CDlgPLC::OnInitDialog()
{
	CDialog::OnInitDialog();

	GetConfig();

	// yj.nam 20180719 add (D10000, D10002, , D10004, , D10006, ...) 
	int i = 0, j=0;
	for (j=0; j<4; j++)
	{
		for(i=0; i<dfMAXFDCITEM ; i++)
		{
			if( j == 3)	// ASCII		8		// jsyoon 202005493
				m_iRefAddressToWrite[j][i] = 10000 + (8*i) + (m_nUseGap * j);
			else
				m_iRefAddressToWrite[j][i] = 10000 + (m_nUseSize*i) + (m_nUseGap * j);

// 			if( m_nUseSize == 3)
// 				m_iRefAddressToWrite[j][i] = 10000 + (3*i) + (dfMAXSVITEM * j);
// 			else
// 				m_iRefAddressToWrite[j][i] = 10000 + (2*i);

		}
	}
	//SetMStateCodeToSpread();

	SOCKET_OPEN stSockOpen;
	stSockOpen.nSockMode = SOCKET_MODE_CLIENT;	
	stSockOpen.nPort = m_nPlcPort;
	_tcscpy_s(stSockOpen.szIPAddr, _countof(stSockOpen.szIPAddr), m_szIPAddress);
	CreateSocket(stSockOpen);

//	SetTimer(1, 1000, NULL);	// jsyoon 20180906 remove 

	pPLCReciveValue = new double[dfMAXFDCITEM];

	return TRUE;  // return TRUE unless you set the focus to a control
	// EXCEPTION: OCX Property Pages should return FALSE
}

void CDlgPLC::GetConfig() 
{
	char szValue[MAX_PATH];
	ZeroMemory(szValue,MAX_PATH);

	CString sPath;
	sPath.Format("%s%s", m_strAppPath, dfDEFAULT_CONFIG_FILE_PATH);

	TCHAR	szConfigFile[MAX_PATH];
	_tcscpy_s(szConfigFile,_countof(szConfigFile), sPath);

	CString strPLC;
	strPLC = _T("PLC");
	GetPrivateProfileString (strPLC,"TYPE","1",szValue,MAX_PATH,szConfigFile);
	m_nMode = atoi(szValue);
	GetPrivateProfileString (strPLC,"STATIONNUM","5",szValue,MAX_PATH,szConfigFile);
	m_nStationNum = atoi(szValue);

	GetPrivateProfileString (strPLC,"IP","127.0.0.1",szValue,MAX_PATH,szConfigFile);
	m_szIPAddress = szValue;
	GetPrivateProfileString (strPLC,"Port","1000",szValue,MAX_PATH,szConfigFile);
	m_nPlcPort = atoi(szValue);
	GetPrivateProfileString (strPLC,"OutOfService","0",szValue,MAX_PATH,szConfigFile);
	m_bOutOfService = atoi(szValue);

	// gdh 20180321 add
	GetPrivateProfileString (strPLC, "FilterFLogList", "",szValue,MAX_PATH,szConfigFile);	
	m_strFilterFLogList = szValue;

	m_strArrayForFLogList.SetSize(0);
	SplitString(m_strFilterFLogList, ',');
	SetFilterFLogList();
	m_strArrayForFLogList.RemoveAll();


	GetPrivateProfileString (strPLC, "USESIZE", "2",szValue,MAX_PATH,szConfigFile);	
	m_nUseSize = atoi(szValue);

	// BOE 210
	GetPrivateProfileString (strPLC, "USEGAP", "0",szValue,MAX_PATH,szConfigFile);	
	m_nUseGap = atoi(szValue);
	
	////////////////////////////////////////////////////////////////

	GetPrivateProfileString ("EQNAME","EFU_NUM","0",szValue,MAX_PATH,szConfigFile);
	m_nUseEFUNum = atoi(szValue);

	//sypark 20180502 add
	GetPrivateProfileString ("UI DISPLAY","UseMonitorNum","0",szValue,MAX_PATH,szConfigFile);
	m_nUseMonitorNum = atoi(szValue);
	//

	GetPrivateProfileString ("UI DISPLAY","UseMonitorNum","0",szValue,MAX_PATH,szConfigFile);
	m_nUseMonitorNum = atoi(szValue);

	if(g_pdlgMainPLC == NULL)
		return;
}

// gdh 20180318 add
void CDlgPLC::SetFilterFLogList()
{
	int i=0,j=0;
	for(i=0; i<m_strArrayForFLogList.GetSize(); i++)
	{
		for(j=0; j<dfMAXFDCITEM; j++)
		{
			if( j == atoi(m_strArrayForFLogList.GetAt(i)) - 1)
				m_bShowFLog[j] = TRUE;
		}
	}
}
// gdh 20180318 add
void CDlgPLC::SplitString(CString strLine, char split) 
{
	CString strTok;
	int cnt=0;
	while(AfxExtractSubString(strTok, strLine, cnt, ',')) // 문자를 잘라준다. (AfxExtractSubString = strTok)
	{
		strTok.TrimLeft(); strTok.TrimRight();
		m_strArrayForFLogList.Add(strTok);					
		cnt++;				
	} 
}
