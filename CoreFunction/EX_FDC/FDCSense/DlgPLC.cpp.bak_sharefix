CString CDlgPLC::gf_MakeCurTimeString()
{
	SYSTEMTIME st;
	::GetLocalTime(&st);
	CString sTime;
	sTime.Format("%04d.%02d.%02d-%02d:%02d:%02d:%03d",st.wYear ,st.wMonth ,st.wDay ,st.wHour ,st.wMinute ,st.wSecond, st.wMilliseconds  );
	return sTime;
}

CString CDlgPLC::gf_MakeCurTimeString2()
{
	SYSTEMTIME st;
	::GetLocalTime(&st);

	CString sTime;
	sTime.Format("%02d:%02d:%02d:%03d",st.wHour ,st.wMinute ,st.wSecond, st.wMilliseconds );

	return sTime;
}

CString CDlgPLC::GetLogFileName()
{
	SYSTEMTIME st;
	::GetLocalTime(&st);
	CTime ct(st);
	CString strLogFileName;

//	strLogFileName.Format("%s%s\\%02d\\PLC_WRITE.log", g_pdlgMainPLC->m_strRootPath, dfDEFAULT_CLOG_PATH, st.wDay);
	strLogFileName.Format("%s%02d\\PLC_WRITE.log", g_pdlgMainPLC->m_strRootPath, st.wDay);

	return strLogFileName;
}

int CDlgPLC::WriteFile(CFile *pFile, CString &sPath, CString sLog)
{
	sLog += "\r\n";
	BOOL bNew = FALSE;
	CFileStatus fs;
	if (!CFile::GetStatus(sPath, fs))  //if not exist yet
	{
		_mkdir(sPath);// _mkdir;
		bNew = TRUE;
	}
	else if (pFile->m_hFile != CFile::hFileNull)
	{
		CString s1 = fs.m_szFullName ;
		if ((pFile->GetFilePath() != s1))
		{
			bNew = TRUE;
		}
	}

	if (pFile->m_hFile != CFile::hFileNull && bNew)
	{
		pFile->Close();
	}


	CFileException* pError = NULL;
	if (pFile->m_hFile == CFile::hFileNull)
	{
		UINT nOpenFlags = CFile::modeReadWrite | CFile::shareDenyWrite;
		if (bNew)
			nOpenFlags |= CFile::modeCreate;

		if (!pFile->Open(sPath , nOpenFlags, pError))
			return 0;
	}
	if (pFile->m_hFile != CFile::hFileNull)
	{
		pFile->SeekToEnd();
		pFile->Write(sLog, sLog.GetLength()) ;
		pFile->Flush();
	}

	return 1;
}

void CDlgPLC::Cmd_Send(CString strSend)
{
	if( api_SocketCtrl_IsConnected(m_nSocketIndex) )
		api_SocketCtrl_SendData(m_nSocketIndex, (BYTE*)(LPCTSTR)strSend, strlen((LPCTSTR)strSend));

	int iLen = 0;
	iLen = strSend.GetLength();
	CString strLog;
	strLog.Format("[SEND] (%d) %s", iLen, strSend);
	EventLog(strLog);
}

BOOL CDlgPLC::WriteDData(CString strName, int DDevice, double Val, BOOL bWrite)	//D10000번지 부터 데이터 쓰기 
//BOOL CDlgPLC::WriteDData(BOOL bWrite)		//D10000번지 부터 데이터 쓰기 
{

	if (!(g_pdlgMainPLC->m_pFDCMap ))
		return TRUE;

// 	if(!m_bStartSafety || !m_bStartSafetyPLCRead || !m_bStartSafetyDefault)		// eh.kim 201801014 change.
// 		return FALSE;
	
	int nRow = (DDevice - PLC_D_WRITE_STARY_BIT);
	if (nRow == 0)
	{
		nRow = 1;
	}
	else
	{
		nRow = nRow/8 +1;
	}

	//FDCSPRED SpredData;
 	//strcpy(SpredData.cPARARMName, strName);
 	//SpredData.sDevice = DDevice;
	//SpredData.dVal    = Val;
// 
 	//g_pdlgMainPLC->SetSpredData(nRow-1, SpredData);	
	//////////////////////////////////////////////////////////////////////////
	CString str;
	CString strLog;

	if( bWrite )
	{
		long ldata = (long int)(Val);
		long nRet = -1;
		if(strName =="" || DDevice < 10000)
		{
			strLog.Format("%s\n",strLog);
		}
		else
		{
			;
			//			nRet = API_MXComponent_SetMemoryWordBlock(strName, DDevice,1,&ldata);
		}


		Sleep(1);

		if(nRet == 1)
		{
			str.Format("[%d], %s, %ld", DDevice, strName, ldata);		
			if(DDevice = 10000)		//sypark 테스트 필요..
			{
				strLog.Format("[SEND] %s \n", str);
				//strLog.Format("%s\n",strLog);
			}
		}
		else
		{
			//strLog = _T("PLC not connection");
		}

// 		for(int i = 0; i < g_pdlgMainPLC->nFDCListCnt; i++)
// 		{
// 			CString strDeviceText, sTemp;
// 			sTemp.Format("%s", g_pdlgMainPLC->m_spredFDC[i+dfDATASTARTROW].cSourceAddress);
// 			strDeviceText = sTemp.Left(1);
// 			int nDeviceNum = atoi(sTemp.Mid(1));
// 
// 			//long ldata = m_valArray[i];
// 			long ldata = SpredData.dVal;
// 			long nRet = API_MXComponent_SetMemoryWordBlock(strDeviceText, nDeviceNum,1,&ldata);
// 
// 			str.Format("%ld", m_valArray[i]);
// 			strLog +=str;
// 		}
		
		DWORD lLiveCheck = GetTickCount();

		if( g_pdlgMainPLC->m_pFDCMap !=NULL)
			g_pdlgMainPLC->m_pFDCMap->FDCValue.lLiveCheck = lLiveCheck;

		if(strLog != "")
			EventLog(strLog);	
	}

	return TRUE;
}

void CDlgPLC::WriteFDC_Filtering(BOOL bUse)		
{
	int i = 0, j = 0, k=0, l=0, u=0, t =0;
	g_pdlgMainPLC->m_dSENSOR[0] = g_pdlgMainPLC->m_ffu.lLiveCheck;

	for(i = 0; i< dfMAXNUM_H2O; i++)
	{
//		if(g_pdlgMainPLC->m_dSENSOR[serial_H2O_start + i] != 0)
		{
			g_pdlgMainPLC->m_dSENSOR[serial_H2O_start+i]= g_pdlgMainPLC->m_ffu.dTmp[dfStart_H20+i]; 
		}
	}

	for(i = 0; i< dfMAXNUM_AZBIL; i++)
	{
		g_pdlgMainPLC->m_dSENSOR[serial_AZBIL_START+i]= g_pdlgMainPLC->m_ffu.dTmp[dfStart_AZBIL+i]; 
	}

	for(i = 0; i< dfMAXNUM_PM5500; i++)
	{
		g_pdlgMainPLC->m_dSENSOR[serial_PM5500_START+i]= g_pdlgMainPLC->m_ffu.dTmp[dfStart_PM5500+i]; 
	}

	//PC Temp 5개, Config에서 사용 유무 설정
	for(i = 0; i< dfMAXNUM_PCTEMP; i++)
	{
	//	if(g_pdlgMainPLC->m_bUseTemp[i])	// jsyoon 2022.03.24 remove
		{
			g_pdlgMainPLC->m_dSENSOR[serial_pc_temp1_start+i]= g_pdlgMainPLC->m_ffu.dTemper[i]; 
		}
	}
	//

	for (i=0; i < dfMAXNUM_EFU; i++)
	{
		g_pdlgMainPLC->m_dSENSOR[serial_efu_start + i] = g_pdlgMainPLC->m_ffu.dEFU[i];

		if(g_pdlgMainPLC->m_dSENSOR[serial_efu_start + i] != 0)
		{
			if(g_pdlgMainPLC->m_dSENSOR[serial_efu_start + i] > 1000)	//ksk 20150609 add
				g_pdlgMainPLC->m_dSENSOR[serial_efu_start + i] = 1000;
		}
	}

	for (i=0; i < dfMAXNUM_IONIZER; i++)
	{
		g_pdlgMainPLC->m_dSENSOR[serial_ionizer_connect_start + i] = g_pdlgMainPLC->m_ffu.bIonizerConnect[i];
	}

	for (i= 0 ; i < dfMAXNUM_IONIZER; i++)
	{
		g_pdlgMainPLC->m_dSENSOR[serial_ionizer_time_start + i] = g_pdlgMainPLC->m_ffu.dIonizerTime[i];
	}

	g_pdlgMainPLC->m_dSENSOR[serial_StaticElectric_start] = g_pdlgMainPLC->m_ffu.dStaticElectric;

	for (i=0; i < dfMAXNUM_KMN2; i++)
	{
		g_pdlgMainPLC->m_dSENSOR[serial_KMN2Result_start + i] = g_pdlgMainPLC->m_ffu.dKMN2Result[i];
	}

	for (i=0; i < dfMAXNUM_ACCURA; i++)
	{
		j = 0;

		// 4
		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (dfMAXACCURA_ITEM*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].Vavg_ll_1; j++;
		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (dfMAXACCURA_ITEM*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].lavg_1; j++;
		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (dfMAXACCURA_ITEM*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].Ptot_1; j++;
		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (dfMAXACCURA_ITEM*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].Net_1; j++;

// 		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (20*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].N2_1; j++;
// 		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (20*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].N2_1_Total; j++;
// 		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (20*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].N2_2; j++;
// 		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (20*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].N2_2_Total; j++;
// 		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (20*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].CDA_1; j++;
// 		g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (20*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].CDA_1_Total; j++;

		// 40
		// jsyoon 20190318 change
		for (k=0; k<20; k++)
		{
			g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (dfMAXACCURA_ITEM*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].nValue[k]; j++;
			g_pdlgMainPLC->m_dSENSOR[serial_ACCURA_start + (dfMAXACCURA_ITEM*i) + j] = g_pdlgMainPLC->m_stAccuraData[i].nValueTotal[k]; j++;
		}
	}

	for(i = 0; i< dfMAXNUM_ESD; i++)
	{
//		if(g_pdlgMainPLC->m_dSENSOR[serial_ESD_START + i] != 0)
		{
			g_pdlgMainPLC->m_dSENSOR[serial_ESD_START+i]= g_pdlgMainPLC->m_ffu.dTmp[dfStart_ESD+i]; 
		}
	}

	CString strTemp;
	i = 0;
	for(int iRow = 0;iRow < dfMAXFDCITEM; iRow++) 
	{
		if(g_pdlgMainPLC-> m_spredFDC[iRow].nSoureType == SOURCE_TYPE_PLC)
		{
			m_valArray[iRow] = g_pdlgMainPLC->m_dlgPLCRead.m_dPLCReadData[i]; i++;

			strTemp.Format("%s", g_pdlgMainPLC->m_spredFDC[iRow].cSourceAddress);
			int nDeviceNum = atoi(strTemp.Mid(1));
		}
		else if(g_pdlgMainPLC-> m_spredFDC[iRow].nSoureType == SOURCE_TYPE_SENSOR)		
		{
			strTemp.Format("%s", g_pdlgMainPLC->m_spredFDC[iRow].cSourceAddress);

			j = atoi(strTemp);

			m_valArray[iRow]    = g_pdlgMainPLC->m_dSENSOR[j]; j++;
		}
		else if(g_pdlgMainPLC-> m_spredFDC[iRow].nSoureType == SOURCE_TYPE_SHAHREMEMORY)
		{
			strTemp.Format("%s", g_pdlgMainPLC->m_pFDCMap->FDCValue.stMainWData[k].szData);

			j = atoi(strTemp);

			m_valArray[iRow]    = j;  k++;
//			m_valArray[iRow]  = g_pdlgMainPLC->pShared[k]; k++;
		}
		else if(g_pdlgMainPLC-> m_spredFDC[iRow].nSoureType == SOURCE_TYPE_CAPA)
		{
			m_valArray[iRow]   = g_pdlgMainPLC->m_pCAPA[l]; l++;
		}
		else if(g_pdlgMainPLC-> m_spredFDC[iRow].nSoureType == SOURCE_TYPE_SELF)
		{
			m_valArray[iRow]    = g_pdlgMainPLC->m_pSelf[u]; u++;
		}
		else if(g_pdlgMainPLC-> m_spredFDC[iRow].nSoureType == SOURCE_TYPE_REG)		// jsyoon 20210129 add
		{
			m_valArray[iRow]   = g_pdlgMainPLC->m_pLampTime[t]; t++;
		}
		else
		{
			m_valArray[iRow] = 0.0;
		}
	}

	if(bUse)
	{
		for ( i=0; i<dfMAXFDCITEM; i++)
		{
			m_bFilterValue[i] = FALSE;

			if(m_bFilterUse[i] )
			{
				if( m_valArray[i] < m_bFilter_Min[i] ||
					m_valArray[i] > m_bFilter_Max[i] )
				{
					m_valArray[i] = m_bFilter_Standard[i];
					m_bFilterValue[i] = TRUE;
				}
			}
		}
	}

	//share memory에 데이터쓰기
	int nCnt = 0;
	int nIndex = 0;
	CString str;
	for(int nShare = 0 ; nShare < dfMAXFDCITEM; nShare++)
	{
// 		int nSharemPriority = g_pdlgMainPLC->m_spredFDC[nShare].ShareMem_num;
// 		if(nSharemPriority > 0 )
		{
			nIndex = g_pdlgMainPLC->nIndexNum_Share[nShare]; 
			if( nIndex >= 0)
			{
				str.Format("%.2f", m_valArray[nShare]);
				//TRACE("val : %f, str :%s \n",m_valArray[nIndex], str);

				if( nIndex < FDC_WDATA_END)		// LYS 2026-07-30 was hardcoded 100; use real array bound
				{
					strcpy_s(g_pdlgMainPLC->m_pFDCMap->FDCValue.stFDCWData[nIndex].szData, str);

					g_pdlgMainPLC->m_pFDCMap->FDCValue.stFDCWData[nIndex].nMin = m_bFilter_Min[nShare];		// jsyoon 20200831 add

					g_pdlgMainPLC->m_pFDCMap->FDCValue.stFDCWData[nIndex].nMax = m_bFilter_Max[nShare];		// jsyoon 20200831 add
				}
			}

// 			nIndex = g_pdlgMainPLC->nIndexNum_Share[nCnt]; 
// 
// 			str.Format("%.1f", m_valArray[nIndex]);
// 			//TRACE("val : %f, str :%s \n",m_valArray[nIndex], str);
// 
// 			strcpy_s(g_pdlgMainPLC->m_pFDCMap->FDCValue.stFDCWData[nCnt].szData, str);
// 			nCnt++;
		}
	
	}

	// sypark 20180502 remove
// // 	//jhseo 20171107 add for monitoring
// 	m_valArray[dfMAXFDCITEM-2] = g_pdlgMainPLC->m_dlgPLCRead.m_dPLCReadData[(g_pdlgMainPLC->m_nUiData[0] - PLC_D_READ_STARY_BIT)/2 + 1];
// 	m_valArray[dfMAXFDCITEM-1] = g_pdlgMainPLC->m_dlgPLCRead.m_dPLCReadData[(g_pdlgMainPLC->m_nUiData[1] - PLC_D_READ_STARY_BIT)/2 + 1];

// jsyoon 20180609 remove
// 	//sypark 20180608 add	
// 	for(int i=0 ; i < m_nUseMonitorNum *2; i=i+2)
// 	{
// 		m_valArray[dfMAXFDCITEM-(i+2)] = g_pdlgMainPLC->m_dlgPLCRead.m_dPLCReadData[(g_pdlgMainPLC->m_nUiMonitorData[0][i] - PLC_D_READ_STARY_BIT)/2 + 1];
// 		m_valArray[dfMAXFDCITEM-(i+1)] = g_pdlgMainPLC->m_dlgPLCRead.m_dPLCReadData[(g_pdlgMainPLC->m_nUiMonitorData[1][i] - PLC_D_READ_STARY_BIT)/2 + 1];
// 	}
// 	//
// 	//////////////////////////////////////////////////////////////////////////
}

void CDlgPLC::WriteFDC_Data(int uSVType)			
{
// 	int iRow = 0;
// 	double dMfDataArray[dfMAXFDCITEM];
// 	FDCSPRED SpredData;
// 	ZeroMemory(&SpredData, sizeof(SpredData));
// 	ZeroMemory(&dMfDataArray, sizeof(dMfDataArray));
// 	for (iRow=0; iRow < dfMAXFDCITEM; iRow++)
// 	{
// 		if( g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion > 0 )
// 			dMfDataArray[nSVList] = (double)( m_valArray[i] * getPOW(g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion));	
// 		else if( g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion < 0 )
// 			dMfDataArray[nSVList] = (double)( m_valArray[i] / getPOW(g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion * -1));	
// 		else
// 			dMfDataArray[nSVList] = (double)( m_valArray[i]);
// 
// 		SpredData.dVal    = dMfDataArray[iRow]; 
// 		g_pdlgMainPLC->SetSpredData(iRow, SpredData);
// 	}

	if (m_bOutOfService)
	{
		return;
	}

	if (!(g_pdlgMainPLC->m_pFDCMap ))
		return;
	
	CString strDeviceText, sTemp;
//	sTemp.Format("%s", g_pdlgMainPLC->m_spredFDC[0].cDestination);
	strDeviceText = sTemp.Left(1);
	int nDeviceNum = atoi(sTemp.Mid(1));
	int nFDCListCnt =0;
	
	nFDCListCnt = g_pdlgMainPLC->m_nFDCListCnt;

	int i=0;
// 	long lval[dfMAXFDCITEM*2];
// 	ZeroMemory(&lval, sizeof(lval));
// 	for(i=0; i<g_pdlgMainPLC->nFDCListCnt ; i++)
// 	{
// 		//lval[2*i] = (long int)m_valArray[i];
// 		lval[2*i] = (long int)( m_valArray[i] * getPOW(g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion));
// 	}

	// yj.nam 20180719 add to write values to "DESTINATION" address in FDC_LIST.xlsx
	//////////////////////////////////////////////////////////////////////////
	// Sort
	int  iMaxDevice = 0;
	int  iSortArray  [dfMAXFDCITEM];
	int  iDeviceArray[dfMAXFDCITEM];
	double dDataArray[dfMAXFDCITEM];

	// INT / UINT / FLOAT / ASCII 구분하여 4번 쓰기 
	ZeroMemory(&iSortArray,   sizeof(iSortArray));
	ZeroMemory(&iDeviceArray, sizeof(iDeviceArray));
	ZeroMemory(&dDataArray,   sizeof(dDataArray));
	
	CString strDestination;
	int nSVList = 0;
	for(i=0; i<g_pdlgMainPLC->m_nFDCListCnt; i++)
	{
		if( g_pdlgMainPLC->m_spredFDC[i].uSVType == uSVType )
		{
			strDestination.Format("%s", g_pdlgMainPLC->m_spredFDC[i].cDestination);
			strDeviceText = strDestination.Left(1);
			nDeviceNum = atoi(strDestination.Mid(1));
			iDeviceArray[nSVList] = nDeviceNum;

//			dDataArray[nSVList] = (double)( m_valArray[i] * getPOW(g_pdlgMainPLC->m_spredFDC[i].uiMagnificaion));	
			dDataArray[nSVList] = m_valArray[i];	
			nSVList++;
		}
	}

	if( nSVList < 1)
		return;

	// 순서 초기화
	for(i=0; i<dfMAXFDCITEM; i++)
	{
		iSortArray[i] = -1;
	}

	for(i=0; i<nSVList; i++)
	{
		for(int j=0; j<dfMAXFDCITEM; j++)
 		{
 			if( iDeviceArray[i] == m_iRefAddressToWrite[uSVType][j])
 			{
 				iSortArray[i] = j;
				break;
 			}
 		}	
	}

	//
	long lval[dfMAXFDCITEM];
	ZeroMemory(&lval, sizeof(lval));

	float fval[dfMAXFDCITEM];
	ZeroMemory(&fval, sizeof(fval));

	TCHAR tval[dfMAXFDCITEM][20];
	ZeroMemory(&tval, sizeof(tval));
	
	bool bSortOn = false;
	int nMaxNum = -1;
	int iNum = 0, nMinNum = dfMAXFDCITEM, nStart = 0;
	for(i=0; i<dfMAXFDCITEM; i++)
	{
		if( iSortArray[i] != -1 )
		{
			iNum = iSortArray[i];

			if( uSVType == 0 || uSVType == 1)
				lval[iNum] = (long)dDataArray[i];
			else if( uSVType == 2)
				fval[iNum] = (float)dDataArray[i];
			else
			{
				// jsyoon 20200522 add
				TCHAR	hVal[20], cVal[20];
				memset(cVal,NULL,20);
				sprintf(cVal, "%s", gcvt(dDataArray[i],16,hVal));

				for (int j = 0; j<8; j++)
				{ 
					if (cVal[j] == NULL)
					{
						cVal[j] = '0';
					}

					if (cVal[7] == '.')
					{
						cVal[7] = '0';
					}
				}

				memcpy(&tval[iNum],cVal,20);

			}

			if( iNum < nMinNum)
			{
				nMinNum = iNum;
				nStart = iDeviceArray[i];

				bSortOn = true;
			}

			if( iNum > nMaxNum)
			{
				nMaxNum = iNum;
			}
		}		
	}

	// jsyoon 20201221 add
	if( bSortOn != true)
	{
		nStart = iDeviceArray[0];

//		for(i=0; i<nSVList; i++)
		for(i=0; i<nMaxNum; i++)
		{
			if( uSVType == 0 || uSVType == 1)
				lval[i] = (long)dDataArray[i];
			else if( uSVType == 2)
				fval[i] = (float)dDataArray[i];
			else
				;
		}
	}
	//////////////////////////////////////////////////////////////////////////
	
	//////////////////////////////////////////////////////////////////////////

	//sypark 20180529 add
	char szValue[256];
	sTemp.Format("D%d", nStart );
	_tcscpy_s(szValue, _countof(szValue), sTemp);
	//

	long lRet = 0;
	int nRtn = 0;
	{
		if( uSVType == 0 || uSVType == 1 )
			nRtn = API_MXComponent_SetMemoryWordBlock3(0, szValue, nMaxNum+1, &lval[0], m_nUseSize);		// jsyoon 20210504 change
		//	nRtn = API_MXComponent_SetMemoryWordBlock3(0, szValue, nSVList, &lval[0], m_nUseSize);		// INT OR UINT
		else if( uSVType == 2 )
			nRtn = API_MXComponent_SetMemoryWordBlock(0, szValue, nMaxNum+1, &fval[0], m_nUseSize);		// jsyoon 20210504 change
		//	nRtn = API_MXComponent_SetMemoryWordBlock(0, szValue, nSVList, &fval[0], m_nUseSize);		// FLOAT
		else 
		{
			// jsyoon 20200522 add
			TCHAR trval[20];
			ZeroMemory(&trval, sizeof(trval));

		//	for(i=0; i<nSVList; i++)
			for(i=0; i<nMaxNum; i++)		// jsyoon 20210504 change
			{
				sTemp.Format("D%d", iDeviceArray[i]);		// 8 
				_tcscpy_s(szValue, _countof(szValue), sTemp);
				nRtn = API_MXComponent_SetMemoryWordBlock2(0, szValue, 8, tval[i]);		// ASCII

	//			API_MXComponent_GetMemoryWordBlock2(0, sTemp, 8, &trval[0] );
			}
		}	

		DWORD lLiveCheck = GetTickCount();
		if( g_pdlgMainPLC->m_pFDCMap !=NULL)
			g_pdlgMainPLC->m_pFDCMap->FDCValue.lLiveCheck = lLiveCheck;

		CString str;
		CString strLog;
		strLog.Format("SEND(%d->%d), ", m_nStationNum, nRtn);
		for(i = 0; i<g_pdlgMainPLC->m_nFDCListCnt;i ++)
		{
			str.Format("%.2f,", m_valArray[i]);
			strLog +=str;
		}

		if( nRtn == 1)
			m_bSendOK = TRUE;
		else
			m_bSendOK = FALSE;

		EventLog(strLog);
	}

//	if(nRtn == 1)	
// 
// //	for(int i=0; i<dfMAXFDCITEM ; i++)
// 	for(int i=0; i<g_pdlgMainPLC->nFDCListCnt ; i++)
// 	{
// // 		WriteDData(m_strArray.GetAt(i), unStartBit, m_valArray[i]);
// // 		unStartBit+=8;
// 
// 		CString strDeviceText, sTemp;
// 		sTemp.Format("%s", g_pdlgMainPLC->m_spredFDC[i+dfDATASTARTROW].cDestination);
// 		strDeviceText = sTemp.Left(1);
