void CDlgPLC::CreateSocket(SOCKET_OPEN stSockOpen)
{
	if (m_bOutOfService)
	{
		return;
	}
	BOOL IsSet = FALSE;									// 설정이 되었는지 검사하는 변수 
	CString str;
	CString strLog;
	BOOL bConnect = FALSE;

	//	if(FALSE == IsSet)							// 설정이 되어 있지 않을 경우 
	{
		memcpy(&m_stSockOpen, &stSockOpen, sizeof(SOCKET_OPEN));

		BOOL bInitialize = FALSE;
		int nSockMode = stSockOpen.nSockMode;

		int nPort = stSockOpen.nPort;
		CString strIPAddr;

		if(nSockMode == SOCKET_MODE_CLIENT)
		{
			if( m_nMode == 0 )
			{
				if(api_SocketCtrl_IsConnected(m_nSocketIndex))
				{
					// 현재 연결되었으면, 연결 해제.
					api_SocketCtrl_Close(m_nSocketIndex);

					strLog.Format("[CLOSED] by user, %d", m_nSocketIndex);
					TRACE("%s\n", strLog);
					EventLog(strLog);
				}

				strIPAddr = stSockOpen.szIPAddr;

				TCHAR szIp[32];
				_tcscpy_s(szIp, _countof(szIp), strIPAddr);
				bInitialize = api_SocketCtrl_Initialize(m_nSocketIndex, this, nSockMode, nPort, szIp);

			}
			else
			{
//				if(API_MXComponent_Initialize(5, GetSafeHwnd()))
				long lRet=0;
//				bInitialize = api_Melsoft_Initialize(0, 5, GetSafeHwnd(), &lRet);
				lRet = API_MXComponent_Initialize(0, m_nStationNum, GetSafeHwnd());
				if( lRet == COMPONENT_SUCCESS )
				{
					bInitialize = TRUE;
				}
				strIPAddr.Format("%d", m_nStationNum);
			}

			if(bInitialize)
			{
				strLog.Format("[CONNECTED] (%s)", strIPAddr);
				EventLog(strLog);
			}
			else
			{
				strLog.Format("[ERROR] Connect...Fail(%s)", strIPAddr);
//					strLog = _T("Connect Socket...Fail!!!)";
				EventLog(strLog);
//					AfxMessageBox(strLog);
				//					return;
			}
		}
// 		else if(nSockMode == SOCKET_MODE_SERVER)
// 		{
// 			if( FALSE )
// 			{
// 				bInitialize = api_SocketCtrl_Initialize(m_nSocketIndex, this, nSockMode, nPort, strIPAddr);
// 
// 				if(!bInitialize)
// 				{
// 					CString strLog = "Create Socket...Fail!!!";
// 	//				EventLog(strLog);
// 					AfxMessageBox(strLog);
// 					return;
// 				}
// 			}
// 			else
// 			{
// 	//			if(API_MXComponent_Initialize(5, GetSafeHwnd()))
// 				long lRet=0;
// 				if( api_Melsoft_Initialize(0, 5, GetSafeHwnd(), &lRet))
// 				{
// 					CString strLog;
// 					strLog = "[CONNECTED] PLC connection success!";
// 				}
// 				else
// 				{
// 					AfxMessageBox("PLC connection fail.");
// 				}
// 			}
// 		}
	}
}

void CDlgPLC::CloseSocket()
{
	CString strLog;
	BOOL bRet = TRUE;
	if( m_nMode == 0 )
	{
		if(api_SocketCtrl_IsConnected(m_nSocketIndex))
		{
			// 현재 연결되었으면, 연결 해제.
			bRet = api_SocketCtrl_Close(m_nSocketIndex);
		}
	}
	else
	{
		//				if(API_MXComponent_Initialize(5, GetSafeHwnd()))
		long lRet=0;
		//				bInitialize = api_Melsoft_Initialize(0, 5, GetSafeHwnd(), &lRet);
		lRet = API_MXComponent_Close(0);
		if( lRet == COMPONENT_SUCCESS )
		{
			bRet = TRUE;
		}
	}

	strLog.Format("[CLOSED] by user, %d", m_nSocketIndex);
	TRACE("%s\n", strLog);
	EventLog(strLog);
}

void CDlgPLC::EventLog(CString &s)
{
	//	CString sLog = gf_MakeCurTimeString() + "   " + s;
	CString strTemp, sLog;
	strTemp.Format("%s", s);
	if(strTemp.Find("[SEND]")>=0)
		return;

	sLog.Format("%s, %s", gf_MakeCurTimeString2(), s);

	if (m_strReceiveLog.CompareNoCase(strTemp) != 0) //kjhg 20141121 add
	{
		g_pdlgMainPLC->WriteELog(sLog, 1);
//		int nR = WriteFile(&m_fileCommLog, GetLogFileName(), sLog);

		m_strReceiveLog.Format("%s", strTemp);
	}

	m_lbPlcLog.InsertString(-1, sLog);

	if (m_lbPlcLog.GetCount() > 100)	// 100라인 정도까지만 출력
		m_lbPlcLog.DeleteString(0);

	m_lbPlcLog.SetCurSel(m_lbPlcLog.GetCount()-1);

// 	if(sLog.Find("[SEND]")>=0)
// 		return;

// 	CString strTemp;
// 	if( sLog.GetLength() < 2000)
// 		strTemp = sLog;
// 	else
// 		strTemp = sLog.Left(1900);

// 	if (m_strReceiveLog.CompareNoCase(strTemp) != 0) //kjhg 20141121 add
// 	{
// 		int nR = WriteFile(&m_fileCommLog, GetLogFileName(), sLog);
// 	}
// 
// 	m_strReceiveLog = strTemp;
}

BOOL CDlgPLC::GetReceiveData(CString *reply, UINT nRcvSize, UINT nTimeout)
{
	DWORD  dwS, dwR, dwT=0;
	DWORD  dwSleep = 100;

	//UINT nSize = nRcvSize;
	UINT nSize = 1;
	CString Temp;
	CString strLog="";
	//BYTE* pByte;
	//pByte = new BYTE[nSize + 1];

	for (dwS=GetTickCount(); dwT<nTimeout;)  
	{
		if(api_SocketCtrl_GetReceiveDataSize(m_nSocketIndex)>= nSize)
		{
			for(int i= 0; i< g_pdlgMainPLC->m_nPLCCnt; i++)
			{
				CString strDeviceText, sTemp;
				sTemp.Format("%s", g_pdlgMainPLC->m_spredFDC[i+dfDATASTARTROW].cSourceAddress);
				strDeviceText = sTemp.Left(1);
				int nDeviceNum = atoi(sTemp.Mid(1));

				pPLCReciveValue[i] = DoWorkStartGetPLCMemoryBit(strDeviceText, nDeviceNum);

				Temp.Format("%f",pPLCReciveValue[i-dfDATASTARTROW]);
				strLog += Temp;

			}
			return TRUE;
		}
		else	//Added by Jay Hong : 2011.02.23
		{
			int nLen = api_SocketCtrl_GetReceiveDataSize(m_nSocketIndex);
			if(nLen>0)
			{
				for(int i=0; i< g_pdlgMainPLC->m_nPLCCnt; i++)
				{

					CString strDeviceText, sTemp;
					sTemp.Format("%s", g_pdlgMainPLC->m_spredFDC[i+dfDATASTARTROW].cSourceAddress);
					strDeviceText = sTemp.Left(1);
					int nDeviceNum = atoi(sTemp.Mid(1));

					pPLCReciveValue[i] = DoWorkStartGetPLCMemoryBit(strDeviceText, nDeviceNum);

					Temp.Format("%f",pPLCReciveValue[i]);
					strLog += Temp;

				}

				return TRUE;
			}
		}

		Sleep(10);
		dwR = GetTickCount();

		if (dwR >= dwS)  
			dwT = dwR - dwS;
		else
			dwT = ((DWORD)0xFFFFFFFF) - (dwS - dwR);
	}

	//delete pByte;

	CString strLog2;
	strLog2.Format("Timeout...");
	EventDLog(strLog2);

	return TRUE;
}

