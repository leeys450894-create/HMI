// LYS 2026-07-29 ELP ElecBox monitor data (Main SW -> FDC), protocol doc 2026-07-28
// stMainWData slot = MAIN_WDATA_ELP_START + box(0..1) * MAIN_WDATA_ELP_BOX_STRIDE + item
// FDC reads stMainWData by FDC_LIST 'SOURCE ADDRESS' direct indexing (nMainDataCount not used)
const enum NUM_MAIN_WDATA_ELP{
	MAIN_WDATA_ELP_START = 400,
	MAIN_WDATA_ELP_BOX_STRIDE = 20,
	MAIN_WDATA_ELP_BOX_MAX = 2,

	MAIN_WDATA_ELP_ITEM_TEMP = 0,		// C
	MAIN_WDATA_ELP_ITEM_SMOKE,			// %
	MAIN_WDATA_ELP_ITEM_VOLT,			// V
	MAIN_WDATA_ELP_ITEM_HARM_VOLT,		// V
	MAIN_WDATA_ELP_ITEM_CURR,			// A
	MAIN_WDATA_ELP_ITEM_HARM_CURR,		// mA
	MAIN_WDATA_ELP_ITEM_LEAK_CURR,		// mA
	MAIN_WDATA_ELP_ITEM_INST_PW,		// kW
	MAIN_WDATA_ELP_ITEM_ACCUM_PW,		// kWh
	MAIN_WDATA_ELP_ITEM_CNT,			// 9
};

typedef struct {
	char		szName[32];
	char		szData[32];
	double		nMax;
	double		nMin;
}RDATA, *PRDATA;

typedef struct
{
	int				nMainDataCount;			// Main SW에서 올려주는 Data 개수
	RDATA			stMainWData[1000];		// Main SW에서 올려주는 정보

	DWORD			lLiveCheck;				// FDC SW Tick count
	RDATA			stFDCWData[FDC_WDATA_END];		// FDC SW에서 올려주는 정보 NUM_FDC_WDATA 순으로 입력
}FDC_For_Shared, *PFDC_For_Shared;

typedef struct  {
	FDC_For_Shared FDCValue;
}VTM_FOR_FDC, *PVTM_FOR_FDC;



