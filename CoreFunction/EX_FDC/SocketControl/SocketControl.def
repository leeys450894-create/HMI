	api_SocketCtrl_GetClientPort
	api_SocketCtrl_GetReceiveDataSize
	api_SocketCtrl_GetServerPort
	api_SocketCtrl_IsConnected
	api_SocketCtrl_SetModeChange
	api_SocketCtrl_SetServerIPAddress
	api_SocketCtrl_SetServerPort


