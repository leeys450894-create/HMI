    ; Explicit exports can go here

	api_SocketCtrl_Initialize
	api_SocketCtrl_Close
	api_SocketCtrl_GetLocalIP
	api_SocketCtrl_GetServerIPAddress
	api_SocketCtrl_GetClientIPAddress
