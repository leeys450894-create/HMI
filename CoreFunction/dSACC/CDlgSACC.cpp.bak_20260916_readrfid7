LRESULT CDlgSACC::OnFPSpreadClick_Cassette(WPARAM wParam, LPARAM lParam)
{
	LPSS_CELLCOORD lpcc = (LPSS_CELLCOORD)lParam;
	int col = lpcc->Col;
	int row = lpcc->Row;
	
	// LYS 2026-09-17 LOAD/UNLOAD check box is single-select per column: clear every other row (was 'row 5 only' - left over from the 5-slot layout)
	//if(col == 2 || col == 3)
	//	for (int iProbe = 5; iProbe <= 5; iProbe++)
	//		m_sprdProbeID->SetDataString(col, iProbe, _T("0"));
	if (col == 2 || col == 3)
	{
		for (int iProbe = 1; iProbe <= m_sprdProbeID->GetMaxRows(); iProbe++)
		{
			if (iProbe == row) continue;
			m_sprdProbeID->SetDataString(col, iProbe, _T("0"));
		}
	}

	if (col == 2)
	{
		m_iSelectLoadCassette = row; // Load Cassette 선택 
	}
	if (col == 3)
	{
		m_iSelectUnLoadCassette = row; // UnLoad Cassette 선택 
	}

	return LRESULT();
}

