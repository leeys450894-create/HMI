void CMCCLogMgr::SetLampTime(int iLamp, int Time)
{
	if(iLamp >=0 && iLamp < 10)
		m_uLampTime[iLamp] = Time; 
}

void CMCCLogMgr::SetLiftPinMoveTime(int iStep, int Time)
{
	if (iStep >= 0 && iStep < 10)
		m_uLiftPinMoveTime[iStep] = Time;
}

void CMCCLogMgr::SetIonizerRun(bool bRun)
{
	m_bIonizerRun = bRun;
}