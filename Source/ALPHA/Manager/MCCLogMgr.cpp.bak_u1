			dChuckVacuumValue[i] = m_pDFDCData[FDC_WDATA_WT_VACUUM_1 + i];
		}

		for (i = 0; i <  FDC_WDATA_TEMP_END; i++)
		{
			dTemperature[i] = m_pDFDCData[FDC_WDATA_TEMP_1+i];
		}


		//////////////////////////////////////////////////////////////////////////
		// MCC
		// Update FDC Data
		int nItem = 0;
		
		for (size_t i = 0; i < FDC_WDATA_TEMP_END; i++)
		{
