// 별도로 사용하는 함수
BOOL CMotorControlMgr::DoWork_MotionEnable(int iAxis)
{
	long bRet = df_MOTION_RV_SUCCESSED;

    if ( iAxis == AXIS_ALL)
    {	
        for (int i = 0; i < AXIS_TYPE_END; i++ )
        {
			bRet |= GetAmpEnable(i);
        }
    }
	else 
	{	
		bRet = GetAmpEnable(iAxis);
	}

	if(bRet == 0)
	{
		return TRUE;
	}

	return FALSE;
}

int CMotorControlMgr::DoWork_MotionDone(int iAxis)
{
	int nRet = df_MOTION_RV_SUCCESSED;

	if (iAxis == AXIS_ALL)
	{
		for (int i = 0; i < AXIS_TYPE_END; i++)
		{
			nRet = DoWork_MotionDone(i);

			if (nRet != df_MOTION_RV_SUCCESSED)
			{
				break;
			}
		}
	}
	else
	{
		if (GetAxisProperty(iAxis)->bUse != true)
		{
			return df_MOTION_RV_SUCCESSED;
		}

		if (IsOutOfService() == true)
		{
			return df_MOTION_RV_SUCCESSED;
		}

		if (IsConnected() != TRUE)
		{
			return MEI_NOT_CREATED;
		}

		if (iAxis == AXIS_Z7 || iAxis == AXIS_Z8)
		{
			;
		}
		else
		{

			CString strLog;
			strLog.Format(_T("DoWork_MotionDone Start(AXIS:%d)"), iAxis);
			m_pLogFileAccessor->KMLOG(SYST, strLog, true);

			bool bRet = CheckMoveDone(iAxis, 30000);
			if (!bRet)
			{
				nRet = MOTION_MOVE_DONE_ALARM + iAxis;
			}

			// LYS 2026-09-02 Move 중 HW 리밋 센서 감지
			if (GetHWLimit(iAxis, TRUE) != true)
			{
				CAlarmController::GetInstance()->SetAlarm(MOTION_OVER_LIMIT_POS);
				nRet = MOTION_OVER_LIMIT_POS;
			}
			else if (GetHWLimit(iAxis, FALSE) != true)
			{
				CAlarmController::GetInstance()->SetAlarm(MOTION_OVER_LIMIT_NEG);
				nRet = MOTION_OVER_LIMIT_NEG;
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				strLog.Format(_T("DoWork_MotionDone End(AXIS:%d)"), iAxis);
				m_pLogFileAccessor->KMLOG(SYST, strLog, true);
			}
			else
			{
				strLog.Format(_T("DoWork_MotionDone NG(AXIS:%d)"), iAxis);
				m_pLogFileAccessor->KMLOG(WARN, strLog, true);
			}
		}
	}

	return nRet;

}

