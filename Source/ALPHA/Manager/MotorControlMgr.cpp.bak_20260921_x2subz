CMotorControlMgr::CMotorControlMgr(CString strAppPath, CString strConfigPath, CString strLogPath)
    : m_pIniHelper(new CIniHelper)
	, m_pLogFileAccessor(new CLogFileAccessor)
	, m_bInitialized(false)
	, m_bIsOCP(false)
	, m_dInterlockPos(0)
	, m_dInterlockGantryGap(500)
	, m_dInterlockHeadGap(100)
	, m_dInterlockHeadGapB(100)
	, m_dInterlockProbeGap(200)
	, m_dInterlockLifePinPos(575)
	, m_dInterlockProbeSizeX(300)
	, m_dInterlockProbeZSafety(-600)
	, m_dInterlockSubZSafety(0)
{
    SetName(_T("MOTOR_CONTROL_MGR"));

	// 로그 생성하기
	const CString strFolderPath = strLogPath + _T("Control\\Motion\\");
	const CString strLogFile = strFolderPath + _T("Motion.log");
	MakeDir(strFolderPath);
	m_pLogFileAccessor->Initialize(strLogFile);
	//////

	const CString strFilePath = strConfigPath + _T("\\CoreFunction\\CoreFunction.ini");
    m_pIniHelper->SetFilePath(strFilePath);

    LinkIniFile(false);

	
	ZeroMemory(&m_dMoveOffset, sizeof(m_dMoveOffset));
	ZeroMemory(&m_dMovePos, sizeof(m_dMovePos));

    //----------------------------------------------------------------------
    //----------------------------------------------------------------------
	m_pFunction = new CMotorFunction(m_strControlType, strConfigPath, strFilePath, GetName());

	InitDevice();
}

CMotorControlMgr::~CMotorControlMgr()
{
    Finalize();
}

bool CMotorControlMgr::LinkIniFile(bool bSave)
{
    m_pIniHelper->Link(bSave, GetName(), _T("USE"),				&m_bUse,				true);
    m_pIniHelper->Link(bSave, GetName(), _T("OUT_OF_SERVICE"),	&m_bOutOfService,		false);
    m_pIniHelper->Link(bSave, GetName(), _T("DEVICE_TYPE"),		&m_strControlType,		(CString)_T("ACS"));
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKPOS"),	&m_dInterlockPos,		200.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKGANGAP"), &m_dInterlockGantryGap, 500.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKHEADGAP"),	&m_dInterlockHeadGap, 40.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKHEADGAPB"),   &m_dInterlockHeadGapB, 710.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKPROBEGAP"),   &m_dInterlockProbeGap, 200.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKLIFTPIN"),    &m_dInterlockLifePinPos, 575.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKPROBESIZEX"), &m_dInterlockProbeSizeX, 300.000);	// LYS 2026-08-25
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKPROBEZSAFETY"), &m_dInterlockProbeZSafety, -600.000);	// LYS 2026-08-26
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKSUBZSAFETY"), &m_dInterlockSubZSafety, 0.000);	// LYS 2026-09-02 Z3/Z4 Sub Z 안전위치 (SUBZ_SAFETY=0 미러)

	CString strLog;
	strLog.Format(_T("USE:%d, OUT_OF_SERVICE:%d, DEVICE_TYPE:%s, INTERLOCKPOS:%.3f, INTERLOCKGANGAP:%.3f, INTERLOCKHEADGAP:%.3f, INTERLOCKHEADGAPB:%.3f, INTERLOCKPROBEGAP:%.3f"), m_bUse, m_bOutOfService, m_strControlType, m_dInterlockPos, m_dInterlockGantryGap, m_dInterlockHeadGap, m_dInterlockHeadGapB, m_dInterlockProbeGap);
	m_pLogFileAccessor->KMLOG(SYST, strLog);
	
    return m_pIniHelper->IsReadEnable();
}

// LYS 2026-06-26 OCP mode: disable P1-P4 all axes
// LYS 2026-08-25 P5 gantry X is no longer disabled - see the list below.
void CMotorControlMgr::DisableAxesForOCP()
{
	m_bIsOCP = true;

	if (!m_pFunction) return;

	// P1-P4 Probe axes: X1-X8, Y1-Y4, Z1-Z4
	int nDisableAxes[] = {
		AXIS_PROBE_X1, AXIS_PROBE_X2, AXIS_PROBE_X3, AXIS_PROBE_X4,
		AXIS_PROBE_X5, AXIS_PROBE_X6, AXIS_PROBE_X7, AXIS_PROBE_X8,
		AXIS_PROBE_Y1, AXIS_PROBE_Y2, AXIS_PROBE_Y3, AXIS_PROBE_Y4,
		AXIS_PROBE_Z1, AXIS_PROBE_Z2, AXIS_PROBE_Z3, AXIS_PROBE_Z4,
		AXIS_Z1,	// LYS 2026-09-02 OCP에서 head BACK Z(AXIS_Z1) 미사용 처리
		// LYS 2026-08-25 X9/X10은 목록에서 제외 - HW 컨셉 변경으로 P5 유닛은 X로 움직여야 한다.
		// LYS 2026-09-05 AXIS_PROBE_Y5(PBY5, PROBE CROSS)도 목록에서 제외 - Probe Align Y 센터링은 PBY5를 움직여야 함(HW 확인됨).
		//   Config_Motion_ACS.dat PBY5 USE[1]/ACS0/HW28 그대로 사용. 이 함수는 P1~P4 + BACK Z(Z1)만 끈다.
	};

	for (int i = 0; i < _countof(nDisableAxes); i++)
	{
		axis_data_type* pAxis = m_pFunction->GetAxisProperty(nDisableAxes[i]);
		if (pAxis)
			pAxis->bUse = FALSE;
	}

	CString strLog;
	strLog.Format(_T("OCP Mode: Disabled %d axes (P1-P4 probe all + BACK Z); P5 X9/X10/Y5 active"), _countof(nDisableAxes));
	m_pLogFileAccessor->KMLOG(SYST, strLog);
}

void CMotorControlMgr::Finalize()
{
    //----------------------------------------------------------------------
    // 데이터 삭제
    //----------------------------------------------------------------------
	if(m_pFunction)
	{
		delete m_pFunction;
		m_pFunction = nullptr;
	}
	
	if(m_pIniHelper)
    {
        delete m_pIniHelper;
        m_pIniHelper = nullptr;
    }

	//----------------------------------------------------------------------
	// 데이터 삭제
	//----------------------------------------------------------------------
	if (m_pLogFileAccessor)
	{
		delete m_pLogFileAccessor;
		m_pLogFileAccessor = nullptr;
	}
}




