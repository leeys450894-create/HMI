CMotorControlMgr::CMotorControlMgr(CString strAppPath, CString strConfigPath, CString strLogPath)
    : m_pIniHelper(new CIniHelper)
	, m_pLogFileAccessor(new CLogFileAccessor)
	, m_bInitialized(false)
	, m_bIsOCP(false)
	, m_dInterlockPos(0)
	, m_dInterlockGantryGap(500)
	, m_dInterlockHeadGap(100)
	, m_dInterlockHeadGapB(100)
	, m_dInterlockProbeGap(200)
	, m_dInterlockLifePinPos(575)
	, m_dInterlockProbeSizeX(300)
{
    SetName(_T("MOTOR_CONTROL_MGR"));

	// 로그 생성하기
	const CString strFolderPath = strLogPath + _T("Control\\Motion\\");
	const CString strLogFile = strFolderPath + _T("Motion.log");
	MakeDir(strFolderPath);
	m_pLogFileAccessor->Initialize(strLogFile);
	//////

	const CString strFilePath = strConfigPath + _T("\\CoreFunction\\CoreFunction.ini");
    m_pIniHelper->SetFilePath(strFilePath);

    LinkIniFile(false);

	
	ZeroMemory(&m_dMoveOffset, sizeof(m_dMoveOffset));
	ZeroMemory(&m_dMovePos, sizeof(m_dMovePos));

    //----------------------------------------------------------------------
    //----------------------------------------------------------------------
	m_pFunction = new CMotorFunction(m_strControlType, strConfigPath, strFilePath, GetName());

	InitDevice();
}

CMotorControlMgr::~CMotorControlMgr()
{
    Finalize();
}

bool CMotorControlMgr::LinkIniFile(bool bSave)
{
    m_pIniHelper->Link(bSave, GetName(), _T("USE"),				&m_bUse,				true);
    m_pIniHelper->Link(bSave, GetName(), _T("OUT_OF_SERVICE"),	&m_bOutOfService,		false);
    m_pIniHelper->Link(bSave, GetName(), _T("DEVICE_TYPE"),		&m_strControlType,		(CString)_T("ACS"));
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKPOS"),	&m_dInterlockPos,		200.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKGANGAP"), &m_dInterlockGantryGap, 500.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKHEADGAP"),	&m_dInterlockHeadGap, 40.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKHEADGAPB"),   &m_dInterlockHeadGapB, 710.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKPROBEGAP"),   &m_dInterlockProbeGap, 200.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKLIFTPIN"),    &m_dInterlockLifePinPos, 575.000);
	m_pIniHelper->Link(bSave, GetName(), _T("INTERLOCKPROBESIZEX"), &m_dInterlockProbeSizeX, 300.000);	// LYS 2026-08-25

	CString strLog;
	strLog.Format(_T("USE:%d, OUT_OF_SERVICE:%d, DEVICE_TYPE:%s, INTERLOCKPOS:%.3f, INTERLOCKGANGAP:%.3f, INTERLOCKHEADGAP:%.3f, INTERLOCKHEADGAPB:%.3f, INTERLOCKPROBEGAP:%.3f"), m_bUse, m_bOutOfService, m_strControlType, m_dInterlockPos, m_dInterlockGantryGap, m_dInterlockHeadGap, m_dInterlockHeadGapB, m_dInterlockProbeGap);
	m_pLogFileAccessor->KMLOG(SYST, strLog);
	
    return m_pIniHelper->IsReadEnable();
}

// LYS 2026-06-26 OCP mode: disable P1-P4 all axes
// LYS 2026-08-25 P5 gantry X is no longer disabled - see the list below.
void CMotorControlMgr::DisableAxesForOCP()
{
	m_bIsOCP = true;

	if (!m_pFunction) return;

	// P1-P4 Probe axes: X1-X8, Y1-Y4, Z1-Z4
	int nDisableAxes[] = {
		AXIS_PROBE_X1, AXIS_PROBE_X2, AXIS_PROBE_X3, AXIS_PROBE_X4,
		AXIS_PROBE_X5, AXIS_PROBE_X6, AXIS_PROBE_X7, AXIS_PROBE_X8,
		AXIS_PROBE_Y1, AXIS_PROBE_Y2, AXIS_PROBE_Y3, AXIS_PROBE_Y4,
		AXIS_PROBE_Z1, AXIS_PROBE_Z2, AXIS_PROBE_Z3, AXIS_PROBE_Z4,
		// LYS 2026-08-25 X9/X10 dropped from this list - the HW concept changed and
		// the P5 gantry X now has to move. Config_Motion_ACS.dat already carries
		// USE[1] for PBX9/PBX10, which this function used to override at startup.
		// Y5 stays disabled here even though PBY5 also reads USE[1]; enabling the
		// probe cross is a separate HW decision.
		AXIS_PROBE_Y5
	};

	for (int i = 0; i < _countof(nDisableAxes); i++)
	{
		axis_data_type* pAxis = m_pFunction->GetAxisProperty(nDisableAxes[i]);
		if (pAxis)
			pAxis->bUse = FALSE;
	}

	CString strLog;
	strLog.Format(_T("OCP Mode: Disabled %d probe axes (P1-P4 all + P5 Y)"), _countof(nDisableAxes));
	m_pLogFileAccessor->KMLOG(SYST, strLog);
}

void CMotorControlMgr::Finalize()
{
    //----------------------------------------------------------------------
    // 데이터 삭제
    //----------------------------------------------------------------------
	if(m_pFunction)
	{
		delete m_pFunction;
		m_pFunction = nullptr;
	}
	
	if(m_pIniHelper)
    {
        delete m_pIniHelper;
        m_pIniHelper = nullptr;
    }

	//----------------------------------------------------------------------
	// 데이터 삭제
	//----------------------------------------------------------------------
	if (m_pLogFileAccessor)
	{
		delete m_pLogFileAccessor;
		m_pLogFileAccessor = nullptr;
	}
}




CString	CMotorControlMgr::GetDeviceName()
{
	return m_pFunction->GetDeviceName();
}

bool CMotorControlMgr::InitDevice()
{
	return m_pFunction->InitDevice();
}

void CMotorControlMgr::SetInitialize(bool value)
{
	m_bInitialized = value;
}

bool CMotorControlMgr::IsInitialized() const
{
	if (IsOutOfService() != true)
		return m_bInitialized;
	else
		return true;
}

bool CMotorControlMgr::IsConnected() const
{
	return m_pFunction->IsConnected();
}

bool CMotorControlMgr::IsUseDevice() const
{
	return m_bUse;
}

bool CMotorControlMgr::IsOutOfService() const
{
	return m_bOutOfService;
}







long CMotorControlMgr::ResetDevice(int iAxis)
{
	CCriticalSectionSync single(&m_cs, TRUE);

	return m_pFunction->ResetDevice(iAxis);
}

long CMotorControlMgr::MoveHome(int iAxis)
{
	long nRet = df_MOTION_RV_SUCCESSED;

	CCriticalSectionSync single(&m_cs, TRUE);

	return m_pFunction->MoveHome(iAxis);

	return nRet;
}

long CMotorControlMgr::MoveCmdPosA_Move(int iAxis, double dPos, bool bBlockMode, int iSpeed, int iLens, int iTube)
{
	long nRet = df_MOTION_RV_SUCCESSED;

	CCriticalSectionSync single(&m_cs, TRUE);

	long lRet = 0;
	lRet = m_pFunction->MoveCmdPosA(iAxis, dPos, bBlockMode, iSpeed, iLens, iTube);
	if (nRet == 1)
	{
		nRet = df_MOTION_RV_SUCCESSED;
	}
	else if (nRet == -1)
	{
		nRet = MEI_NOT_CREATED;
	}
	else
	{
		nRet = MOTION_CMDPOS_ERROR; // MOTION_MOVE_ALARM + iAxis;
	}

	return nRet;
}

// LYS 2026-08-25 The P5 probe unit is a block of INTERLOCKPROBESIZEX (300mm by default)
// Back Gantry X2 must not move into that block. This function checks if the current P5 probe unit position overlaps with the requested X2 position.
bool CMotorControlMgr::IsProbeUnitOverlapX(double dHeadX)
{
	double dProbeX = 0.;
	dProbeX = GetOrgPos(AXIS_PROBE_X9);

	double dLow = dProbeX - 1.0;			// absorb the +-1mm park tolerance
	double dHigh = dProbeX + m_dInterlockProbeSizeX;

	if (dLow <= dHeadX && dHeadX <= dHigh)
		return true;

	return false;
}

long CMotorControlMgr::MoveCmdPosA_Sub(int iAxis, double dPos, bool bBlockMode, int iSpeed, int iLens, int iTube)
{
	long nRet = df_MOTION_RV_SUCCESSED;

	bool bDir = true;

	// Stage
	if (iAxis == AXIS_X)
	{
		// R 위치 확인후 0 혹은 180 도 근처일때만 이동
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			double dCurPos = 0;
			dCurPos = GetOrgPos(AXIS_LOADER_R);
			//	if ((fabs(dCurPos - 0) < 2 || fabs(dCurPos - 180) < 2) || fabs(dCurPos-90) < 2 || fabs(dCurPos-270) < 1)
			if (fabs(dCurPos) < 2 || fabs(dCurPos - 90) < 2 || fabs(dCurPos - 180) < 2 || fabs(dCurPos - 270) < 2)	// LYS 2026-08-07 rotation-change: station angles {0,90,180,270}
			{
				;
			}
			else
			{
				nRet = MOTION_ROTATE_POS_ERROR;
			}
		}
		
		// R 이동시 X 이동 금지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{	
			if (CheckMoveDone(AXIS_LOADER_R, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_R;
			}
		}
	}

	// Loader Rotate
	else if (iAxis == AXIS_LOADER_R)
	{
		// Loader Rotate 이동 제한 위치
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			double dCurPos = 0;
			dCurPos = GetOrgPos(AXIS_LOADER_R);
			if (fabs(dCurPos - dPos) > 2)
			{
				if (GetOrgPos(AXIS_X) < m_dInterlockPos)
				{
					if (IsOutOfService() == true) nRet == df_MOTION_RV_SUCCESSED;
					else nRet = MOTION_ROTATE_POS_ERROR;
				}
			}
		}
	}

	// Head Gantry
	else if (iAxis == AXIS_X2)  // WAD
	{
		double dCur = 0, dMoveGap = 0;
		// Gantry 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_X3);

			if (bDir)
			{
				dMoveGap = fabs(dPos - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dPos);
			}

			if (dMoveGap < m_dInterlockGantryGap - 0.01)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}

		// Probe 이동 시 X2 이동 금지
		if (nRet == VTM_RV_SUCCESSED)
		{
			if (CheckMoveDone(AXIS_PROBE_X9, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_PROBE_X9;
			}
		}
		
		// Probe unit 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X9);

			if (dPos <  (dCur - 5) )		// Probe Unit을 넘어가는 경우
			{
				nRet = MOTION_INTERLOCK_5;
			}
		}

		// Head Z축 이동 시 X2 이동 금지 WAD 기구물 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			if (CheckMoveDone(AXIS_Z2, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_Z2;
			}
		}

		// Head Down 시 이동 위치 제한
		if (nRet == VTM_RV_SUCCESSED)	// jsyoon 2022.04.18 add Interlock
		{
			dCur = GetOrgPos(AXIS_Z2);

			if (dCur > 0.1)
			{
				if (dPos < ( GetMinSWLimit(AXIS_X2) + 35) ) // jsyoon 2022.05.18 change 80 to 35
				{
					nRet = MOTION_INTERLOCK_8;
				}
			}
		}
	}
	else if (iAxis == AXIS_X3)  // Vision
	{
		double dCur = 0, dMoveGap = 0;

		// Gantry 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_X2);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dPos);
			}
			else
			{
				dMoveGap = fabs(dPos - dCur);
			}

			if (dMoveGap < m_dInterlockGantryGap - 0.01)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
		// Probe 이동 시 X3 이동 금지
		if (nRet == VTM_RV_SUCCESSED)
		{
			if (CheckMoveDone(AXIS_PROBE_X9, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_PROBE_X9;
			}
		}

		// jsyoon 2022.09.30 add
		// Head Down 시 이동 금지
		if (nRet == VTM_RV_SUCCESSED)
		{
			double dCurZ = 0, dMoveGap = 0;
			dCurZ = GetOrgPos(AXIS_Z1);
			if (dCurZ > 1)
			{
				nRet = MOTION_INTERLOCK_5;
			}
			//if (dCurZ > 10)
			//{
			//	// Z
			//	if (GetOrgPos(AXIS_PROBE_Z1) < -5.1 ||
			//		GetOrgPos(AXIS_PROBE_Z2) < -5.1 ||
			//		GetOrgPos(AXIS_PROBE_Z3) < -5.1 ||
			//		GetOrgPos(AXIS_PROBE_Z4) < -5.1 ||
			//		GetOrgPos(AXIS_PROBE_Z5) < -5.1)
			//	{
			//		nRet = MOTION_INTERLOCK_7;
			//	}

			//	// PROBE
			//	if (nRet == VTM_RV_SUCCESSED)
			//	{
			//		dCur = GetOrgPos(AXIS_PROBE_X9);

			//		if (dPos < dCur - 5 )
			//		{
			//			nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X9;
			//		}

			//		dCur = GetOrgPos(AXIS_PROBE_X7);

			//		if (dPos < dCur - 5)
			//		{
			//			nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X7;
			//		}

			//		dCur = GetOrgPos(AXIS_PROBE_X5);

			//		if (dPos < dCur - 5)
			//		{
			//			nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X5;
			//		}

			//		dCur = GetOrgPos(AXIS_PROBE_X3);

			//		if (dPos < dCur - 5)
			//		{
			//			nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X3;
			//		}

			//		dCur = GetOrgPos(AXIS_PROBE_X1);

			//		if (dPos < dCur - 5)
			//		{
			//			nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X1;
			//		}
			//	}
			//}
		}
	}

	// head
	else if (iAxis == AXIS_Y1)
	{
		double dCur = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_Y2);

			if (bDir)
			{
				dMoveGap = fabs(dPos - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dPos);
			}

			if (dMoveGap < m_dInterlockHeadGapB)	// 2023.03.08 change
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_Y2)
	{
		double dCur = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_Y1);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dPos);
			}
			else
			{
				dMoveGap = fabs(dPos - dCur);
			}

			//	if (dMoveGap < m_dInterlockHeadGap)
			if (dMoveGap < m_dInterlockHeadGapB)	// 2023.03.08 change
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_Y3)
	{
		double dCur = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_Y4);

			if (bDir)
			{
				dMoveGap = fabs(dPos - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dPos);
			}

			if (dMoveGap < m_dInterlockHeadGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_Y4)
	{
		double dCur = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_Y3);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dPos);
			}
			else
			{
				dMoveGap = fabs(dPos - dCur);
			}

			if (dMoveGap < m_dInterlockHeadGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}

	// Probe
	else if (iAxis == AXIS_PROBE_X1)
	{
		double dCur = 0, dMoveGap = 0;
		// Probe 간 충돌 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X3);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dPos);
			}
			else
			{
				dMoveGap = fabs(dPos - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X3)
	{
		double dCur = 0, dMoveGap = 0;
		// Probe 간 충돌 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X1);
			if (bDir)
			{
				dMoveGap = fabs(dPos - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dPos);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
		// Probe 간 충돌 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X5);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dPos);
			}
			else
			{
				dMoveGap = fabs(dPos - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X5)
	{
		double dCur = 0, dMoveGap = 0;
		// Probe 간 충돌 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X3);
			if (bDir)
			{
				dMoveGap = fabs(dPos - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dPos);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}

		// Probe 간 충돌 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X7);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dPos);
			}
			else
			{
				dMoveGap = fabs(dPos - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X7)
	{
		// Probe 간 충돌 방지
		double dCur = 0, dMoveGap = 0;
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X5);
			if (bDir)
			{
				dMoveGap = fabs(dPos - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dPos);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
		// Probe 간 충돌 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X9);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dPos);
			}
			else
			{
				dMoveGap = fabs(dPos - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X9)
	{
		// Probe 간 충돌 방지
		double dCur = 0, dMoveGap = 0;
		// LYS 2026-08-25 OCP carries no P4 gantry, so GetOrgPos(AXIS_PROBE_X7) reads 0
		// and this INTERLOCKPROBEGAP(173mm) check rejects every X9 target that lies
		// inside the axis' own SW limit, i.e. all of them. Skip it on OCP.
		if (nRet == df_MOTION_RV_SUCCESSED && !m_bIsOCP)
		{
			dCur = GetOrgPos(AXIS_PROBE_X7);
			if (bDir)
			{
				dMoveGap = fabs(dPos - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dPos);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}

		// jsyoon 2022.04.14 add
		// Probe unut 과 Head 충돌 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_X2);

			if (dPos > dCur + 5)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		///
	}
	else if (iAxis == AXIS_Z1)	// jsyoon 2022.09.30 add
	{
		if (dPos > 1)
		{
			// Head Z 이동 시 Probe Unit 충돌 인터락
			if (nRet == VTM_RV_SUCCESSED)
			{
				if (GetOrgPos(AXIS_PROBE_Z1) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z2) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z3) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z4) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z5) < -5.1)
				{
					nRet = MOTION_INTERLOCK_7;
				}
			}
			
			// Head Z 이동 시 Head Gantry 위치로 Probe Unit 충돌 방지
			if (nRet == VTM_RV_SUCCESSED)
			{
				// LYS 2026-08-25 BACK Z goes down onto whatever sits under the BACK gantry.
				// Block it while the gantry is inside the P5 probe unit footprint.
				if (IsProbeUnitOverlapX(GetOrgPos(AXIS_X2)) == true)
				{
					nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X9;

					CString strLog;
					strLog.Format(_T("MoveCmdPosA_Sub Z1 DOWN NG - PROBE UNIT(X9:%.3f, SIZE:%.1f) vs BACK GANTRY(X2:%.3f)"),
						GetOrgPos(AXIS_PROBE_X9), m_dInterlockProbeSizeX, GetOrgPos(AXIS_X2));
					m_pLogFileAccessor->KMLOG(WARN, strLog, true);
				}
			}
		}
	}
	else if (iAxis == AXIS_Z2)		// jsyoon 2022.04.18 add Interlock
	{
		if (dPos > 1)
		{
			// Head Z 이동 시 Probe Unit 충돌 인터락
			if (nRet == VTM_RV_SUCCESSED)
			{
				if (GetOrgPos(AXIS_PROBE_Z1) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z2) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z3) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z4) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z5) < -5.1)
				{
					nRet = MOTION_INTERLOCK_7;
				}
			}
			
			double dCur = 0.;

			// Head Z 이동 범위 인터락
			if (nRet == VTM_RV_SUCCESSED)
			{			
				dCur = GetOrgPos(AXIS_X2);

				if (dCur < GetMinSWLimit(AXIS_X2) + 35)	// 35 is Revivew Lens 지름 +
				{
					nRet = MOTION_INTERLOCK_7;
				}
			}

			// LYS 2026-08-25 The FRONT Z (Z2) rides on the FRONT gantry (X3), and that
			// stroke does not reach the P5 probe unit - no Head/Probe interlock is needed
			// here. The check that used to sit at this spot read AXIS_X2, the BACK gantry,
			// which was the wrong pair to begin with (X2 belongs to Z1).
		}
	}
	else if (iAxis == AXIS_LOADER_Z)	// 2023.04.10 add Life Pin, Prebe Unit Interlock
	{
		// Loader  Z 이동 범위 인터락
		if (nRet == VTM_RV_SUCCESSED)
		{
			double dCur = 0;
			dCur = GetOrgPos(AXIS_X);

			if (dCur < GetMaxSWLimit(AXIS_X) - 100) // Safety 위치	
			{
				nRet = MOTION_INTERLOCK_3;
			}
		}

		// Loader Z 이동시 Probe Unit이 Loader 에 있을 경우 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// LYS 2026-08-25 restored - the OCP gantry X moves now, so the Loader Z
			// interlock has to see its position again.
			{
				double dCur = 0;
				dCur = GetOrgPos(AXIS_PROBE_X9);

				if (dCur > m_dInterlockLifePinPos)
				{
					nRet = MOTION_INTERLOCK_3;
				}
			}
		}
	}
	else
	{
		// jsyoon 2022.09.30 add
		// Probe Unit 과 Head Z 충돌 인터락
		if (iAxis == AXIS_PROBE_Z1 || iAxis == AXIS_PROBE_Z2 || iAxis == AXIS_PROBE_Z3 || iAxis == AXIS_PROBE_Z4 || iAxis == AXIS_PROBE_Z5)
		{
			if (dPos < -5.1)
			{
				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					double dCur = 0;
					dCur = GetOrgPos(AXIS_Z1);
					if (dCur > 1)
					{
						nRet = MOTION_INTERLOCK_7;
					}
				}
				
				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					double dCur = 0;
					dCur = GetOrgPos(AXIS_Z2);
					if (dCur > 1)
					{
						nRet = MOTION_INTERLOCK_7;
					}
				}
			}
		}
	 }
	
	// Probe Master Slave 틀어짐 
	if (iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X10)
	{
		double dCur = 0, dMoveGap = 0;
		dCur = GetOrgPos(iAxis - 1);
		dMoveGap = fabs(dPos - dCur);	// Master - Slave
		if (dMoveGap > 5)
		{
			nRet = MOTION_INTERLOCK_7;
		}
	}

	// Probe Z Contect
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (iAxis == AXIS_X || iAxis == AXIS_LOADER_R ||
			iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X9 || iAxis == AXIS_PROBE_X10 ||
			iAxis == AXIS_PROBE_Y1 || iAxis == AXIS_PROBE_Y2 || iAxis == AXIS_PROBE_Y3 || iAxis == AXIS_PROBE_Y4 || iAxis == AXIS_PROBE_Y5 )
		{
			double dPROBE_Z1 = 0., dPROBE_Z2 = 0., dPROBE_Z3 = 0., dPROBE_Z4 = 0., dPROBE_Z5 = 0.;
			dPROBE_Z1 = GetOrgPos(AXIS_PROBE_Z1);
			dPROBE_Z2 = GetOrgPos(AXIS_PROBE_Z2);
			dPROBE_Z3 = GetOrgPos(AXIS_PROBE_Z3);
			dPROBE_Z4 = GetOrgPos(AXIS_PROBE_Z4);
			dPROBE_Z5 = GetOrgPos(AXIS_PROBE_Z5);

			if (dPROBE_Z1 > 0.1 ||
				dPROBE_Z2 > 0.1 ||
				dPROBE_Z3 > 0.1 ||
				dPROBE_Z4 > 0.1 ||
				dPROBE_Z5 > 0.1 )
			{
				stMotorPosition stPositionProbe[5];
				stPositionProbe[0].axis = AXIS_PROBE_Z1;
				stPositionProbe[0].dPosition = 0;
				stPositionProbe[1].axis = AXIS_PROBE_Z2;
				stPositionProbe[1].dPosition = 0;
				stPositionProbe[2].axis = AXIS_PROBE_Z3;
				stPositionProbe[2].dPosition = 0;
				stPositionProbe[3].axis = AXIS_PROBE_Z4;
				stPositionProbe[3].dPosition = 0;
				stPositionProbe[4].axis = AXIS_PROBE_Z5;
				stPositionProbe[4].dPosition = 0;

				nRet = MoveCmdPosMulti(stPositionProbe, 5, SPEED_HIGH, true);

				nRet = MOTION_INTERLOCK_8;

				CString strLog;
				strLog.Format(_T("MoveCmdPosA_Sub PROBE_Z NG(%.3f,%.3f,%.3f,%.3f,%.3f)"), dPROBE_Z1, dPROBE_Z2, dPROBE_Z3, dPROBE_Z4, dPROBE_Z5);
				m_pLogFileAccessor->KMLOG(WARN, strLog, true);
			}
		}
	}

	// Head Z 와 Probe Unit 충돌 인터락
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X9 || iAxis == AXIS_PROBE_X10 ||
			iAxis == AXIS_PROBE_Y1 || iAxis == AXIS_PROBE_Y2 || iAxis == AXIS_PROBE_Y3 || iAxis == AXIS_PROBE_Y4 || iAxis == AXIS_PROBE_Y5)
		{
			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				double dFront_Z = 0., dBack_Z = 0.;
				dFront_Z = GetOrgPos(AXIS_Z1);
				dBack_Z = GetOrgPos(AXIS_Z2);

				if (dFront_Z > 1 || dBack_Z > 1)
				{
					nRet = MOTION_INTERLOCK_8;

					CString strLog;
					strLog.Format(_T("MoveCmdPosA_Sub HEAD_Z NG(%.3f,%.3f,%.3f,%.3f,%.3f)"), dFront_Z, dBack_Z);
					m_pLogFileAccessor->KMLOG(WARN, strLog, true);
				}

			}
		}
	}

	// LOADER Z Down Interlock
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (iAxis != AXIS_LOADER_Z)
		{
			double dCurPos = 0;
			dCurPos = GetOrgPos(AXIS_LOADER_Z);
			if (dCurPos > 0.1)
			{
				nRet = MOTION_INTERLOCK_1;
			}
		}
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (IsOutOfService() == true)
		{
			if (GetMinSWLimit(iAxis) > dPos || GetMaxSWLimit(iAxis) < dPos)
			{
				return MOTION_INTERLOCK_CHECK_ALARM;
			}

			double dCur = 0, dMove = 0, dSpeed = 0;
			dCur = GetOrgPos(iAxis);
			dMove = dPos - dCur;
			dSpeed = GetSpeed(iAxis, iSpeed);
			int nStep = 0, nCnt = 0;
			nStep = (int)(dMove / dSpeed);
			nCnt = abs(nStep);

			if (nStep > 0)
			{
				for (size_t i = 1; i <= nCnt; i++)
				{
					Sleep(dSpeed);
					m_dMovePos[iAxis] = dCur + (dSpeed * i);
				}
			}
			else if (nStep < 0)
			{
				for (size_t i = 1; i <= nCnt; i++)
				{
					Sleep(dSpeed);
					m_dMovePos[iAxis] = dCur - (dSpeed * i);
				}
			}

			if (nStep != 0) Sleep(1000);

			if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X9)
			{
				m_dMovePos[iAxis + 1] = dPos;
			}

			m_dMovePos[iAxis] = dPos;

			return df_MOTION_RV_SUCCESSED;
		}
		else
		{
			if (m_pFunction->IsConnected() != true)
			{
				return MEI_NOT_CREATED;
			}
		}
	}
	else
	{
		return nRet;
	}
	
	CString strLog;
	strLog.Format(_T("MoveCmdPosA Move(AXIS:%d, POS:%.3f, SPPED:%d, DoneCheck:%d)"), iAxis, dPos, iSpeed, bBlockMode);
	m_pLogFileAccessor->KMLOG(SYST, strLog, true);

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		nRet = MoveCmdPosA_Move(iAxis, dPos, bBlockMode, iSpeed, iLens, iTube);
	}
	
	//CCriticalSectionSync single(&m_cs, TRUE);
	//
	//if (nRet == df_MOTION_RV_SUCCESSED)
	//{
	//	long lRet = 0;
	//	lRet = m_pFunction->MoveCmdPosA(iAxis, dPos, bBlockMode, iSpeed, iLens, iTube);
	//	if (nRet == 1)
	//	{
	//		nRet = df_MOTION_RV_SUCCESSED;
	//	}
	//	else if (nRet == -1)
	//	{
	//		nRet = MEI_NOT_CREATED;
	//	}
	//	else
	//	{
	//		nRet = MOTION_CMDPOS_ERROR; // MOTION_MOVE_ALARM + iAxis;
	//	}
	//	//if (lRet == 1)
	//	//	nRet = df_MOTION_RV_SUCCESSED;
	//	//else
	//	//	nRet = MOTION_MOVE_ALARM + iAxis;
	//}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (bBlockMode == true)
		{
			int nLoop = 0;
			do
			{
				Sleep(100);
				nRet = m_pFunction->CheckMoveDone(iAxis, df_MOVINGDONE_TIME);
				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					double dDonePos = 0;
					dDonePos = GetOrgPos(iAxis);
					if (fabs(dDonePos - dPos) > 0.01)
					{
						nRet = MOTION_MOVE_ALARM + iAxis;
					}
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					break;
				}

				if (nLoop > 2)
				{
					nRet = MOTION_MOVE_ALARM + iAxis;
					break;
				}

				nRet = MoveCmdPosA_Move(iAxis, dPos, bBlockMode, iSpeed, iLens, iTube);

			//	nRet = m_pFunction->MoveCmdPosA(iAxis, dPos, bBlockMode, iSpeed, iLens, iTube); 
				if (nRet != df_MOTION_RV_SUCCESSED)
				{
					break;
				}

				nLoop++;

			} while (true);
		}
	}

	return nRet;
}

long CMotorControlMgr::MoveCmdPosA(int iAxis, double dPos, bool bBlockMode, int iSpeed, int iLens, int iTube)
{
	CString strLog;
	CString strAxis;
	strAxis.Format(_T("%s"), GetAxisMapProperty(iAxis)->m_strAxisName);

	strLog.Format(_T("MoveCmdPosA Start(AXIS:%s, POS:%.3f, SPPED:%d, DoneCheck:%d)"), strAxis, dPos, iSpeed, bBlockMode);
	m_pLogFileAccessor->KMLOG(SYST, strLog, true);

	long nRet = df_MOTION_RV_SUCCESSED;

	nRet = MoveCmdPosA_Sub(iAxis, dPos, bBlockMode, iSpeed, iLens, iTube);

	strLog.Format(_T("MoveCmdPosA End(AXIS:%s, POS:%.3f, RET:%d)"), strAxis, dPos, nRet);

	if (nRet == VTM_RV_SUCCESSED)
		m_pLogFileAccessor->KMLOG(SYST, strLog, true);
	else
		m_pLogFileAccessor->KMLOG(WARN, strLog, true);

	return nRet;
}

long CMotorControlMgr::MoveCmdPosAModify(int iAxis, double dPos)
{
	CCriticalSectionSync single(&m_cs, TRUE);
	
	return m_pFunction->MoveCmdPosAModify(iAxis, dPos);
}


long CMotorControlMgr::MoveCmdPosR_Sub(int iAxis, double dPos, bool bBlockMode, int iSpeed)
{
	long nRet = df_MOTION_RV_SUCCESSED;
	bool bDir = true;

	// jsyoon 20210825 add Rotate Interlock
	if (iAxis == AXIS_X)
	{
		// R 위치 확인후 0 혹은 180 도 근처일때만 이동
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			double dCurPos = 0;
			dCurPos = GetOrgPos(AXIS_LOADER_R);
			if (fabs(dCurPos) < 2 || fabs(dCurPos - 90) < 2 || fabs(dCurPos - 180) < 2 || fabs(dCurPos - 270) < 2)	// LYS 2026-08-07 rotation-change: station angles {0,90,180,270}
			{
				;
			}
			else
			{
				nRet = MOTION_ROTATE_POS_ERROR;
			}
		}

		// R 이동시 X 이동 금지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (CheckMoveDone(AXIS_LOADER_R, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_R;
			}
		}
	}
	else if (iAxis == AXIS_LOADER_R)
	{
		// R 이동 위치 제한
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			double dCurPos = 0;
			dCurPos = GetOrgPos(AXIS_LOADER_R);
			if (fabs(dCurPos) < 2 || fabs(dCurPos - 90) < 2 || fabs(dCurPos - 180) < 2 || fabs(dCurPos - 270) < 2)	// LYS 2026-08-07 rotation-change: station angles {0,90,180,270}
			{
				;
			}
			else
			{
				if (GetOrgPos(AXIS_X) < m_dInterlockPos)
				{
					nRet = MOTION_ROTATE_POS_ERROR;
				}
			}
		}
	}
	else if (iAxis == AXIS_X2)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Gantry 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dMove = GetOrgPos(AXIS_X2) + dPos;
			dCur  = GetOrgPos(AXIS_X3);

			if (bDir)
			{
				dMoveGap = fabs(dMove - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dMove);
			}

			if (dMoveGap < m_dInterlockGantryGap - 0.01)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}	

		// Probe 이동 시 X2 이동 금지
		if (nRet == VTM_RV_SUCCESSED)
		{
			if (CheckMoveDone(AXIS_PROBE_X9, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_PROBE_X9;
			}
		}

		// Probe unit 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X9);

			if (dMove < (dCur - 5))		// Probe Unit을 넘어가는 경우
			{
				nRet = MOTION_INTERLOCK_5;
			}
		}

		// Head Z축 이동 시 X2 이동 금지 WAD 기구물 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			if (CheckMoveDone(AXIS_Z2, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_Z2;
			}
		}

		// Head Down 시 이동 위치 제한
		if (nRet == VTM_RV_SUCCESSED)	// jsyoon 2022.04.18 add Interlock
		{
			dCur = GetOrgPos(AXIS_Z2);

			if (dCur > 0.1)
			{
				if (dMove < (GetMinSWLimit(AXIS_X2) + 35)) // jsyoon 2022.05.18 change 80 to 35
				{
					nRet = MOTION_INTERLOCK_8;
				}
			}
		}
	}
	else if (iAxis == AXIS_X3)
	{
		// Gantry 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			double dCur = 0, dMove = 0, dMoveGap = 0;
			dMove = GetOrgPos(AXIS_X3) + dPos;
			dCur = GetOrgPos(AXIS_X2);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dMove);
			}
			else
			{
				dMoveGap = fabs(dMove - dCur);
			}

			if (dMoveGap < m_dInterlockGantryGap - 0.01)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}	

		// Probe 이동 시 X3 이동 금지
		if (nRet == VTM_RV_SUCCESSED)
		{
			if (CheckMoveDone(AXIS_PROBE_X9, 10) != true)
			{
				nRet = MTOR_MOVE_DONE_TIME_OUT_ALARM + AXIS_PROBE_X9;
			}
		}

		// Head Down 시 이동 금지
		if (nRet == VTM_RV_SUCCESSED)
		{
			double dCurZ = 0, dMoveGap = 0;
			dCurZ = GetOrgPos(AXIS_Z1);
			if (dCurZ > 1)
			{
				nRet = MOTION_INTERLOCK_5;
			}
		}
	}

	else if (iAxis == AXIS_Y1)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(AXIS_Y1) + dPos;
			dCur = GetOrgPos(AXIS_Y2);

			if (bDir)
			{
				dMoveGap = fabs(dMove - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dMove);
			}

			if (dMoveGap < m_dInterlockHeadGapB)	// 2023.03.08 change
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
	}
	else if (iAxis == AXIS_Y2)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(AXIS_Y2) + dPos;
			dCur = GetOrgPos(AXIS_Y1);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dMove);
			}
			else
			{
				dMoveGap = fabs(dMove - dCur);
			}

			if (dMoveGap < m_dInterlockHeadGapB)	// 2023.03.08 change
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
	}
	else if (iAxis == AXIS_Y3)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(AXIS_Y3) + dPos;
			dCur = GetOrgPos(AXIS_Y4);

			if (bDir)
			{
				dMoveGap = fabs(dMove - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dMove);
			}

			if (dMoveGap < m_dInterlockHeadGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}	
	}
	else if (iAxis == AXIS_Y4)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Head 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(AXIS_Y4) + dPos;
			dCur = GetOrgPos(AXIS_Y3);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dMove);
			}
			else
			{
				dMoveGap = fabs(dMove - dCur);
			}

			if (dMoveGap < m_dInterlockHeadGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X1)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Probe 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(iAxis) + dPos;
			dCur = GetOrgPos(AXIS_PROBE_X3);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dMove);
			}
			else
			{
				dMoveGap = fabs(dMove - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X3)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Probe 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(iAxis) + dPos;
			dCur = GetOrgPos(AXIS_PROBE_X1);
			if (bDir)
			{
				dMoveGap = fabs(dMove - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dMove);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
		// Probe 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X5);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dMove);
			}
			else
			{
				dMoveGap = fabs(dMove - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X5)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Probe 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(iAxis) + dPos;
			dCur = GetOrgPos(AXIS_PROBE_X3);
			if (bDir)
			{
				dMoveGap = fabs(dMove - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dMove);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
		// Probe 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X7);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dMove);
			}
			else
			{
				dMoveGap = fabs(dMove - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X7)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Probe 간 충동 방지
		if (nRet == VTM_RV_SUCCESSED)
		{
			dMove = GetOrgPos(iAxis) + dPos;
			dCur = GetOrgPos(AXIS_PROBE_X5);
			if (bDir)
			{
				dMoveGap = fabs(dMove - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dMove);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
		
		// Probe 간 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dCur = GetOrgPos(AXIS_PROBE_X9);
			if (bDir)
			{
				dMoveGap = fabs(dCur - dMove);
			}
			else
			{
				dMoveGap = fabs(dMove - dCur);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_PROBE_X9)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		// Probe 간 충동 방지
		// LYS 2026-08-25 same P4-less reasoning as MoveCmdPosA_Sub.
		if (nRet == VTM_RV_SUCCESSED && !m_bIsOCP)
		{
			dMove = GetOrgPos(iAxis) + dPos;
			dCur = GetOrgPos(AXIS_PROBE_X7);
			if (bDir)
			{
				dMoveGap = fabs(dMove - dCur);
			}
			else
			{
				dMoveGap = fabs(dCur - dMove);
			}

			if (dMoveGap < m_dInterlockProbeGap)
			{
				nRet = MOTION_INTERLOCK_7;
			}
		}
	}
	else if (iAxis == AXIS_LOADER_Z)	// 2023.04.10 add Life Pin, Prebe Unit Interlock
	{
		// Loader  Z 이동 범위 인터락
		if (nRet == VTM_RV_SUCCESSED)
		{
			double dCur = 0;
			dCur = GetOrgPos(AXIS_X);

			if (dCur < GetMaxSWLimit(AXIS_X) - 100) // Safety 위치	
			{
				nRet = MOTION_INTERLOCK_3;
			}
		}

		// Loader Z 이동시 Probe Unit이 Loader 에 있을 경우 충동 방지
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// LYS 2026-08-25 restored - the OCP gantry X moves now, so the Loader Z
			// interlock has to see its position again.
			{
				double dCur = 0;
				dCur = GetOrgPos(AXIS_PROBE_X9);

				if (dCur > m_dInterlockLifePinPos)
				{
					nRet = MOTION_INTERLOCK_3;
				}
			}
		}
	}

	else if (iAxis == AXIS_Z1)	// jsyoon 2022.09.30 add
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		dMove = GetOrgPos(AXIS_Z1) + dPos;
		if (dMove > 1)
		{
			// Head Z 이동 시 Probe Unit 충돌 인터락
			if (nRet == VTM_RV_SUCCESSED)
			{
				if (GetOrgPos(AXIS_PROBE_Z1) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z2) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z3) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z4) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z5) < -5.1)
				{
					nRet = MOTION_INTERLOCK_7;
				}
			}
			
			// Head Z 이동 시 Head Gantry 위치로 Probe Unit 충돌 방지
			if (nRet == VTM_RV_SUCCESSED)
			{
				// LYS 2026-08-25 BACK Z goes down onto whatever sits under the BACK gantry.
				// Block it while the gantry is inside the P5 probe unit footprint.
				if (IsProbeUnitOverlapX(GetOrgPos(AXIS_X2)) == true)
				{
					nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X9;

					CString strLog;
					strLog.Format(_T("MoveCmdPosR_Sub Z1 DOWN NG - PROBE UNIT(X9:%.3f, SIZE:%.1f) vs BACK GANTRY(X2:%.3f)"),
						GetOrgPos(AXIS_PROBE_X9), m_dInterlockProbeSizeX, GetOrgPos(AXIS_X2));
					m_pLogFileAccessor->KMLOG(WARN, strLog, true);
				}
			}
		}
	}
	else if (iAxis == AXIS_Z2)		// jsyoon 2022.04.18 add Interlock
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		dMove = GetOrgPos(AXIS_Z2) + dPos;
		if (dMove > 1)
		{
			// Head Z 이동 시 Probe Unit 충돌 인터락
			if (nRet == VTM_RV_SUCCESSED)
			{
				if (GetOrgPos(AXIS_PROBE_Z1) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z2) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z3) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z4) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z5) < -5.1)
				{
					nRet = MOTION_INTERLOCK_7;
				}
			}
			
			// Head Z 이동 범위 제한
			if (nRet == VTM_RV_SUCCESSED)
			{
				double dCurX2 = 0;
				dCurX2 = GetOrgPos(AXIS_X2);

				if (dCurX2 < GetMinSWLimit(AXIS_X2) + 35)	// 35 is Revivew Lens 지름 +
				{
					nRet = MOTION_INTERLOCK_7;
				}
			}

			// LYS 2026-08-25 The FRONT Z (Z2) rides on the FRONT gantry (X3), and that
			// stroke does not reach the P5 probe unit - no Head/Probe interlock is needed
			// here. The check that used to sit at this spot read AXIS_X2, the BACK gantry,
			// which was the wrong pair to begin with (X2 belongs to Z1).
		}
	}
	else
	{
		// Probe Unit 과 Head Z 충돌 인터락
		if (iAxis == AXIS_PROBE_Z1 || iAxis == AXIS_PROBE_Z2 || iAxis == AXIS_PROBE_Z3 || iAxis == AXIS_PROBE_Z4 || iAxis == AXIS_PROBE_Z5)
		{
			double dCur = 0, dMove = 0;
			dMove = GetOrgPos(iAxis) + dPos;
			if (dMove < -5.1)
			{
				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					dCur = GetOrgPos(AXIS_Z1);
					if (dCur > 1)
					{
						nRet = MOTION_INTERLOCK_7;
					}
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					dCur = GetOrgPos(AXIS_Z2);
					if (dCur > 1)
					{
						nRet = MOTION_INTERLOCK_7;
					}
				}
			}
		}
	 }

	// Slave
	if (iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X10)
	{
		double dCur = 0, dMove = 0, dMoveGap = 0;
		dMove = GetOrgPos(iAxis) + dPos;
		dCur  = GetOrgPos(iAxis - 1);
		dMoveGap = fabs(dMove - dCur);	// Master - Slave
		if (dMoveGap > 5)
		{
			nRet = MOTION_INTERLOCK_7;
		}
	}

	// Probe Z Contact
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		//	if (iAxis == AXIS_X || iAxis == AXIS_LOADER_R)
		if (iAxis == AXIS_X || iAxis == AXIS_LOADER_R ||
			iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X9 || iAxis == AXIS_PROBE_X10 ||
			iAxis == AXIS_PROBE_Y1 || iAxis == AXIS_PROBE_Y2 || iAxis == AXIS_PROBE_Y3 || iAxis == AXIS_PROBE_Y4 || iAxis == AXIS_PROBE_Y5)
		{
			if (GetOrgPos(AXIS_PROBE_Z1) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z2) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z3) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z4) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z5) > 0.1)
			{
				double dPos = 0;

			/*	stMotorPosition stPositionProbe[5];
				stPositionProbe[0].axis = AXIS_PROBE_Z1;
				stPositionProbe[0].dPosition = dPos;
				stPositionProbe[1].axis = AXIS_PROBE_Z2;
				stPositionProbe[1].dPosition = dPos;
				stPositionProbe[2].axis = AXIS_PROBE_Z3;
				stPositionProbe[2].dPosition = dPos;
				stPositionProbe[3].axis = AXIS_PROBE_Z4;
				stPositionProbe[3].dPosition = dPos;
				stPositionProbe[4].axis = AXIS_PROBE_Z5;
				stPositionProbe[4].dPosition = dPos;

				nRet = MoveCmdPosMulti(stPositionProbe, 5, SPEED_HIGH, true);*/

				nRet = MOTION_INTERLOCK_8;
			}
		}
	}

	// Head Z 와 Probe Unit 충돌 인터락
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X9 || iAxis == AXIS_PROBE_X10 ||
			iAxis == AXIS_PROBE_Y1 || iAxis == AXIS_PROBE_Y2 || iAxis == AXIS_PROBE_Y3 || iAxis == AXIS_PROBE_Y4 || iAxis == AXIS_PROBE_Y5)
		{
			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				double dFront_Z = 0., dBack_Z = 0.;
				dFront_Z = GetOrgPos(AXIS_Z1);
				dBack_Z  = GetOrgPos(AXIS_Z2);

				if (dFront_Z > 1 || dBack_Z > 1)
				{
					nRet = MOTION_INTERLOCK_8;

					CString strLog;
					strLog.Format(_T("MoveCmdPosR_Sub HEAD_Z NG(%.3f,%.3f,%.3f,%.3f,%.3f)"), dFront_Z, dBack_Z);
					m_pLogFileAccessor->KMLOG(WARN, strLog, true);
				}
			}
		}
	}

	// LOADER Z Down Interlock
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (iAxis != AXIS_LOADER_Z)
		{
			double dCurPos = 0;
			dCurPos = GetOrgPos(AXIS_LOADER_Z);
			if (dCurPos > 0.1)
			{
				nRet = MOTION_INTERLOCK_1;
			}
		}
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (IsOutOfService() == true)
		{
			if (GetMinSWLimit(iAxis) > m_dMovePos[iAxis] + dPos || GetMaxSWLimit(iAxis) < m_dMovePos[iAxis] + dPos)
			{
				return MOTION_INTERLOCK_CHECK_ALARM;
			}

			if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X9)
			{
				m_dMovePos[iAxis + 1] += dPos;
			}

			m_dMovePos[iAxis] += dPos;
			return df_MOTION_RV_SUCCESSED;
		}
		else
		{
			if (m_pFunction->IsConnected() != true)
			{
				return MEI_NOT_CREATED;
			}
		}
	}
	else
	{
		return nRet;
	}

	CCriticalSectionSync single(&m_cs, TRUE);

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		long lRet = 0;
		lRet = m_pFunction->MoveCmdPosR(iAxis, dPos, bBlockMode, iSpeed);
		if (nRet == 1)
		{
			nRet = df_MOTION_RV_SUCCESSED;
		}
		else if (nRet == -1)
		{
			nRet = MEI_NOT_CREATED;
		}
		else
		{
			nRet = MOTION_CMDPOS_ERROR; // MOTION_MOVE_ALARM + iAxis;
		}

		//if (lRet == 1)
		//	nRet = df_MOTION_RV_SUCCESSED;
		//else
		//	nRet = MOTION_MOVE_ALARM + iAxis;
	}

	//if (nRet == df_MOTION_RV_SUCCESSED)
	//{
	//	if (iAxis == AXIS_X || iAxis == AXIS_Y || iAxis == AXIS_LOADER_R)
	//	{
	//		if (m_pFunction->GetCurPos(AXIS_UNIT_Z, 0, 0) < 0.1)
	//		{
	//			if (m_pFunction->MoveCmdPosR(iAxis, dPos, bBlockMode, iSpeed) != 0)
	//				nRet = df_MOTION_RV_SUCCESSED;
	//			else
	//				nRet = MOTION_MOVE_ALARM + iAxis;
	//		}
	//		else
	//		{
	//			nRet = MOTION_PB_STANDBY_POS_FAIL;
	//		}
	//	}
	//	//else if (iAxis == AXIS_Y1)
	//	//{
	//	//	double dCur = 0, dMovePos = 0;
	//	//	dCur = m_pFunction->GetCurPos(AXIS_Z2, 0, 0); // +
	//	//	dMovePos = m_pFunction->GetCurPos(AXIS_Y1, 0, 0) + dPos;
	//	//	if (fabs(dCur - dMovePos) < m_dInterlockHeadGap)
	//	//	{
	//	//		nRet = MOTION_INTERLOCK_7;
	//	//	}

	//	//	if (nRet == df_MOTION_RV_SUCCESSED)
	//	//	{
	//	//		if (m_pFunction->MoveCmdPosR(iAxis, dPos, bBlockMode, iSpeed) != 0)
	//	//			nRet = df_MOTION_RV_SUCCESSED;
	//	//		else
	//	//			nRet = MOTION_MOVE_ALARM + iAxis;
	//	//	}
	//	//}
	//	//else if (iAxis == AXIS_Z2)
	//	//{
	//	//	double dCur = 0, dMovePos = 0;
	//	//	dCur = m_pFunction->GetCurPos(AXIS_Y1, 0, 0); // -
	//	//	dMovePos = m_pFunction->GetCurPos(AXIS_Z2, 0, 0) + dPos;
	//	//	if (fabs(dMovePos - dCur) < m_dInterlockHeadGap)
	//	//	{
	//	//		nRet = MOTION_INTERLOCK_7;
	//	//	}

	//	//	if (nRet == df_MOTION_RV_SUCCESSED)
	//	//	{
	//	//		if (m_pFunction->MoveCmdPosR(iAxis, dPos, bBlockMode, iSpeed) != 0)
	//	//			nRet = df_MOTION_RV_SUCCESSED;
	//	//		else
	//	//			nRet = MOTION_MOVE_ALARM + iAxis;
	//	//	}
	//	//}
	//	else
	//	{
	//		if (m_pFunction->MoveCmdPosR(iAxis, dPos, bBlockMode, iSpeed) != 0)
	//			nRet = df_MOTION_RV_SUCCESSED;
	//		else
	//			nRet = MOTION_MOVE_ALARM + iAxis;
	//	}
	//}

	return nRet;
}


long CMotorControlMgr::MoveCmdPosR(int iAxis, double dPos, bool bBlockMode, int iSpeed)
{
	// jsyoon 20210831 change
	CString strLog;
	CString strAxis;
	strAxis.Format(_T("%s"), GetAxisMapProperty(iAxis)->m_strAxisName);

	strLog.Format(_T("MoveCmdPosR Start(AXIS:%s, POS:%.3f, SPPED:%d)"), strAxis, dPos, iSpeed);
	m_pLogFileAccessor->KMLOG(SYST, strLog, true);

	long nRet = df_MOTION_RV_SUCCESSED;

	nRet = MoveCmdPosR_Sub(iAxis, dPos, bBlockMode, iSpeed);

	strLog.Format(_T("MoveCmdPosR End(AXIS:%s, POS:%.3f, RET:%d)"), strAxis, dPos, nRet);

	if( nRet == VTM_RV_SUCCESSED)
		m_pLogFileAccessor->KMLOG(SYST, strLog, true);
	else
		m_pLogFileAccessor->KMLOG(WARN, strLog, true);
		

	return nRet;
}

long CMotorControlMgr::MoveCmdPosMulti_Move(stMotorPosition* pPos, int iAxis, int iSpeed)
{
	long nRet = df_MOTION_RV_SUCCESSED;

	CCriticalSectionSync single(&m_cs, TRUE);

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		long lRet = 0;
		nRet = m_pFunction->MoveCmdPosMulti(pPos, iAxis, iSpeed);
		if (nRet == 1)
		{
			nRet = df_MOTION_RV_SUCCESSED;
		}
		else if (nRet == -1)
		{
			nRet = MEI_NOT_CREATED;
		}
		else
		{
			nRet = MOTION_CMDPOS_ERROR; // MOTION_MOVE_ALARM + iAxis;
		}
	}

	return nRet;
}

long CMotorControlMgr::MoveCmdPosMulti_Sub(stMotorPosition *pPos, int iAxis, int iSpeed, bool bDoneCheck)
{
	long nRet = df_MOTION_RV_SUCCESSED;
	bool bDir = true;

	// jsyoon 20210825 add Rotate Interlock
	for (size_t i = 0; i < iAxis; i++)
	{
		if (pPos[i].axis == AXIS_X)
		{
			// R 위치 확인후 0 혹은 180 도 근처일때만 이동
			double dCurPos = 0;
			dCurPos = GetOrgPos(AXIS_LOADER_R);
			if (!(fabs(dCurPos) < 1 || fabs(dCurPos - 90) < 1 || fabs(dCurPos - 180) < 1 || fabs(dCurPos - 270) < 1))	// LYS 2026-08-07 rotation-change: error unless at station angle (old cond was inverted)
				//	if ((dCurPos > 0.1 && dCurPos < 179.9) || dCurPos < -0.1 || dCurPos > 180.1)
			{
				nRet = MOTION_ROTATE_POS_ERROR;
				break;
			}

			// R 이동시 X 이동 금지
			if (m_pFunction->CheckMoveDone(AXIS_LOADER_R, df_MOVINGDONE_TIME) != true)
			{
				nRet = MOTION_MOVE_DONE_ALARM + AXIS_LOADER_R;
				break;
			}
		}
		else if (pPos[i].axis == AXIS_LOADER_R)
		{
			if (GetOrgPos(AXIS_X) < m_dInterlockPos)
			{
				nRet = MOTION_ROTATE_POS_ERROR;
			}
		}
		else if (pPos[i].axis == AXIS_Y1)
		{
			for (size_t j = 0; j < iAxis; j++)
			{
				if (pPos[j].axis == AXIS_Y2)
				{
					double dMoveGap = 0;
					if (bDir)
					{
						dMoveGap = fabs(pPos[i].dPosition - pPos[j].dPosition);
					}
					else
					{
						dMoveGap = fabs(pPos[j].dPosition - pPos[i].dPosition);
					}

					if (dMoveGap < m_dInterlockHeadGap)		// LYS 2026-07-16 change
					//if (dMoveGap < m_dInterlockHeadGapB)	// 2023.03.08 change
					{
						nRet = MOTION_INTERLOCK_7;
					}

					break;
				}
			}
		}
		else if (pPos[i].axis == AXIS_Y2)
		{
			for (size_t j = 0; j < iAxis; j++)
			{
				if (pPos[j].axis == AXIS_Y1)
				{
					double dMoveGap = 0;
					if (bDir)
					{
						dMoveGap = fabs(pPos[j].dPosition - pPos[i].dPosition);
					}
					else
					{
						dMoveGap = fabs(pPos[i].dPosition - pPos[j].dPosition);
					}

					if (dMoveGap < m_dInterlockHeadGap)		// LYS 2026-07-16 change
				//	if (dMoveGap < m_dInterlockHeadGapB)	// 2023.03.08 change
					{
						nRet = MOTION_INTERLOCK_7;
					}

					break;
				}
			}
		}
		else if (pPos[i].axis == AXIS_Y3)
		{
			for (size_t j = 0; j < iAxis; j++)
			{
				if (pPos[j].axis == AXIS_Y4)
				{
					double dMoveGap = 0;
					if (bDir)
					{
						dMoveGap = fabs(pPos[i].dPosition - pPos[j].dPosition);
					}
					else
					{
						dMoveGap = fabs(pPos[j].dPosition - pPos[i].dPosition);
					}

					if (dMoveGap < m_dInterlockHeadGap)
					{
						nRet = MOTION_INTERLOCK_7;
					}

					break;
				}
			}
		}
		else if (pPos[i].axis == AXIS_Y4)
		{
			for (size_t j = 0; j < iAxis; j++)
			{
				if (pPos[j].axis == AXIS_Y3)
				{
					double dMoveGap = 0;
					if (bDir)
					{
						dMoveGap = fabs(pPos[j].dPosition - pPos[i].dPosition);
					}
					else
					{
						dMoveGap = fabs(pPos[i].dPosition - pPos[j].dPosition);
					}

					if (dMoveGap < m_dInterlockHeadGap)
					{
						nRet = MOTION_INTERLOCK_7;
					}

					break;
				}
			}
		}
		else if (pPos[i].axis == AXIS_X2)
		{
			// jsyoon 2022.04.14 add
			double dCur = 0., dCurZ = 0.;
			dCurZ = GetOrgPos(AXIS_Z);
			// LYS 2026-07-31 remove
			//if (dCurZ > -90)
			//{
			//	// Probe 충돌 인터락
			//	dCur = GetOrgPos(AXIS_PROBE_X9);
			//
			//	if (pPos[i].dPosition < (dCur - 5))
			//	{
			//		nRet = MOTION_INTERLOCK_5;
			//		break;
			//	}
			//
			//	if (nRet == VTM_RV_SUCCESSED)	// jsyoon 2022.04.18 add Interlock
			//	{
			//		dCurZ = GetOrgPos(AXIS_Z);
			//		if (dCurZ > 0.1)
			//		{
			//			// 시야각 WAD 충돌 인터락
			//			if (pPos[i].dPosition < (GetMinSWLimit(AXIS_X2) + 35))  // jsyoon 2022.05.18 change 80 to 35
			//			{
			//				nRet = MOTION_INTERLOCK_8;
			//			}
			//		}
			//	}
			//}
		}
		else if (pPos[i].axis == AXIS_Z1)	// jsyoon 2022.09.30 add
		{
			if (pPos[i].dPosition > 10)
			{
				if (GetOrgPos(AXIS_PROBE_Z1) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z2) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z3) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z4) < -5.1 ||
					GetOrgPos(AXIS_PROBE_Z5) < -5.1)
				{
					nRet = MOTION_INTERLOCK_7;
					break;
				}		

				// LYS 2026-08-25 BACK Z goes down onto whatever sits under the BACK gantry.
				// Block it while the gantry is inside the P5 probe unit footprint.
				if (IsProbeUnitOverlapX(GetOrgPos(AXIS_X2)) == true)
				{
					nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X9;

					CString strLog;
					strLog.Format(_T("MoveCmdPosMulti_Sub Z1 DOWN NG - PROBE UNIT(X9:%.3f, SIZE:%.1f) vs BACK GANTRY(X2:%.3f)"),
						GetOrgPos(AXIS_PROBE_X9), m_dInterlockProbeSizeX, GetOrgPos(AXIS_X2));
					m_pLogFileAccessor->KMLOG(WARN, strLog, true);

					break;
				}
			}
		}
		else if (pPos[i].axis == AXIS_PROBE_X9)
		{
			// jsyoon 2022.04.14 add
			double dCur = 0;
			dCur = GetOrgPos(AXIS_Z2);
			if (dCur > -1)
			{
				dCur = GetOrgPos(AXIS_X2);

				if (pPos[i].dPosition > dCur + 5)
				{
					nRet = MOTION_INTERLOCK_7;
					break;
				}
			}
		}
		else if (pPos[i].axis == AXIS_Z2)		// jsyoon 2022.04.18 add Interlock
		{
			if (pPos[i].dPosition > 0)
			{
				double dCur = 0, dMoveGap = 0;
				dCur = GetOrgPos(AXIS_X2);

				if (dCur < GetMinSWLimit(AXIS_X2) + 35)  // jsyoon 2022.05.18 change 80 to 35
				{
					nRet = MOTION_INTERLOCK_8;
				}
			}
		}
		else if (pPos[i].axis == AXIS_PROBE_X1)
		{
			;
		}
		else
		{
			// jsyoon 2022.09.30 add
			if (pPos[i].axis == AXIS_PROBE_Z1 || pPos[i].axis == AXIS_PROBE_Z2 || pPos[i].axis == AXIS_PROBE_Z3 || pPos[i].axis == AXIS_PROBE_Z4 || pPos[i].axis == AXIS_PROBE_Z5)
			{
				if (pPos[i].dPosition < -5.1 )
				{
					double dCur = 0;
					dCur = GetOrgPos(AXIS_Z);
					if (dCur > 10)
					{
						nRet = MOTION_INTERLOCK_7;
						break;
					}
				}
			}
		}
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		bool bProbeZMove = false;
		int axis = 0;
		for (size_t i = 0; i < iAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_X || axis == AXIS_LOADER_R || 
				axis == AXIS_PROBE_X1 || axis == AXIS_PROBE_X2 || axis == AXIS_PROBE_X3 || axis == AXIS_PROBE_X4 || axis == AXIS_PROBE_X5 || axis == AXIS_PROBE_X6 || axis == AXIS_PROBE_X7 || axis == AXIS_PROBE_X8 || axis == AXIS_PROBE_X9 || axis == AXIS_PROBE_X10 ||
				axis == AXIS_PROBE_Y1 || axis == AXIS_PROBE_Y2 || axis == AXIS_PROBE_Y3 || axis == AXIS_PROBE_Y4 || axis == AXIS_PROBE_Y5 )
			{
				bProbeZMove = true;
				break;
			}
		}

		if(bProbeZMove == true)
		{
			if (GetOrgPos(AXIS_PROBE_Z1) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z2) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z3) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z4) > 0.1 ||
				GetOrgPos(AXIS_PROBE_Z5) > 0.1)
				//		if (GetCurPos(AXIS_PROBE_Z1) > 0 || GetCurPos(AXIS_PROBE_Z2) > 0 || GetCurPos(AXIS_PROBE_Z3) > 0 || GetCurPos(AXIS_PROBE_Z4) > 0 || GetCurPos(AXIS_PROBE_Z5) > 0)
			{
			/*	stMotorPosition stPositionProbe[5];
				stPositionProbe[0].axis = AXIS_PROBE_Z1;
				stPositionProbe[0].dPosition = 0;
				stPositionProbe[1].axis = AXIS_PROBE_Z2;
				stPositionProbe[1].dPosition = 0;
				stPositionProbe[2].axis = AXIS_PROBE_Z3;
				stPositionProbe[2].dPosition = 0;
				stPositionProbe[3].axis = AXIS_PROBE_Z4;
				stPositionProbe[3].dPosition = 0;
				stPositionProbe[4].axis = AXIS_PROBE_Z5;
				stPositionProbe[4].dPosition = 0;

				nRet = MoveCmdPosMulti(stPositionProbe, 5, SPEED_HIGH, true);*/

				nRet = MOTION_INTERLOCK_8;
			}


			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				double dFront_Z = 0., dBack_Z = 0.;
				dFront_Z = GetOrgPos(AXIS_Z1);
				dBack_Z  = GetOrgPos(AXIS_Z2);

				if (dFront_Z > 1 || dBack_Z > 1)
				{
					nRet = MOTION_INTERLOCK_8;

					CString strLog;
					strLog.Format(_T("MoveCmdPosM Move HEAD_Z NG(%.3f,%.3f,%.3f,%.3f,%.3f)"), dFront_Z, dBack_Z);
					m_pLogFileAccessor->KMLOG(WARN, strLog, true);
				}
			}
		}
	}

	// jsyoon 2022.05.19 add Interlock
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		double dCurPos = 0;
		dCurPos = GetOrgPos(AXIS_LOADER_Z);
		if (dCurPos > 0.1)
		{
			nRet = MOTION_INTERLOCK_1;
		}
	}

	///
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (IsOutOfService() == true)
		{
			CString strTemp, strTemp2;
			strTemp.Empty();

			for (size_t i = 0; i < iAxis; i++)
			{
				int axis = 0;
				double Pos = 0;

				axis = pPos[i].axis;
				Pos = pPos[i].dPosition;

				if (GetMinSWLimit(axis) > Pos || GetMaxSWLimit(axis) < Pos)
				{
					CString strLog;
					
					strLog.Format(_T("MoveCmdPosM Move(AXIS:%s, POS:%.3f, NG)"), GetAxisMapProperty(axis)->m_strAxisName, Pos);
					m_pLogFileAccessor->KMLOG(WARN, strLog, true);
					return MOTION_INTERLOCK_CHECK_ALARM;
				}

				if (axis == AXIS_PROBE_X1 || axis == AXIS_PROBE_X3 || axis == AXIS_PROBE_X5 || axis == AXIS_PROBE_X7 || axis == AXIS_PROBE_X9)
				{
					m_dMovePos[axis + 1] = Pos;
				}

				strTemp2.Format(_T("AXIS:%s, POS:%.3f,"), GetAxisMapProperty(axis)->m_strAxisName, Pos);
				strTemp += strTemp2;

				m_dMovePos[axis] = Pos;	
				Sleep(200);
			}

			CString strLog;
			strLog.Format(_T("MoveCmdPosM Move(%s nAXIS:%d, SPPED:%d, DoneCheck:%d)"), strTemp, iAxis, iSpeed, bDoneCheck);
			m_pLogFileAccessor->KMLOG(SYST, strLog, true);

			return df_MOTION_RV_SUCCESSED;
		}
	}
	else
	{
		return nRet;
	}

	CString strTemp, strTemp2;
	strTemp.Empty();

	for (size_t i = 0; i < iAxis; i++)
	{
		int axis = 0;
		double Pos = 0;

		axis = pPos[i].axis;
		Pos = pPos[i].dPosition;

		strTemp2.Format(_T("AXIS:%s, POS:%.3f,"), GetAxisMapProperty(axis)->m_strAxisName, Pos);
		strTemp += strTemp2;
	}

	CString strLog;
//	strLog.Format(_T("MoveCmdPosMulti_Move(AXIS:%d, POS:%.3f, nAXIS:%d, SPPED:%d, DoneCheck:%d)"), pPos[0].axis, pPos[0].dPosition, iAxis, iSpeed, bDoneCheck);
	strLog.Format(_T("MoveCmdPosM Move(%s nAXIS:%d, SPPED:%d, DoneCheck:%d)"), strTemp, iAxis, iSpeed, bDoneCheck);
	m_pLogFileAccessor->KMLOG(SYST, strLog, true);
	
	nRet = MoveCmdPosMulti_Move(pPos, iAxis, iSpeed);

	//CCriticalSectionSync single(&m_cs, TRUE);

	//if (nRet == df_MOTION_RV_SUCCESSED)
	//{
	//	long lRet = 0;
	//	nRet = m_pFunction->MoveCmdPosMulti(pPos, iAxis, iSpeed);
	//	if (nRet == 1)
	//	{
	//		nRet = df_MOTION_RV_SUCCESSED;
	//	}
	//	else if (nRet == -1)
	//	{
	//		nRet = MEI_NOT_CREATED;
	//	}
	//	else
	//	{
	//		nRet = MOTION_CMDPOS_ERROR; // MOTION_MOVE_ALARM + iAxis;
	//	}
	//}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		if (bDoneCheck == true)
		{
			for (size_t i = 0; i < iAxis; i++)
			{
				if (m_pFunction->CheckMoveDone(pPos[i].axis, df_MOVINGDONE_TIME * 3) != true)
				{
					nRet = MOTION_MOVE_DONE_ALARM + pPos[i].axis;
					break;
				}
			}

			double dCurPos = 0.0;
			for (size_t i = 0; i < iAxis; i++)
			{
				dCurPos = GetOrgPos(pPos[i].axis);

				if (fabs(dCurPos - pPos[i].dPosition) > 0.001)
				{
					nRet = MOTION_MOVE_DONE_ALARM + pPos[i].axis;
					break;
				}
			}

			if (nRet != df_MOTION_RV_SUCCESSED)
			{
				long lRet = 0;
				nRet = MoveCmdPosMulti_Move(pPos, iAxis, iSpeed);
			//	nRet = m_pFunction->MoveCmdPosMulti(pPos, iAxis, iSpeed);
				if (nRet == 1)
				{
					nRet = df_MOTION_RV_SUCCESSED;
				}
				else if (nRet == -1)
				{
					nRet = MEI_NOT_CREATED;
				}
				else
				{
					nRet = MOTION_CMDPOS_ERROR; // MOTION_MOVE_ALARM + iAxis;
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					for (size_t i = 0; i < iAxis; i++)
					{
						if (m_pFunction->CheckMoveDone(pPos[i].axis, df_MOVINGDONE_TIME * 3) != true)
						{
							nRet = MOTION_MOVE_DONE_ALARM + pPos[i].axis;
							break;
						}
					}
				}
			}
		}
	}

	return nRet;
}

long CMotorControlMgr::MoveCmdPosMulti(stMotorPosition *pPos, int iAxis, int iSpeed, bool bDoneCheck)
{
	CString strLog;
	int nAxis = pPos[0].axis;
	strLog.Format(_T("MoveCmdPosM Start(AXIS:%s, POS:%.3f, nAXIS:%d, SPPED:%d)"), GetAxisMapProperty(nAxis)->m_strAxisName, pPos[0].dPosition, iAxis, iSpeed);
	m_pLogFileAccessor->KMLOG(SYST, strLog, true);

	long nRet = df_MOTION_RV_SUCCESSED;

	nRet = MoveCmdPosMulti_Sub(pPos, iAxis, iSpeed, bDoneCheck);

	if (nRet != 1)
	{
		// LYS 2026-07-20 Add for Debug (TEMP)
		int i = 1;
	}

	strLog.Format(_T("MoveCmdPosM End(AXIS:%s, POS:%.3f, nAXIS:%d, SPPED:%d, RET:%d)"), GetAxisMapProperty(nAxis)->m_strAxisName, pPos[0].dPosition, iAxis, iSpeed, nRet);
	m_pLogFileAccessor->KMLOG(SYST, strLog, true);
	
	return nRet;
}

