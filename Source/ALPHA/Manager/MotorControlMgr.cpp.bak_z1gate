long CMotorControlMgr::SetSpeedDirect_Sub(int iAxis, double dVel, double dAcc, double dDec, int iSpeedMode)
{
	CCriticalSectionSync single(&m_cs_Set, TRUE);

	long nRet = df_MOTION_RV_SUCCESSED;
	if (m_pFunction->IsConnected() != true)
	{
		return df_MOTION_RV_SUCCESSED;
	}

	nRet = m_pFunction->SetSpeedDirect(iAxis, dVel, dAcc, dDec, iSpeedMode);

	return nRet;
}

long CMotorControlMgr::SetSpeedDirect(int iAxis, double dVel, double dAcc, double dDec, int iSpeedMode)
{
	long nRet = df_MOTION_RV_SUCCESSED;
	
	nRet = SetSpeedDirect_Sub(iAxis, dVel, dAcc, dDec, iSpeedMode);

	CString strLog;
	strLog.Format(_T("SetSpeedDirect(AXIS:%d, Vel:%.1f, ACC:%.1f, DCC%.1f), Ret = %d"), iAxis, dVel, dAcc, dDec, nRet);
	m_pLogFileAccessor->KMLOG(SYST, strLog, true);

	return nRet;
}

