//Get parameter
double CMotorControlMgr::GetCurPos(int iAxis, int iLens, int iTube)
{
	double dRet = 0.;
	if (IsOutOfService() == true)
	{
		return m_dMovePos[iAxis] - m_dMoveOffset[iAxis];
	}

	CCriticalSectionSync single(&m_cs_Get, TRUE);

	dRet = m_pFunction->GetCurPos(iAxis, iLens, iTube);

	return dRet;
}

double CMotorControlMgr::GetOrgPos(int iAxis)
{
	double dRet = 0.;
	if (IsOutOfService() == true)
	{
		return m_dMovePos[iAxis];
	}

	dRet = m_pFunction->GetCurPos(iAxis, -1, -1);

	return dRet;
}

