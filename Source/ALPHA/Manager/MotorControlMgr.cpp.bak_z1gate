bool CMotorControlMgr::CheckMoveDone(int iAxis, DWORD dwTimeout)
{
	CCriticalSectionSync single(&m_cs_done, TRUE);

	if (IsOutOfService() == true)
	{
		return true;
	}
	
	return m_pFunction->CheckMoveDone(iAxis, dwTimeout);
}

