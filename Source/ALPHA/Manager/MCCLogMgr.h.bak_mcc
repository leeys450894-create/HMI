class CIniHelper;
class CMCCLogMgr
{
	CIniHelper*				m_pIniHelper;
	bool					m_bUse;				// 장치 사용여부, UI상에서도 보이지 않게 처리함. OutOfService와는 다름
	bool					m_bOutOfService;	// 모듈 사용 여부 0: USE
	VTM_MCC*				m_pSharedMCC;
	VTM_FOR_FDC*			m_pSharedFDC;
	HANDLE					m_hFDCMapFile;
	double*					m_pDFDCData;
	double*					m_pDFDCDataMax;
	double*					m_pDFDCDataMin;
	UINT					m_uMCCAMath[500];
	UINT					m_uMCCSMath[500];
	UINT					m_uLampTime[10];
	UINT					m_uLiftPinMoveTime[10];
	CString				    m_strVersion;
	bool					m_bIonizerRun;

	// LYS 2026-07-29 ELP ElecBox monitor data cache (written by PGMon socket receive thread)
	double					m_dDataToELP[MAIN_WDATA_ELP_BOX_MAX][MAIN_WDATA_ELP_ITEM_CNT];
	CCriticalSection		m_cs_ELP;

public:
	bool	IsOutOfService();
	void    Initialize(HWND hParentWnd, CRect rtROI, CString strAppName, CString strAppPath, CString strConfigPath, CString strLogPath, CString strVersion);
	CWnd*	GetReportmWnd();
	void	SetMccConvert();
	

//----------------------------------------------------------------------------------------------------
// Singleton
//----------------------------------------------------------------------------------------------------
private:
	static CMCCLogMgr* m_pInstance;
public:
	static CMCCLogMgr* GetInstance();
	static void		   DelInstance();

//------------------------------------------------------------------
// 공통 인터페이스 함수
//------------------------------------------------------------------
private:
	bool LinkIniFile(bool bSave);
	void Finalize();
	CMCCLogMgr(void);
	virtual ~CMCCLogMgr(void);
	int CreateMemoryMapFDC();


public:
	void SetMccMoterInfo(int iAxis, double dPos, double dSpeed);
	void SetMccMoterInfoCur(int iAxis, double dPos, double dSpeed, double dRMS);
	void UpdateSensor();
	bool GetFDCDValue(int iIndex, double *pdValue, double *pdMax, double *pdMin);
	void SetMCC_Action(int iSqNum, BOOL bStart, int nStep = 0, int nFromTo = 0);
	void SetMCC_Signal(int iSqNum, BOOL bStart, int nStep = 0, int nFromTo = 0);
	void SetMCC_Alarm(int iSqNum, BOOL bStart, int nStep = 0, int nFromTo = 0);
	void SetLampTime(int iLamp, int Time);
	void SetLiftPinMoveTime(int iStep, int Time);
	void SetIonizerRun(bool bRun);
	void SetDataToELP(int iBox, int iItem, double dData);	// LYS 2026-07-29 ELP ElecBox monitor
};

