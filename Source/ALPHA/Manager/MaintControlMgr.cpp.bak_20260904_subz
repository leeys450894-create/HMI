		nRet = MoveCmdPosMulti(stPositionY, nMoveY, SPEED_HIGH, false, true);
		
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_STEP_MEAS_N_MOVE_STEP4, true, 0);

			nRet = MoveCmdPosMulti(stPositionX, nMoveX, SPEED_HIGH, true, true);

			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_STEP_MEAS_N_MOVE_STEP4, false, 0);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// jsyoon 2022.04.18 change
			for (size_t i = 0; i < nAxis; i++)
			{
				axis = pPos[i].axis;
				nRet = DoWork_MotionDone(axis);
				if (nRet != df_MOTION_RV_SUCCESSED)
					break;
			}
		}

		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_STEP_MEAS_N_MOVE_STEP2, false, 0);
		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_STEP_MEAS_N_MOVE_STEP3, false, 0);
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Z2)
			{
				dPos = pPos[i].dPosition;

				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_STEP_MEAS_N_MOVE_STEP5, true, 0);

				nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);

				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_STEP_MEAS_N_MOVE_STEP5, false, 0);

				break;
			}
		}
	}

	return nRet;
}

long CMaintControlMgr::MoveCmdPosWAD(stMotorPosition* pPos, int nAxis, int iSpeed, bool bDoneCheck)
{
	// TODO: 여기에 구현 코드 추가.
	long nRet = df_MOTION_RV_SUCCESSED;

	double dGantryGap = 0;
	GetInterlockPos(&dGantryGap, nullptr, nullptr);

	double dOffsetX[4], dOffsetY[4], dOffsetZ[4];
	// jsyoon 2022.07.06 add
	ZeroMemory(&dOffsetX, sizeof(dOffsetX));
	ZeroMemory(&dOffsetY, sizeof(dOffsetY));
	ZeroMemory(&dOffsetZ, sizeof(dOffsetZ));

	for (size_t i = 0; i < 2; i++)
	{
		m_pPositionConfigMgr->GetHeadOffset(i, 0, &dOffsetX[i], &dOffsetY[i], &dOffsetZ[i]);			// WAD
	}

	//for (size_t i = 0; i < 2; i++)
	//{
	//	m_pPositionConfigMgr->GetHeadOffset(i, 2, &dOffsetX[i+2], &dOffsetY[i+2], &dOffsetZ[i+2]);		// Vision
	//}

	double dGlassOffsetX = 0., dGlassOffsetY = 0.;
	/*dGlassOffsetX = dGlassAlignOffset[0];	
	dGlassOffsetY = dGlassAlignOffset[1];*/
	
	int axis = 0;
	double dPos = 0.;

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Z1)
			{
				dPos = pPos[i].dPosition;
				if (dPos > 1.) // jsyoon 2022.09.30 add
				{
					dPos = 0.;
				}

				// LYS 2026-08-26 시퀀스 계층 Z1 하강 인터락. 안전높이(-600) 대비 하강이므로
				// X2가 P5 위치 안이면 WAD 모션 시작 전에 인터락
				if (dPos > GetOrgPos(AXIS_Z1) && m_pMotorControlMgr != nullptr
					&& m_pMotorControlMgr->IsProbeUnitOverlapX(GetOrgPos(AXIS_X2)) == true)
				{
					CString strLog;
					strLog.Format(_T("MoveCmdPosWAD Z1 DOWN NG - PROBE UNIT(X9:%.3f) vs BACK GANTRY(X2:%.3f), Z1 %.3f -> %.3f"),
						GetOrgPos(AXIS_PROBE_X9), GetOrgPos(AXIS_X2), GetOrgPos(AXIS_Z1), dPos);
					m_pMotorControlMgr->GetLogFileAccessorPtr()->KMLOG(WARN, strLog, true);

					nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_Z1;
					break;
				}

				nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);
				break;
			}
		}
	}

	stMotorPosition stPositionX[10];
	ZeroMemory(&stPositionX, sizeof(stPositionX));
	stMotorPosition stPositionY[10];
	ZeroMemory(&stPositionY, sizeof(stPositionY));
	int nMoveX = 0, nMoveY = 0;
	bool bSetMoveAxisX = false;
	double dMoveAxisX = 0.;

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Y1)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[0] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[0]);
			}
			else if (axis == AXIS_Y2)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[1] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[1]);
			}
			else if (axis == AXIS_Y3)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[2];
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[2]);
			}
			else if (axis == AXIS_Y4)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[3];
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[3]);
			}

			else if (axis == AXIS_X2)
			{
			//	dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X3;
				stPositionX[nMoveX].dPosition = m_pMotorControlMgr->GetMinSWLimit(AXIS_X2) - (dGantryGap + 50); //　dPos + dOffsetX[0] - dGantryGap;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X3, dOffsetX[0]);

				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGlassOffsetX;

				bSetMoveAxisX = true;
				dMoveAxisX = stPositionX[nMoveX].dPosition;

				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);
			}

			else if (axis == AXIS_X3)
			{
				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X2;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGantryGap;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X2, dOffsetX[0]);

				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGlassOffsetX;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);
			}
		}

		if (bSetMoveAxisX == true)
		{
			// LYS 2026-08-25 restored - the OCP gantry X moves now.
			if (GetCurPos(AXIS_PROBE_X9) > dMoveAxisX - 20)
			{
				nRet = MoveCmdPosA(AXIS_Z2, 0, true, SPEED_HIGH, -1, -1);
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if(nMoveX > 0)
				nRet = MoveCmdPosMulti(stPositionX, nMoveX, SPEED_HIGH, true, true);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			nRet = MoveCmdPosMulti(stPositionY, nMoveY, SPEED_HIGH, false, true);
		}	

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			for (size_t i = 0; i < nAxis; i++)
			{
				axis = pPos[i].axis;
				if (axis == AXIS_Z2)
				{
					dPos = pPos[i].dPosition + dOffsetZ[0];
					nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);
					break;
				}
			}
		} 

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// LYS 2026-08-28 Sub Z(Z3/Z4) - WAD(특성) 측정 전용, DoWork에서 넘어온 레시피 값 그대로 이동.
			stMotorPosition stPositionSubZ[2];
			ZeroMemory(&stPositionSubZ, sizeof(stPositionSubZ));
			int nMoveSubZ = 0;
			for (size_t i = 0; i < nAxis; i++)
			{
				if (pPos[i].axis == AXIS_Z3 || pPos[i].axis == AXIS_Z4)
				{
					stPositionSubZ[nMoveSubZ].axis = pPos[i].axis;
					stPositionSubZ[nMoveSubZ].dPosition = pPos[i].dPosition;
					nMoveSubZ++;
				}
			}
			if (nMoveSubZ > 0)
			{
				nRet = MoveCmdPosMulti(stPositionSubZ, nMoveSubZ, SPEED_HIGH, true, false);
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (bDoneCheck == true)
			{
				for (size_t i = 0; i < nAxis; i++)
				{
					axis = pPos[i].axis;
					nRet = DoWork_MotionDone(axis);
					if (nRet != df_MOTION_RV_SUCCESSED)
						break;
				}
			}
		}
	}

	return nRet;
}

long CMaintControlMgr::MoveCmdPosVision(stMotorPosition* pPos, int nAxis, int iSpeed, bool bDoneCheck)
{
	// TODO: 여기에 구현 코드 추가.
	long nRet = df_MOTION_RV_SUCCESSED;

	double dGantryGap = 0;
	GetInterlockPos(&dGantryGap, nullptr, nullptr);

	double dOffsetX[4], dOffsetY[4], dOffsetZ[4];
	// jsyoon 2022.07.06 add
	ZeroMemory(&dOffsetX, sizeof(dOffsetX));
	ZeroMemory(&dOffsetY, sizeof(dOffsetY));
	ZeroMemory(&dOffsetZ, sizeof(dOffsetZ));

	for (size_t i = 0; i < 2; i++)
	{
		m_pPositionConfigMgr->GetHeadOffset(i, 2, &dOffsetX[i], &dOffsetY[i], &dOffsetZ[i]);				// Vision
	}

	for (size_t i = 0; i < 2; i++)
	{
		m_pPositionConfigMgr->GetHeadOffset(i, 1, &dOffsetX[i + 2], &dOffsetY[i + 2], &dOffsetZ[i + 2]);	// Angle	
	}

	double dGlassOffsetX = 0., dGlassOffsetY = 0.;
	//dGlassOffsetX = dGlassAlignOffset[0];
	//dGlassOffsetY = dGlassAlignOffset[1];

	int axis = 0;
	double dPos = 0., dPosbf = 0.;

	if (GetCurPos(AXIS_Z2) > 0.1)
	{
		nRet = MoveCmdPosA(AXIS_Z2, dPos, true, SPEED_HIGH, -1, -1);
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Z2)
			{
				dPos = pPos[i].dPosition;
				nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);
				break;
			}
		}
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		// LYS 2026-08-28 Sub Z(Z5/Z6) - VISION/ANGLE(화질/시야각) 측정 공용, DoWork에서 넘어온 레시피 값 그대로 이동.
		stMotorPosition stPositionSubZ[2];
		ZeroMemory(&stPositionSubZ, sizeof(stPositionSubZ));
		int nMoveSubZ = 0;
		for (size_t i = 0; i < nAxis; i++)
		{
			if (pPos[i].axis == AXIS_Z5 || pPos[i].axis == AXIS_Z6)
			{
				stPositionSubZ[nMoveSubZ].axis = pPos[i].axis;
				stPositionSubZ[nMoveSubZ].dPosition = pPos[i].dPosition;
				nMoveSubZ++;
			}
		}
		if (nMoveSubZ > 0)
		{
			nRet = MoveCmdPosMulti(stPositionSubZ, nMoveSubZ, SPEED_HIGH, true, false);
		}
	}

	stMotorPosition stPositionX[10];
	ZeroMemory(&stPositionX, sizeof(stPositionX));
	stMotorPosition stPositionY[10];
	ZeroMemory(&stPositionY, sizeof(stPositionY));
	int nMoveX = 0, nMoveY = 0;

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Y3)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[0] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[0]);
			}
			else if (axis == AXIS_Y4)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[1] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[1]);
			}
			else if (axis == AXIS_Y1)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;

				dPosbf = dPos + dOffsetY[2];

				if (dPosbf > GetMaxSWLimit(axis) )
				{
					stPositionY[nMoveY].dPosition = GetMaxSWLimit(axis) - 1;
					nMoveY++;

					m_pMotorControlMgr->SetHeadOffset(axis, 0);
				}
				else if (dPosbf < GetMinSWLimit(axis))
				{
					stPositionY[nMoveY].dPosition = GetMinSWLimit(axis) + 1;
					nMoveY++;

					m_pMotorControlMgr->SetHeadOffset(axis, 0);
				}
				else
				{
					stPositionY[nMoveY].dPosition = dPosbf;
					nMoveY++;

					m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[2]);
				}
				
			}
			else if (axis == AXIS_Y2)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;


				dPosbf = dPos + dOffsetY[3];

				if (dPosbf > GetMaxSWLimit(axis))
				{
					stPositionY[nMoveY].dPosition = GetMaxSWLimit(axis) - 1;
					nMoveY++;

					m_pMotorControlMgr->SetHeadOffset(axis, 0);
				}
				else if (dPosbf < GetMinSWLimit(axis))
				{
					stPositionY[nMoveY].dPosition = GetMinSWLimit(axis) + 1;
					nMoveY++;

					m_pMotorControlMgr->SetHeadOffset(axis, 0);
				}
				else
				{
					stPositionY[nMoveY].dPosition = dPosbf;
					nMoveY++;

					m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[3]);
				}

				/*stPositionY[nMoveY].dPosition = dPos + dOffsetY[3];
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[3]);*/
			}

			else if (axis == AXIS_X2)
			{
				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGlassOffsetX;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);

				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X3;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] - dGantryGap;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X3, dOffsetX[0]);
			}

			else if (axis == AXIS_X3)
			{
				//stPositionX[nMoveX].axis = AXIS_X2;
				//stPositionX[nMoveX].dPosition = m_pMotorControlMgr->GetMaxSWLimit(AXIS_X2) - 0.5;  // dPos + dOffsetX[0] + dGlassOffsetX + dGantryGap;
				//nMoveX++;
				//
				//m_pMotorControlMgr->SetHeadOffset(AXIS_X2, dOffsetX[0]);
				//
				//dPos = pPos[i].dPosition;
				//stPositionX[nMoveX].axis = axis;
				//stPositionX[nMoveX].dPosition = dPos + dOffsetX[0];
				//nMoveX++;
				//
				//m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);

				// LYS 2026-06-30
				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X2;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGantryGap;
				nMoveX++;
				
				m_pMotorControlMgr->SetHeadOffset(AXIS_X2, dOffsetX[0]);
				
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGlassOffsetX;
				nMoveX++;
				
				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);

			}
			else if (axis == AXIS_ZOOM1 || axis == AXIS_THETA1 || axis == AXIS_ZOOM2 || axis == AXIS_THETA2 ) 
			{
				dPos = pPos[i].dPosition;

				MoveCmdPosA(axis, dPos, false);
			}
		}


		bool bFirstMoveX2 = false;
		// Move X First
		if (nMoveX > 0)
		{
			if (stPositionX[0].axis == AXIS_X2)
			{
				if (m_pMotorControlMgr->GetOrgPos(AXIS_X2) < stPositionX[0].dPosition)	// LYS 2026-08-06 raw pos: SetHeadOffset above shifts GetCurPos, interlock compares raw
				{
					nRet = MoveCmdPosA(stPositionX[0].axis, stPositionX[0].dPosition, false);

					bFirstMoveX2 = true;
				}
				else
				{
					nRet = MoveCmdPosA(stPositionX[1].axis, stPositionX[1].dPosition, false);
				}
			}
		}
		
		// Move Y
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			nRet = MoveCmdPosMulti(stPositionY, nMoveY, SPEED_HIGH, false, true);
		}

		// Move X First Check
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// Retry
			if (nMoveX > 0)
			{
				if (bFirstMoveX2 == true)		// X2 
				{
					nRet = DoWork_MotionDone(stPositionX[0].axis);

					if (nRet == df_MOTION_RV_SUCCESSED)
					{
						if (fabs(GetCurPos(stPositionX[0].axis) - stPositionX[0].dPosition) > 0.01)
						{
							nRet = MoveCmdPosA(stPositionX[0].axis, stPositionX[0].dPosition, true);
						}
					}
				}
				else
				{
					nRet = DoWork_MotionDone(stPositionX[1].axis);

					if (nRet == df_MOTION_RV_SUCCESSED)
					{
						if (fabs(GetCurPos(stPositionX[1].axis) - stPositionX[1].dPosition) > 0.01)
						{
							nRet = MoveCmdPosA(stPositionX[1].axis, stPositionX[1].dPosition, true);
						}
					}
				}
			}	
		}

		// Move X Second
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (nMoveX > 0)
			{
				if (bFirstMoveX2 == true)
				{
					nRet = MoveCmdPosA(stPositionX[1].axis, stPositionX[1].dPosition, true);
				}
				else
				{
					nRet = MoveCmdPosA(stPositionX[0].axis, stPositionX[0].dPosition, true);
				}
			}
		}

		// LYS 2026-08-26 Z1(BACK Z) 이동 제거. Vision은 FRONT 갠트리(X3) 기반이라 Z1 불필요.


		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (bDoneCheck == true)
			{
				// jsyoon 2022.04.18 change
				for (size_t i = 0; i < nAxis; i++)
				{
					axis = pPos[i].axis;
					nRet = DoWork_MotionDone(axis);
					if (nRet != df_MOTION_RV_SUCCESSED)
						break;
				}
			}
		}
	}

	return nRet;
}

