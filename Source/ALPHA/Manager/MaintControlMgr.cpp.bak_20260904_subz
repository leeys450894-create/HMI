long CMaintControlMgr::Do_ShutterOnOff()
{
	int nRet = PLC_VACUUM_SENSOR_ERROR;
	bool bRet = false;
	bool bClose = false;
	int nType = 0;

	bClose = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_SUTTER_SENSOR_CLOSE);
	if (bClose == true)
	{
		nType = 0;
		bRet = GetIOMapControlMgrPtr()->SetMemoryNBitToDevice(PLC_BIT_W_SUTTER_CLOSE_MOVE, 2, 2);

		nRet = PLC_LOADER_SHUTTER_DOWN_ERROR;
	}
	else
	{
		nType = 1;
		bRet = GetIOMapControlMgrPtr()->SetMemoryNBitToDevice(PLC_BIT_W_SUTTER_CLOSE_MOVE, 1, 2);

		nRet = PLC_LOADER_SHUTTER_UP_ERROR;
	}

	if (bRet == true)
	{
		ULONGLONG  dwS, dwR, dwT = 0;

		for (dwS = GetTickCount(); dwT < PLC_IO_ACTION_DONE_TIME_60 * 1000;)
		{
			Sleep(100);

			
			if (nType == 0)
				bRet = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_SUTTER_SENSOR_OPEN);
			else
				bRet = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_SUTTER_SENSOR_CLOSE);
			
			if (bRet == true)
			{
				nRet = VTM_RV_SUCCESSED;
;				break;
			}

			dwR = GetTickCount();

			if (dwR >= dwS)
				dwT = dwR - dwS;
			else
				dwT = ((DWORD)0xFFFFFFFF) - (dwS - dwR);
		}
	}

	GetIOMapControlMgrPtr()->SetMemoryNBitToDevice(PLC_BIT_W_SUTTER_CLOSE_MOVE, 0, 2);

	return nRet;
}

