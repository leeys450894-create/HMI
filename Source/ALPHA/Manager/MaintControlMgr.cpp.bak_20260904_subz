long CMaintControlMgr::MoveCmdPosAging(stMotorPosition* pPos, int nAxis, int iSpeed, bool bDoneCheck)
{
	// TODO: 여기에 구현 코드 추가.
	long nRet = df_MOTION_RV_SUCCESSED;

	double dGantryGap = 0;
	GetInterlockPos(&dGantryGap, nullptr, nullptr);

	double dOffsetX = 0., dOffsetY = 0.;

	int axis = 0;
	double dPos = 0.;
	for (size_t i = 0; i < nAxis; i++)
	{
		axis = pPos[i].axis;
		if (axis == AXIS_Z1)
		{
			dPos = pPos[i].dPosition;
			if (dPos > 1.)	// jsyoon 2022.09.30 add
			{
				dPos = 0.;
			}

			// LYS 2026-08-26 WAD와 동일한 시퀀스 계층 Z1 하강 인터락.
			// X2가 P5 위치 안이면 모션 시작 전에 인터락 (A_Sub 검사는 백스톱).
			if (dPos > GetOrgPos(AXIS_Z1) && m_pMotorControlMgr != nullptr
				&& m_pMotorControlMgr->IsProbeUnitOverlapX(GetOrgPos(AXIS_X2)) == true)
			{
				CString strLog;
				strLog.Format(_T("MoveCmdPosAging Z1 DOWN NG - PROBE UNIT(X9:%.3f) vs BACK GANTRY(X2:%.3f), Z1 %.3f -> %.3f"),
					GetOrgPos(AXIS_PROBE_X9), GetOrgPos(AXIS_X2), GetOrgPos(AXIS_Z1), dPos);
				m_pMotorControlMgr->GetLogFileAccessorPtr()->KMLOG(WARN, strLog, true);

				nRet = MOTION_INTERLOCK_CHECK_ALARM + AXIS_PROBE_X9;
				break;
			}

			nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);
			break;
		}
	}

	// jsyoon 2022.04.18 add 
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Z2)
			{
				if (GetCurPos(axis) > 0)
				{
					nRet = MoveCmdPosA(axis, 0, true, SPEED_HIGH);
					break;
				}
			}
		}
	}

	stMotorPosition stPositionX[10];
	ZeroMemory(&stPositionX, sizeof(stPositionX));
	stMotorPosition stPositionY[10];
	ZeroMemory(&stPositionY, sizeof(stPositionY));
	int nMoveX = 0, nMoveY = 0;
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Y1)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, 0);
			}
			else if (axis == AXIS_Y2)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, 0);
			}
			else if (axis == AXIS_Y3)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, 0);
			}
			else if (axis == AXIS_Y4)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, 0);
			}

			else if (axis == AXIS_X2)
			{
			//	dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X3;
				stPositionX[nMoveX].dPosition = m_pMotorControlMgr->GetMinSWLimit(AXIS_X2) - (dGantryGap + 50);
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X3, 0);

				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, 0);
			}

			else if (axis == AXIS_X3)
			{
				stPositionX[nMoveX].axis = AXIS_X2;
				stPositionX[nMoveX].dPosition = m_pMotorControlMgr->GetMaxSWLimit(AXIS_X2) - 20; // dPos + dOffsetX + dGantryGap;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X2, 0);

				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, 0);
			}
		}

		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP1, true);
		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP2, true);

		nRet = MoveCmdPosMulti(stPositionY, nMoveY, SPEED_HIGH, false, true);

		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP3, true);
		
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			nRet = MoveCmdPosMulti(stPositionX, nMoveX, SPEED_HIGH, false, true);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// jsyoon 2022.04.18 change
			for (size_t i = 0; i < nAxis; i++)
			{
				axis = pPos[i].axis;
				nRet = DoWork_MotionDone(axis);
				if (nRet != df_MOTION_RV_SUCCESSED)
					break;
			}
		}

		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP1, false);
		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP2, false);
		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP3, false);
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{		
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Z2)
			{
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP4, true);

				dPos = pPos[i].dPosition;
				nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);

				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_MEAS_CONTACT_MOVE_HEAD_STEP4, false);
				break;
			}
		}
	}

	return nRet;
}


