		nRet = MoveCmdPosMulti(stPositionProbeZ, 5, iSpeed, true);
	}
	else
	{
		dMove = dMoveZ;

		switch (nAxis)
		{
		case AXIS_PROBE_Z1:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true, iSpeed);
		}
		break;
		case AXIS_PROBE_Z2:
