long CMaintControlMgr::MoveCmdPos_ProbeContactAging(int nCount, double fContatZ, double EContatZ, double dOD)
{
	// LYS 2026-06-26 OCP: no AGING probes, skip entirely
	if (m_pMotorControlMgr->IsOCP()) return df_MOTION_RV_SUCCESSED;

	int nRet = df_MOTION_RV_SUCCESSED;

	double dMove = 0;
	dMove = fContatZ;
	int nUseProbe = nCount;

	// Probe Z Move
	stMotorPosition stPositionProbeZ[4];
	ZeroMemory(&stPositionProbeZ, sizeof(stPositionProbeZ));
	stPositionProbeZ[0].axis = AXIS_PROBE_Z4;
	stPositionProbeZ[0].dPosition = dMove;
	stPositionProbeZ[1].axis = AXIS_PROBE_Z3;
	stPositionProbeZ[1].dPosition = dMove;
	stPositionProbeZ[2].axis = AXIS_PROBE_Z2;
	stPositionProbeZ[2].dPosition = dMove;
	stPositionProbeZ[3].axis = AXIS_PROBE_Z1;
	stPositionProbeZ[3].dPosition = dMove;

	nRet = MoveCmdPosMulti(stPositionProbeZ, nUseProbe, SPEED_HIGH, true);

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		dMove = EContatZ + dOD;

		stPositionProbeZ[0].dPosition = dMove;
		stPositionProbeZ[1].dPosition = dMove;
		stPositionProbeZ[2].dPosition = dMove;
		stPositionProbeZ[3].dPosition = dMove;

		nRet = MoveCmdPosMulti(stPositionProbeZ, nUseProbe, SPEED_LOW, true);
	}

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < 4; i++)
		{
			if (i > nCount)
				continue;

			if (CSACCMgr::GetInstance() != nullptr)
			{
				CString strProbeID, strProbeMountTime;
				strProbeID.Format(_T("%s"), GetShareMemoryMgrPtr()->GetSharedMemory()->m_szPROBEID[i]);
				if (strProbeID.IsEmpty() != true)
				{
					GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[i].m_nUseCnt++;

					strProbeMountTime.Format(_T("%s"), GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[i].m_szProbeCardIDTime);
					CSACCMgr::GetInstance()->Probe_ContactCount(i, strProbeID, strProbeMountTime, GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[i].m_nUseCnt);
				}

			}
		}
	}
	
	return nRet;
}

// 2022.12.21 add Probe Exist count
int  CMaintControlMgr::Get_ProbeExist()
{
	int nRet = 0;
	for (int iProbe = df_PROBE_AGING1; iProbe <= df_PROBE_MEAS; iProbe++)
	{
		// Probe exist check
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeExistSensorOn(iProbe) == true)
		{
			nRet++;
		}
	}

	return nRet;
}
