			{
				i = 2;
		//		GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[2].m_nUseCnt++;
			}
		}
			break;
		case AXIS_PROBE_Z4:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				dMove = EContatZ + dOD;
				nRet = MoveCmdPosA(nAxis, dMove, true, SPEED_LOW);
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				i = 3;
		//		GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[3].m_nUseCnt++;
			}
		}
			break;
		case AXIS_PROBE_Z5:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				dMove = EContatZ + dOD;
				nRet = MoveCmdPosA(nAxis, dMove, true, SPEED_LOW);
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				i = 4;
		//		GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[4].m_nUseCnt++;
			}
		}
			break;
		default:
			break;
		}

		if (i >= 0)
		{
			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				if (CSACCMgr::GetInstance() != nullptr)
				{
					CString strProbeID, strProbeMountTime;
					strProbeID.Format(_T("%s"), GetShareMemoryMgrPtr()->GetSharedMemory()->m_szPROBEID[i]);

					if (strProbeID.IsEmpty() != true)
					{
						GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[i].m_nUseCnt++;

						strProbeMountTime.Format(_T("%s"), GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[i].m_szProbeCardIDTime);
						CSACCMgr::GetInstance()->Probe_ContactCount(i, strProbeID, strProbeMountTime, GetShareMemoryMgrPtr()->GetSharedMemory()->stProbeInfo[i].m_nUseCnt);
					}
				}
			}
		}
	}
		
	return nRet;
}

