long CMaintControlMgr::MoveOrgPosA(int iAxis, double dPos, bool bBlockMode, int iSpeed, int iLens, int iTube)
{
	// TODO: 여기에 구현 코드 추가.
	long nRet = df_MOTION_RV_ERROR;

	int nAlarm = 0; // CAlarmController::GetInstance()->GetAlarmCount();
	if (nAlarm > 0)
	{
		nRet = MOTION_MOVE_ALARM;
	}
	else
	{
		if (m_pMotorControlMgr != nullptr)
		{
			if (m_pMotorControlMgr->GetAxisProperty(iAxis)->bUse == TRUE)
			{
				if (m_pIOMapControlMgr != nullptr)
				{
					nRet = m_pIOMapControlMgr->GetMoveInterlock();
				}

				if (nRet == VTM_RV_SUCCESSED)
				{
					if (GetIOMapControlMgrPtr()->IsOutOfService() != true)
					{
						int nBit = 0;
						if (iAxis != AXIS_LOADER_Z)
						{
							nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_DOWN01);
							if (nBit != -1)
							{
								if (nBit != 1)
								{
									nRet = MOTION_INTERLOCK_1;
								}
							}
						}

						if (nRet == VTM_RV_SUCCESSED)
						{
							if (iAxis == AXIS_X || iAxis == AXIS_R)
							{
								nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTO_CHANGE_X0_POSITION_04);
								if (nBit != -1)
								{
									if (nBit != 1)
									{
										nRet = MOTION_INTERLOCK_9;
									}
								}
							}
							else if (iAxis == AXIS_X4 || iAxis == AXIS_LOADER_Z || iAxis == AXIS_Z9)
							{
								nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_UNLOAD_SENSOR03);
								if (nBit != -1)
								{
									if (nBit != 1)
									{
										nRet = MOTION_INTERLOCK_9;
									}
								}
							}
							// jsyoon 2022.06.09 add
							else if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X9)
							{
								nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTOCHANGE_DOWN_01);
								if (nBit != -1)
								{
									if (nBit != 1)
									{
										nRet = MOTION_INTERLOCK_9;
									}
								}
							}
						}
					}
				}

				if (nRet == VTM_RV_SUCCESSED)
				{
					double dMovePos = 0.;
					
					if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X9)
					{
						dMovePos = dPos + m_dAlignOffset[iAxis];
					}
					else if (iAxis == AXIS_PROBE_Y1 || iAxis == AXIS_PROBE_Y2 || iAxis == AXIS_PROBE_Y3 || iAxis == AXIS_PROBE_Y4 || iAxis == AXIS_PROBE_Y5)
					{
						dMovePos = dPos + m_dAlignOffset[iAxis];
					}
					else
					{
						dMovePos = dPos;
					}

					if (m_pMotorControlMgr != nullptr)
					{
						m_pMotorControlMgr->SetHeadOffset(iAxis, 0);

						nRet = m_pMotorControlMgr->MoveCmdPosA(iAxis, dMovePos, bBlockMode, iSpeed, iLens, iTube);
					}
				}
				else
				{
					CString strLog;
					strLog.Format(_T("MoveOrgPosA Fail(AXIS:%d, POS:%.3f, RET:%d)"), iAxis, dPos, nRet);
					m_pMotorControlMgr->GetLogFileAccessorPtr()->KMLOG(WARN, strLog, true);
				}
			}
		}
	}

	return nRet;
}


