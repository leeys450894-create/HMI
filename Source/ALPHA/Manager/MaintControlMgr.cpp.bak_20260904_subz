long CMaintControlMgr::MoveCmdPos_Head(double* pPos, int nType, int nSelect)
{
	int nRet = df_MOTION_RV_SUCCESSED;

#pragma region
	stMotorPosition stPosition[10];
	ZeroMemory(&stPosition, sizeof(stPosition));
	int nAxis = 0;


	double dHeadGap = 0;

	/*!
	* 2023.03.08 change 
	* GetInterlockPos(nullptr, &dHeadGap, nullptr);
	*/
	if(nType == M_TYPE_QUALITY || nType == M_TYPE_ANGLE)
		GetInterlockPos(nullptr, &dHeadGap, nullptr);
	else
		GetInterlockPos(nullptr, nullptr, nullptr, &dHeadGap);

	double dPos[10];
	ZeroMemory(&dPos, sizeof(dPos));

	dPos[0] = pPos[0];
	dPos[3] = pPos[2];

	double dReviewLeft = 0, dReviewRight = 0, dReviewToCellCenter = 0;
	dReviewToCellCenter = pPos[3];
	dReviewLeft = pPos[4];
	dReviewRight = pPos[5];

//	dReviewToCellCenter = 80.8;
	bool b2ShotMode = false;
	bool bDirLtoR = true;

	if (GetMaxSWLimit(AXIS_Y4) < GetMaxSWLimit(AXIS_Y3) )
	{
		bDirLtoR = false;
	}

	if (pPos[6] > 0)
	{
		b2ShotMode = true;
		// 
		if (bDirLtoR == true)
		{
			dPos[1] = pPos[7];
			dPos[2] = pPos[8];
		}
		else
		{
			dPos[1] = pPos[8];
			dPos[2] = pPos[7];
		}
	}
	else
	{
		switch (nSelect)
		{
		case M_HEAD_RIGHT:
			dPos[1] = pPos[1];
			dPos[2] = pPos[1] - dHeadGap;
			break;
		case M_HEAD_LEFT:
			dPos[1] = pPos[1] + dHeadGap;
			dPos[2] = pPos[1];
			break;
		default:
			break;
		}
	}

	bool bMoveY1 = true, bMoveY2 = true;

	// jsyoon 2022.09.20
	double dOffsetX[4], dOffsetY[4], dOffsetZ[4];
	ZeroMemory(&dOffsetX, sizeof(dOffsetX));
	ZeroMemory(&dOffsetY, sizeof(dOffsetY));
	ZeroMemory(&dOffsetZ, sizeof(dOffsetZ));

#pragma endregion

#pragma region
	switch (nType)
	{
	case M_TYPE_REVIEW:
	{
		double dCurPos = 0;
		if (nSelect == M_HEAD_RIGHT)
		{
			dCurPos = GetCurPos(AXIS_Y2);
			//if (fabs(dPos[1] - dCurPos) > dHeadGap)
			if (fabs(dPos[1] + dReviewRight - dCurPos) > dHeadGap)
			{
				dPos[2] = dCurPos;
				bMoveY2 = false;
			}
		}
		else
		{
			dCurPos = GetCurPos(AXIS_Y1);
			//if (fabs(dPos[2] - dCurPos) > dHeadGap)
			if (fabs(dPos[2] + dReviewLeft - dCurPos) > dHeadGap)
			{
				dPos[1] = dCurPos;
				bMoveY1 = false;
			}
		}
	}
	break;
	case M_TYPE_SPEC:
	{
		for (size_t i = 0; i < 2; i++)
		{
			m_pPositionConfigMgr->GetHeadOffset(i, 0, &dOffsetX[i], &dOffsetY[i], &dOffsetZ[i]);				// WAD
		}

		double dCurPos = 0;
		if (nSelect == M_HEAD_RIGHT)
		{
			dCurPos = GetCurPos(AXIS_Y2);
			if (fabs((dPos[1] + dOffsetY[0]) - dCurPos) > dHeadGap)
			{
				dPos[2] = dCurPos;
				bMoveY2 = false;
			}
		}
		else
		{
			dCurPos = GetCurPos(AXIS_Y1);
			if (fabs((dPos[2] + dOffsetY[1]) - dCurPos) > dHeadGap)
			{
				dPos[1] = dCurPos;
				bMoveY1 = false;
			}
		}
	}
	break;
	case M_TYPE_ANGLE:
	{
		for (size_t i = 0; i < 2; i++)
		{
			m_pPositionConfigMgr->GetHeadOffset(i, 1, &dOffsetX[i], &dOffsetY[i], &dOffsetZ[i]);				// angle
		}

		double dCurPos = 0;
		if (nSelect == M_HEAD_RIGHT)
		{
			dCurPos = GetCurPos(AXIS_Y4);
			if (fabs(( dPos[1] + dOffsetY[0]) - dCurPos) > dHeadGap)
			{
				dPos[2] = dCurPos;
				bMoveY2 = false;
			}
		}
		else
		{
			dCurPos = GetCurPos(AXIS_Y3);
			if (fabs((dPos[2] + dOffsetY[1]) - dCurPos) > dHeadGap)
			{
				dPos[1] = dCurPos;
				bMoveY1 = false;
			}
		}
	}
	break;
	case M_TYPE_QUALITY:
	{
		for (size_t i = 0; i < 2; i++)
		{
			m_pPositionConfigMgr->GetHeadOffset(i, 2, &dOffsetX[i], &dOffsetY[i], &dOffsetZ[i]);				// Vision
		}

		double dCurPos = 0;

		if (b2ShotMode == true)
		{
			;
		}
		else
		{
			if (nSelect == M_HEAD_RIGHT)
			{
				dCurPos = GetCurPos(AXIS_Y4);
				if (fabs((dPos[1] + dOffsetY[0]) - dCurPos) > dHeadGap)
				{
					dPos[2] = dCurPos;
					bMoveY2 = false;
				}
			}
			else
			{
				dCurPos = GetCurPos(AXIS_Y3);
				if (fabs((dPos[2] + dOffsetY[1]) - dCurPos) > dHeadGap)
				{
					dPos[1] = dCurPos;
					bMoveY1 = false;
				}
			}
		}
		
	}
	break;

#pragma endregion
	case M_TYPE_COLOR:
	{
		for (size_t i = 0; i < 2; i++)
		{
			m_pPositionConfigMgr->GetHeadOffset(i, 3, &dOffsetX[i], &dOffsetY[i], &dOffsetZ[i]);				// Color
		}

		double dCurPos = 0;
		if (b2ShotMode == true)		// 2023.04.17 add
		{
			;
		}
		else
		{
			if (nSelect == M_HEAD_RIGHT)
			{
				dCurPos = GetCurPos(AXIS_Y4);
				if (fabs((dPos[1] + dOffsetY[0]) - dCurPos) > dHeadGap)
				{
					dPos[2] = dCurPos;
					bMoveY2 = false;
				}
			}
			else
			{
				dCurPos = GetCurPos(AXIS_Y3);
				if (fabs((dPos[2] + dOffsetY[1]) - dCurPos) > dHeadGap)
				{
					dPos[1] = dCurPos;
					bMoveY1 = false;
				}
			}
		}
	}
		break;
	}


	switch (nType)
	{
	case M_TYPE_REVIEW:
	{
		stPosition[nAxis].axis = AXIS_X2;
		stPosition[nAxis].dPosition = dPos[0];	nAxis++;

		if (bMoveY1 == true)
		{
			stPosition[nAxis].axis = AXIS_Y1;
			stPosition[nAxis].dPosition = dPos[1]+ dReviewRight;	nAxis++;
		}
		
		if (bMoveY2 == true)
		{
			stPosition[nAxis].axis = AXIS_Y2;
			stPosition[nAxis].dPosition = dPos[2] + dReviewLeft;	 nAxis++;
		}
		
		stPosition[nAxis].axis = AXIS_Z2;
		stPosition[nAxis].dPosition = dPos[3];	 nAxis++;

		nRet = MoveCmdPosReview(0, stPosition, nAxis, SPEED_HIGH);
	}
	break;
	case M_TYPE_SPEC:
	{
		stPosition[nAxis].axis = AXIS_X2;
		stPosition[nAxis].dPosition = dPos[0]+dReviewToCellCenter;	nAxis++;

		if (bMoveY1 == true)
		{
			stPosition[nAxis].axis = AXIS_Y1;
			stPosition[nAxis].dPosition = dPos[1];	nAxis++;
		}
		
		if (bMoveY2 == true)
		{
			stPosition[nAxis].axis = AXIS_Y2;
			stPosition[nAxis].dPosition = dPos[2];	 nAxis++;
		}
		
		stPosition[nAxis].axis = AXIS_Z2;
		stPosition[nAxis].dPosition = dPos[3];	 nAxis++;

		if (GetCurPos(AXIS_Z1) > -100)
		{
			stPosition[nAxis].axis = AXIS_Z1;
			stPosition[nAxis].dPosition = -100.;		nAxis++;
		}

		nRet = MoveCmdPosWAD(stPosition, nAxis, SPEED_HIGH);
	}
	break;
	case M_TYPE_QUALITY:
	{
		stPosition[nAxis].axis = AXIS_X3;
		stPosition[nAxis].dPosition = dPos[0] + dReviewToCellCenter;	nAxis++;

		if (bMoveY1 == true)
		{
			stPosition[nAxis].axis = AXIS_Y3;
			stPosition[nAxis].dPosition = dPos[1];	nAxis++;
		}

		if (bMoveY2 == true)
		{
			stPosition[nAxis].axis = AXIS_Y4;
			stPosition[nAxis].dPosition = dPos[2];	 nAxis++;
		}
		
		stPosition[nAxis].axis = AXIS_Z1;
		stPosition[nAxis].dPosition = dPos[3];	 nAxis++;

		if (GetCurPos(AXIS_Z2) > 0)
		{
			stPosition[nAxis].axis = AXIS_Z2;
			stPosition[nAxis].dPosition = 0.;		nAxis++;
		}

		nRet = MoveCmdPosVision(stPosition, nAxis, SPEED_HIGH);
	}
	break;
	case M_TYPE_COLOR:
	{
		stPosition[nAxis].axis = AXIS_X3;
		stPosition[nAxis].dPosition = dPos[0] + dReviewToCellCenter;	nAxis++;

		if (bMoveY1 == true)
		{
			stPosition[nAxis].axis = AXIS_Y3;
			stPosition[nAxis].dPosition = dPos[1];	nAxis++;
		}
		
		if (bMoveY2 == true)
		{
			stPosition[nAxis].axis = AXIS_Y4;
			stPosition[nAxis].dPosition = dPos[2];	 nAxis++;
