int CMaintControlMgr::WaitForLiftPinPosComplete(bool bUp, UINT nTimeOut)
{
	// TODO: 여기에 구현 코드 추가.

	if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
		return VTM_RV_SUCCESSED;

	DWORD  dwS, dwR, dwT = 0;
	int nRtn = PLC_LIFTPIN_UP_POS_ERROR;
	for (dwS = GetTickCount(); dwT < nTimeOut *1000;)	// jsyoon 2022.08.16 add * 1000
	{
		if (bUp == true)
		{
			nRtn = PLC_LIFTPIN_UP_POS_ERROR;

			if (GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_UP01) == true && GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_DOWN01) != true)
			{
				nRtn = VTM_RV_SUCCESSED;
				break;
			}
		}
		else
		{
			nRtn = PLC_LIFTPIN_DOWN_POS_ERROR;

			if (GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_UP01) != true && GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_DOWN01) == true)
			{
				nRtn = VTM_RV_SUCCESSED;
				break;
			}
		}

		Sleep(10);  // jsyoon 20210601 change 100 to 10

		dwR = GetTickCount();

		if (dwR >= dwS)
			dwT = dwR - dwS;
		else
			dwT = ((DWORD)0xFFFFFFFF) - (dwS - dwR);
	}

	return nRtn;
}


