long CMaintControlMgr::DoWork_LPPreMove()
{
	// TODO: 여기에 구현 코드 추가.

	// Glass Exist Check
	bool bUp = true;
	int nBit = 0;
	bool bGlassExist = false;
	bool bGlassSensorOff = true;
	// jsyoon 2022.05.26 add
	int nLoop = 0;  
	do
	{
		nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitExport(PLC_BIT_W_GLASS_SENSOR_POWER_ON);
		if (nBit != -1)
		{
			if (nBit == 1)
			{
				GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_W_GLASS_SENSOR_POWER_ON, false);

				Sleep(1000);
			}
			else
			{
				bGlassSensorOff = false;
				break;
			}
		}
		else
		{
			break;
		}

		nLoop++;

	} while (nLoop < 3);

	if (bGlassSensorOff == true)
	{
		return PLC_GLASS_EXIST_SENSOR_ERROR;
	}

	DWORD dTactStart, dTactEnd, dTactTime;
	dTactStart = GetTickCount();

	bool bRet = false;
	int nRet = VTM_RV_SUCCESSED;
	int iAxis = AXIS_LOADER_Z, iSpeed = SPEED_HIGH, nStep = -1;
	double dPos = 0.0, dCurPos = 0;
	double dLifePinPos[df_POS_MAX];
	ZeroMemory(dLifePinPos, sizeof(dLifePinPos));
	m_pPositionConfigMgr->GetLoaderZPossition(&dLifePinPos[df_POS_UP], &dLifePinPos[df_POS_MIDDLE], &dLifePinPos[df_POS_PRE], &dLifePinPos[df_POS_DOWN]);

	for (size_t i = 0; i < 4; i++)
	{
		nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_GLASS_EXIST_01 + i);
		if (nBit != -1)
		{
			if (nBit == 1)
			{
				bGlassExist = true;
				break;
			}
		}
	}

	if (bGlassExist == true)
	{
		bool bVacOn = false;
		for (int iVac = 0; iVac < 5; iVac++)
		{
			nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_VACCUM_PLATE01 + iVac);
			if (nBit != -1)
			{
				if (nBit == 1)
				{
					bVacOn = true;
					break;
				}
			}
		}

		if (bVacOn == true)
		{
			CString strTactTime, strLog;
			dTactEnd = GetTickCount();
			if (dTactEnd >= dTactStart)
				dTactTime = dTactEnd - dTactStart;
			else
				dTactTime = ((DWORD)0xFFFFFFFF) - (dTactStart - dTactEnd);
			strTactTime.Format(_T("%d"), dTactTime);
			strLog.Format(_T("DoWork_LPMove, VAC ON Fail, %d, T=%s msec"), nRet, strTactTime);

			return false;
		}

		if (bUp == true)
		{
			CString strTactTimeUp;
			DWORD dTactStartUp, dTactEndUp, dTactTimeUp;
			dTactStartUp = GetTickCount();
			//First
			iSpeed = SPEED_MID; //  SPEED_HIGH; // jsyoon 20201123 change
			dPos = dLifePinPos[df_POS_PRE];

			if (nRet == VTM_RV_SUCCESSED)
			{
				dCurPos = GetCurPos(iAxis);
				if (dCurPos < dPos)
				{
					nRet = MoveCmdPosA(iAxis, dPos, true, iSpeed);
					nStep = df_POS_DOWN;
				}
			}

			dTactEndUp = GetTickCount();
			if (dTactEndUp >= dTactStartUp)
				dTactTimeUp = dTactEndUp - dTactStartUp;
			else
				dTactTimeUp = ((DWORD)0xFFFFFFFF) - (dTactStartUp - dTactEndUp);
			strTactTimeUp.Format(_T("%d"), dTactTimeUp / 1000);

			if (dTactTimeUp > 1000)
			{
				CMCCLogMgr::GetInstance()->SetLiftPinMoveTime(0, _ttoi(strTactTimeUp));
			}
			

			dTactStartUp = dTactEndUp;

			//Second
			iSpeed = SPEED_LOW;
			dPos = dLifePinPos[df_POS_MIDDLE];

			if (nRet == VTM_RV_SUCCESSED)
			{
				dCurPos = GetCurPos(iAxis);
				if (dCurPos < dPos)
				{
					nRet = MoveCmdPosA(iAxis, dPos, true, iSpeed);
					nStep = df_POS_MIDDLE;
				}
			}

			dTactEndUp = GetTickCount();
			if (dTactEndUp >= dTactStartUp)
				dTactTimeUp = dTactEndUp - dTactStartUp;
			else
				dTactTimeUp = ((DWORD)0xFFFFFFFF) - (dTactStartUp - dTactEndUp);
			strTactTimeUp.Format(_T("%d"), dTactTimeUp / 1000);

			if (dTactTimeUp > 1000)
			{
				CMCCLogMgr::GetInstance()->SetLiftPinMoveTime(1, _ttoi(strTactTimeUp));
			}
			

			////First
			//iSpeed = SPEED_MID; //  SPEED_HIGH; // jsyoon 20201123 change
			//dPos = dLifePinPos[df_POS_PRE];

			//if (nRet == VTM_RV_SUCCESSED)
			//{
			//	dCurPos = GetCurPos(iAxis);
			//	if (dCurPos < dPos)
			//	{
			//		nRet = MoveCmdPosA(iAxis, dPos, true, iSpeed);
			//		nStep = df_POS_DOWN;
			//	}
			//}

			////Second
			//iSpeed = SPEED_LOW;
			//dPos = dLifePinPos[df_POS_MIDDLE];

			//if (nRet == VTM_RV_SUCCESSED)
			//{
			//	dCurPos = GetCurPos(iAxis);
			//	if (dCurPos < dPos)
			//	{
			//		nRet = MoveCmdPosA(iAxis, dPos, true, iSpeed);
			//		nStep = df_POS_MIDDLE;
			//	}
			//}
		}
	}
	else
	{
		;
	}

	if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
	{
		if (bUp)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_LIFT_PIN_SENSOR_UP01, true);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_LIFT_PIN_SENSOR_DOWN01, false);

			nStep = df_POS_UP;
		}
	}

	CString strTactTime, strLog;
	dTactEnd = GetTickCount();
	if (dTactEnd >= dTactStart)
		dTactTime = dTactEnd - dTactStart;
	else
		dTactTime = ((DWORD)0xFFFFFFFF) - (dTactStart - dTactEnd);
	strTactTime.Format(_T("%d"), dTactTime);

	strLog.Format(_T("DoWork_LPPreMove Up, End, %d, T=%s msec"), nRet, strTactTime);
	m_pMotorControlMgr->GetLogFileAccessorPtr()->KMLOG(OPER, strLog, true);
//	gLog(m_pSystem->hLog, strLog, LOG_LEVEL_D);

	return nRet;
}

