		stPositionProbeZ[0].axis = AXIS_PROBE_Z1;
		stPositionProbeZ[0].dPosition = dMove;
		stPositionProbeZ[1].axis = AXIS_PROBE_Z2;
		stPositionProbeZ[1].dPosition = dMove;
		stPositionProbeZ[2].axis = AXIS_PROBE_Z3;
		stPositionProbeZ[2].dPosition = dMove;
		stPositionProbeZ[3].axis = AXIS_PROBE_Z4;
		stPositionProbeZ[3].dPosition = dMove;

		nRet = MoveCmdPosMulti(stPositionProbeZ, 4, SPEED_LOW, true);

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			dMove = 0.;

			stPositionProbeZ[0].dPosition = dMove;
			stPositionProbeZ[1].dPosition = dMove;
			stPositionProbeZ[2].dPosition = dMove;
			stPositionProbeZ[3].dPosition = dMove;

			nRet = MoveCmdPosMulti(stPositionProbeZ, 4, SPEED_HIGH, true);
		}
	}
	else
	{
		dMove = fContatZ;

		switch (nAxis)
		{
		case AXIS_PROBE_Z1:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true, SPEED_LOW);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				dMove = 0.;
				nRet = MoveCmdPosA(nAxis, dMove, true);
			}
		}
		break;
		case AXIS_PROBE_Z2:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true, SPEED_LOW);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				dMove = 0.;
				nRet = MoveCmdPosA(nAxis, dMove, true);
			}
		}
		break;
		case AXIS_PROBE_Z3:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true, SPEED_LOW);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				dMove = 0.;
				nRet = MoveCmdPosA(nAxis, dMove, true);
			}
		}
		break;
		case AXIS_PROBE_Z4:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true, SPEED_LOW);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				dMove = 0.;
				nRet = MoveCmdPosA(nAxis, dMove, true);
			}
		}
		break;
		case AXIS_PROBE_Z5:
		{
			nRet = MoveCmdPosA(nAxis, dMove, true, SPEED_LOW);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				dMove = 0.;
				nRet = MoveCmdPosA(nAxis, dMove, true);
			}
		}
		break;
		default:
			break;
		}
	}

	return nRet;
}


