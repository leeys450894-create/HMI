int CMaintControlMgr::WaitForClamp_UpNDownComplete(bool bUp, UINT nTimeOut)
{
	if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
		return VTM_RV_SUCCESSED;

	ULONGLONG  dwS, dwR, dwT = 0;

	int nRtn = PLC_COMMAND_TIMEOUT;
	for (dwS = GetTickCount(); dwT < nTimeOut * 1000;)	// jsyoon 2022.08.16 add * 1000
	{
		Sleep(100);

		nRtn = Is_Clamp_UpNDown(bUp);
		if (nRtn == VTM_RV_SUCCESSED)
		{
			return VTM_RV_SUCCESSED;
		}

		dwR = GetTickCount();

		if (dwR >= dwS)
			dwT = dwR - dwS;
		else
			dwT = ((DWORD)0xFFFFFFFF) - (dwS - dwR);
	}

	return nRtn;
}

