			stPositionSubZ[0].axis = AXIS_Z3;
			stPositionSubZ[0].dPosition = dSubZSafety[enumSUBZ_WAD_RIGHT];
			stPositionSubZ[1].axis = AXIS_Z4;
			stPositionSubZ[1].dPosition = dSubZSafety[enumSUBZ_WAD_LEFT];
			stPositionSubZ[2].axis = AXIS_Z5;
			stPositionSubZ[2].dPosition = dSubZSafety[enumSUBZ_VISION_ANGLE_RIGHT];
			stPositionSubZ[3].axis = AXIS_Z6;
			stPositionSubZ[3].dPosition = dSubZSafety[enumSUBZ_VISION_ANGLE_LEFT];

			nRet = MoveOrgPosMulti(stPositionSubZ, 4, SPEED_HIGH, true);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// LYS 2026-08-28 Angle Sub Safety - Scheimpflug/Rotate/Zoom/Tilt/Azimuth, head1(BACK)+head2(FRONT)
			double dAngleSubSafety[enumANGLE_HEAD_COUNT][enumANGLESUB_COUNT];
			ZeroMemory(dAngleSubSafety, sizeof(dAngleSubSafety));
			GetPositionConfigMgr()->GetAngleSubSafetyPosition(enumANGLE_HEAD1, &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_SCHEIMPFLUG], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ROTATE], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ZOOM], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_TILT], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_AZIMUTH]);
			GetPositionConfigMgr()->GetAngleSubSafetyPosition(enumANGLE_HEAD2, &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_SCHEIMPFLUG], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ROTATE], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ZOOM], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_TILT], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_AZIMUTH]);

			stMotorPosition stPositionAngleSub[10];
			ZeroMemory(&stPositionAngleSub, sizeof(stPositionAngleSub));
			stPositionAngleSub[0].axis = AXIS_ANGLE_SF1;
			stPositionAngleSub[0].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_SCHEIMPFLUG];
			stPositionAngleSub[1].axis = AXIS_ANGLE_ROTATE1;
			stPositionAngleSub[1].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ROTATE];
			stPositionAngleSub[2].axis = AXIS_ANGLE_ZOOM1;
			stPositionAngleSub[2].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ZOOM];
			stPositionAngleSub[3].axis = AXIS_ANGLE_TILT1;
			stPositionAngleSub[3].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_TILT];
			stPositionAngleSub[4].axis = AXIS_ANGLE_AZM1;
			stPositionAngleSub[4].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_AZIMUTH];
			stPositionAngleSub[5].axis = AXIS_ANGLE_SF2;
			stPositionAngleSub[5].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_SCHEIMPFLUG];
			stPositionAngleSub[6].axis = AXIS_ANGLE_ROTATE2;
			stPositionAngleSub[6].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ROTATE];
			stPositionAngleSub[7].axis = AXIS_ANGLE_ZOOM2;
			stPositionAngleSub[7].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ZOOM];
			stPositionAngleSub[8].axis = AXIS_ANGLE_TILT2;
			stPositionAngleSub[8].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_TILT];
			stPositionAngleSub[9].axis = AXIS_ANGLE_AZM2;
			stPositionAngleSub[9].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_AZIMUTH];

			nRet = MoveOrgPosMulti(stPositionAngleSub, 10, SPEED_HIGH, true);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD, true);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				stMotorPosition stPositionCross[4];
				ZeroMemory(&stPositionCross, sizeof(stPositionCross));
				stPositionCross[0].axis = AXIS_Y1;
				stPositionCross[0].dPosition = dSafetyHeadY1;
				stPositionCross[1].axis = AXIS_Y2;
				stPositionCross[1].dPosition = dSafetyHeadY2;
				stPositionCross[2].axis = AXIS_Y3;
				stPositionCross[2].dPosition = dSafetyHeadY1;
				stPositionCross[3].axis = AXIS_Y4;
				stPositionCross[3].dPosition = dSafetyHeadY2;

				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_FRONT_LEFT, true);
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_FRONT_RIGHT, true);
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_BACK_LEFT, true);
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_BACK_RIGHT, true);

				nRet = MoveOrgPosMulti(stPositionCross, 4, SPEED_HIGH);
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				stMotorPosition stPositionX[2];
				ZeroMemory(&stPositionX, sizeof(stPositionX));
				stPositionX[0].axis = AXIS_X2;
				stPositionX[0].dPosition = dSafetyHeadX1;
				stPositionX[1].axis = AXIS_X3;
				stPositionX[1].dPosition = dSafetyHeadX2;

				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_X_FRONT, true);
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_X_BACK, true);

				nRet = MoveOrgPosMulti(stPositionX, 2, SPEED_HIGH);
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_STAGE_X, true);

			nRet = MoveOrgPosA(AXIS_X, dSafetyStageX, false, SPEED_HIGH, 0, 0);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			for (int iAxis = AXIS_TYPE_END; iAxis >= AXIS_X; iAxis--)
			{
				if (iAxis == AXIS_X)
				{
					nRet = DoWork_MotionDone(iAxis);

					if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
					{
						GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR03, true);
					}

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_STAGE_X, false);

					
				}
				else if (iAxis == AXIS_X2)
				{
					nRet = DoWork_MotionDone(iAxis);

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_X_BACK, false);

					if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
					{
						GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR01, true);
					}
				}
				else if (iAxis == AXIS_X3)
				{
					nRet = DoWork_MotionDone(iAxis);

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_X_FRONT, false);

					if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
					{
						GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR02, true);
					}
				}
				else if (iAxis == AXIS_Y1)
				{
					nRet = DoWork_MotionDone(iAxis);

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_BACK_LEFT, false);

					if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
					{
						GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR01, true);
					}

				}
				else if (iAxis == AXIS_Y2)
				{
					nRet = DoWork_MotionDone(iAxis);

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_BACK_RIGHT, false);

					if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
					{
						GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR02, true);
					}
				}
				else if (iAxis == AXIS_Y3)
				{
					nRet = DoWork_MotionDone(iAxis);

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_FRONT_LEFT, false);

					if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
					{
						GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR03, true);
					}
				}
				else if (iAxis == AXIS_Y4)
				{
					nRet = DoWork_MotionDone(iAxis);

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_HEAD_Y_FRONT_RIGHT, false);

					if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
					{
						GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR04, true);
					}
				}

				if (nRet != df_MOTION_RV_SUCCESSED)
				{
					break;
				}
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_STAGE_R, true);

			nRet = MoveOrgPosA(AXIS_LOADER_R, 0, false, SPEED_HIGH, 0, 0);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				nRet = DoWork_MotionDone(AXIS_LOADER_R);
			}

			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_MOT_SAFETY_STAGE_R, false);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			bool bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsSafetySensorOn();
			if (bRet == true)
			{
				nRet = df_MOTION_RV_SUCCESSED;
			}
			else
			{
				nRet = PLC_CANNOT_DETECT_SAFETY_SENSOR_X;
			}
		}
	}
	else
	{
		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_CHNG_LAMP, true);

		for (size_t i = 0; i < MAIN_CCD_MAX_NUM; i++)
		{
			GetLightControlMgrPtr()->SetLedLampIntensity(0, i, 0);
		}

		CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_CHNG_LAMP, false);

		bool bRet = false;

		// Probe Move
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			bool bMove = false;
			for (size_t i = (m_pMotorControlMgr->IsOCP() ? AXIS_PROBE_Z5 : AXIS_PROBE_Z1); i <= AXIS_PROBE_Z5; i++)  // LYS 2026-06-26 OCP
			{
				if (GetCurPos(i) > 0.1)
				{
					bMove = true;
					break;
				}
			}

			if (bMove == true)
			{
				for (size_t i = AXIS_PROBE_Z1; i < AXIS_PROBE_Z5; i++)
				{
					if (GetCurPos(i) > 0.1)
					{
						bMove = true;
						break;
					}
				}

				double dfMove = 2.;
				if (bMove == true)
				{
					nRet = MoveCmdPos_ProbeUnContact(AXIS_ALL_Z, dfMove);
				}
				else
				{
					nRet = MoveCmdPos_ProbeUnContact(AXIS_PROBE_Z5, dfMove);
				}

				//double dPosProbeZ = 0;
				//nRet = MoveCmdPos_ProbeMove(AXIS_ALL_Z, dPosProbeZ, SPEED_HIGH);

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					Sleep(1000);
				}
			}
			else
			{
				for (size_t i = (m_pMotorControlMgr->IsOCP() ? df_PROBE_MEAS : df_PROBE_AGING1); i <= df_PROBE_MEAS; i++)  // LYS 2026-06-26 OCP
				{
					bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(i);
					if (bRet != true)
					{
						break;
					}
				}

				if (bRet != true)
				{
					nRet = MoveCmdPos_ProbeMove(AXIS_ALL_Z, 0, SPEED_HIGH);
				}
			}
		}

		if (nRet == VTM_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_CHK_STEP2, true);

			for (size_t i = (m_pMotorControlMgr->IsOCP() ? df_PROBE_MEAS : df_PROBE_AGING1); i <= df_PROBE_MEAS; i++)  // LYS 2026-06-26 OCP
			{
				bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(i);
				if (bRet != true)
				{
					nRet = MOTION_INTERLOCK_6;
					break;
				}
			}

			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_CHK_STEP2, false);
		}

		if (nRet == VTM_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_CHK_STEP3, true);

			bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsLoaderArmSensorOn();
			if (bRet == true)
			{
				nRet = PLC_ARM_SENSOR_DETECT;
			}

			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_CHK_STEP3, false);
		}

		if (nRet == VTM_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_CHK_STEP4, true);

			bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsShutterSensorClose();
			if (bRet != true)
			{
				nRet = PLC_LOADER_SHUTTER_UP_ERROR;
			}

			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_CHK_STEP4, false);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE, true);

			// All Axis
			double dSafetyStageX = 0.0;
			double dSafetyHeadX1 = 0.0;
			double dSafetyHeadX2 = 0.0;
			double dSafetyHeadY1 = 0.0;
			double dSafetyHeadY2 = 0.0;
			double dSafetyZ = 0.0;
			double dSafetyZ2 = 0.0;
			GetPositionConfigMgr()->GetSafetyPosition(&dSafetyStageX, &dSafetyHeadX1, &dSafetyHeadX2, &dSafetyHeadY1, &dSafetyHeadY2, &dSafetyZ, &dSafetyZ2);

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				stMotorPosition stPositionZ[2];
				ZeroMemory(&stPositionZ, sizeof(stPositionZ));
				stPositionZ[0].axis = AXIS_Z1;
				stPositionZ[0].dPosition = dSafetyZ2;
				stPositionZ[1].axis = AXIS_Z2;
				stPositionZ[1].dPosition = dSafetyZ;

				nRet = MoveOrgPosMulti(stPositionZ, 2, SPEED_HIGH, true);
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				// LYS 2026-08-28 Sub Z Safety - Z3(WAD_RIGHT)/Z4(WAD_LEFT)/Z5(VISION_ANGLE_RIGHT)/Z6(VISION_ANGLE_LEFT)
				double dSubZSafety[enumSUBZ_COUNT];
				ZeroMemory(dSubZSafety, sizeof(dSubZSafety));
				GetPositionConfigMgr()->GetSubZSafetyPosition(&dSubZSafety[enumSUBZ_WAD_RIGHT], &dSubZSafety[enumSUBZ_WAD_LEFT], &dSubZSafety[enumSUBZ_VISION_ANGLE_RIGHT], &dSubZSafety[enumSUBZ_VISION_ANGLE_LEFT]);

				stMotorPosition stPositionSubZ[4];
				ZeroMemory(&stPositionSubZ, sizeof(stPositionSubZ));
				stPositionSubZ[0].axis = AXIS_Z3;
				stPositionSubZ[0].dPosition = dSubZSafety[enumSUBZ_WAD_RIGHT];
				stPositionSubZ[1].axis = AXIS_Z4;
				stPositionSubZ[1].dPosition = dSubZSafety[enumSUBZ_WAD_LEFT];
				stPositionSubZ[2].axis = AXIS_Z5;
				stPositionSubZ[2].dPosition = dSubZSafety[enumSUBZ_VISION_ANGLE_RIGHT];
				stPositionSubZ[3].axis = AXIS_Z6;
				stPositionSubZ[3].dPosition = dSubZSafety[enumSUBZ_VISION_ANGLE_LEFT];

				nRet = MoveOrgPosMulti(stPositionSubZ, 4, SPEED_HIGH, true);
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				// LYS 2026-08-28 Angle Sub Safety - Scheimpflug/Rotate/Zoom/Tilt/Azimuth, head1(BACK)+head2(FRONT)
				double dAngleSubSafety[enumANGLE_HEAD_COUNT][enumANGLESUB_COUNT];
				ZeroMemory(dAngleSubSafety, sizeof(dAngleSubSafety));
				GetPositionConfigMgr()->GetAngleSubSafetyPosition(enumANGLE_HEAD1, &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_SCHEIMPFLUG], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ROTATE], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ZOOM], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_TILT], &dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_AZIMUTH]);
				GetPositionConfigMgr()->GetAngleSubSafetyPosition(enumANGLE_HEAD2, &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_SCHEIMPFLUG], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ROTATE], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ZOOM], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_TILT], &dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_AZIMUTH]);

				stMotorPosition stPositionAngleSub[10];
				ZeroMemory(&stPositionAngleSub, sizeof(stPositionAngleSub));
				stPositionAngleSub[0].axis = AXIS_ANGLE_SF1;
				stPositionAngleSub[0].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_SCHEIMPFLUG];
				stPositionAngleSub[1].axis = AXIS_ANGLE_ROTATE1;
				stPositionAngleSub[1].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ROTATE];
				stPositionAngleSub[2].axis = AXIS_ANGLE_ZOOM1;
				stPositionAngleSub[2].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_ZOOM];
				stPositionAngleSub[3].axis = AXIS_ANGLE_TILT1;
				stPositionAngleSub[3].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_TILT];
				stPositionAngleSub[4].axis = AXIS_ANGLE_AZM1;
				stPositionAngleSub[4].dPosition = dAngleSubSafety[enumANGLE_HEAD1][enumANGLESUB_AZIMUTH];
				stPositionAngleSub[5].axis = AXIS_ANGLE_SF2;
				stPositionAngleSub[5].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_SCHEIMPFLUG];
				stPositionAngleSub[6].axis = AXIS_ANGLE_ROTATE2;
				stPositionAngleSub[6].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ROTATE];
				stPositionAngleSub[7].axis = AXIS_ANGLE_ZOOM2;
				stPositionAngleSub[7].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_ZOOM];
				stPositionAngleSub[8].axis = AXIS_ANGLE_TILT2;
				stPositionAngleSub[8].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_TILT];
				stPositionAngleSub[9].axis = AXIS_ANGLE_AZM2;
				stPositionAngleSub[9].dPosition = dAngleSubSafety[enumANGLE_HEAD2][enumANGLESUB_AZIMUTH];

				nRet = MoveOrgPosMulti(stPositionAngleSub, 10, SPEED_HIGH, true);
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					stMotorPosition stPositionCross[4];
					ZeroMemory(&stPositionCross, sizeof(stPositionCross));
					stPositionCross[0].axis = AXIS_Y1;
					stPositionCross[0].dPosition = dSafetyHeadY1;
					stPositionCross[1].axis = AXIS_Y2;
					stPositionCross[1].dPosition = dSafetyHeadY2;
					stPositionCross[2].axis = AXIS_Y3;
					stPositionCross[2].dPosition = dSafetyHeadY1;
					stPositionCross[3].axis = AXIS_Y4;
					stPositionCross[3].dPosition = dSafetyHeadY2;

					nRet = MoveOrgPosMulti(stPositionCross, 4, SPEED_HIGH);
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					stMotorPosition stPositionX[2];
					ZeroMemory(&stPositionX, sizeof(stPositionX));
					stPositionX[0].axis = AXIS_X2;
					stPositionX[0].dPosition = dSafetyHeadX1;
					stPositionX[1].axis = AXIS_X3;
					stPositionX[1].dPosition = dSafetyHeadX2;

					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP1, true);
					CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP2, true);

					nRet = MoveOrgPosMulti(stPositionX, 2, SPEED_HIGH);
				}
			}

			// 2023.04.11 add Lift pin Interlock
			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				double dInterlock = 0, dProbeGap = 0, dPosProbe5 = 0;
				GetMotorControlMgrPtr()->GetInterlockPos(nullptr, nullptr, &dProbeGap, nullptr, &dInterlock);

				// LYS 2026-08-25 복구 - OCP 갠트리 X가 움직이므로 lift pin 인터락이 그 위치를 다시 봐야 한다.
				{
					dPosProbe5= GetCurPos(AXIS_PROBE_X9);
					if (dPosProbe5 > dInterlock)
					{
						double dPosProbe4 = 0;
						dPosProbe4 = GetCurPos(AXIS_PROBE_X7);
						if ( dInterlock  - dProbeGap < dPosProbe4)
						{
							// Probe X
							stMotorPosition stPositionProbeX[5];
							ZeroMemory(&stPositionProbeX, sizeof(stPositionProbeX));
							GetCmdPos_ProbeX(stPositionProbeX, df_PROBE_MEAS, dInterlock - 1, 200, TRUE);

							nRet = MoveCmdPosMulti(stPositionProbeX, 5, SPEED_HIGH, true);
						}
						else
						{
							nRet = MoveCmdPosA(AXIS_PROBE_X9, dInterlock - 1, true, SPEED_HIGH, 0, 0);
						}
					}
				}
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP3, true);

				nRet = MoveOrgPosA(AXIS_X, dSafetyStageX, false, SPEED_HIGH, 0, 0);
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				for (int iAxis = AXIS_TYPE_END; iAxis >= AXIS_X; iAxis--)
				{
					if (iAxis == AXIS_X)
					{
						nRet = DoWork_MotionDone(iAxis);

						CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP3, false);

						if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
						{
							GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR03, true);
						}
					}
					else if (iAxis == AXIS_X2)
					{
						nRet = DoWork_MotionDone(iAxis);

						CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP2, false);

						if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
						{
							GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR01, true);
						}
					}
					else if (iAxis == AXIS_X3)
					{
						nRet = DoWork_MotionDone(iAxis);

						CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP1, false);

						if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
						{
							GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR02, true);
						}
					}
					else if (iAxis == AXIS_Y1)
					{
						nRet = DoWork_MotionDone(iAxis);

						if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
						{
							GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR01, true);
						}
					}
					else if (iAxis == AXIS_Y2)
					{
						nRet = DoWork_MotionDone(iAxis);

						if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
						{
							GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR02, true);
						}
					}
					else if (iAxis == AXIS_Y3)
					{
						nRet = DoWork_MotionDone(iAxis);

						if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
						{
							GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR03, true);
						}
					}
					else if (iAxis == AXIS_Y4)
					{
						nRet = DoWork_MotionDone(iAxis);

						if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
						{
							GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR04, true);
						}
					}

					if (nRet != df_MOTION_RV_SUCCESSED)
					{
						break;
					}
				}
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP4, true);

				// jsyoon 2022.08.26 change
				// LYS 2026-07-20 change
				// LYS 2026-07-29 Rollback
				nRet = MoveOrgPosA(AXIS_LOADER_R, 0.0, false, SPEED_HIGH, 0, 0);
				//double dCurRotate = 0.;
				//dCurRotate = GetCurPos(AXIS_LOADER_R);
				//if ( fabs(dCurRotate) > 89.0 )
				//{
				//	nRet = MoveOrgPosA(AXIS_LOADER_R, 90.0, false, SPEED_HIGH, 0, 0);
				//}
				//else
				//{
				//	nRet = MoveOrgPosA(AXIS_LOADER_R, 0.0, false, SPEED_HIGH, 0, 0);
				//}
				
				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					nRet = DoWork_MotionDone(AXIS_LOADER_R);
				}

				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP4, false);
			}


			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP5, true);

				bool bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsSafetySensorOn();
				if (bRet == true)
				{
					nRet = df_MOTION_RV_SUCCESSED;
				}
				else
				{
					nRet = PLC_CANNOT_DETECT_SAFETY_SENSOR_X;
				}

				CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE_STEP5, false);
			}

			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_SAFETY_MOVE, false);
		}
	}
	
	return nRet;
}

