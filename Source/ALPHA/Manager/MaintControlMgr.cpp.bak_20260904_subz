				break;
			}
		}
	}

	stMotorPosition stPositionX[10];
	ZeroMemory(&stPositionX, sizeof(stPositionX));
	stMotorPosition stPositionY[10];
	ZeroMemory(&stPositionY, sizeof(stPositionY));
	int nMoveX = 0, nMoveY = 0;

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Y3)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[0] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[0]);
			}
			else if (axis == AXIS_Y4)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[1] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[1]);
			}
			else if (axis == AXIS_Y1)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[2];
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[2]);
			}
			else if (axis == AXIS_Y2)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[3];
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[3]);
			}


			else if (axis == AXIS_X2)
			{
				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGlassOffsetX;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);

				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X3;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] - dGantryGap;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X3, dOffsetX[0]);
			}

			else if (axis == AXIS_X3)
			{
				stPositionX[nMoveX].axis = AXIS_X2;
				stPositionX[nMoveX].dPosition = m_pMotorControlMgr->GetMaxSWLimit(AXIS_X2) - 0.5;  // dPos + dOffsetX[0] + dGlassOffsetX + dGantryGap;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X2, dOffsetX[0]);

				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0];
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);
			}
		}

		bool bFirstMoveX2 = false;

		// Move X First 
		if (nMoveX > 0)
		{
			if (stPositionX[0].axis == AXIS_X2)
			{
				if (GetCurPos(AXIS_X2) < stPositionX[0].dPosition)
				{
					nRet = MoveCmdPosA(stPositionX[0].axis, stPositionX[0].dPosition, false);

					bFirstMoveX2 = true;
				}
				else
				{
					nRet = MoveCmdPosA(stPositionX[1].axis, stPositionX[1].dPosition, false);
				}
			}
		}
		
		// Move Y
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			nRet = MoveCmdPosMulti(stPositionY, nMoveY, SPEED_HIGH, false, true);
		}

		// Move X First Check
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// Retry
			if (nMoveX > 0)
			{
				if (bFirstMoveX2 == true)		// X2 
				{
					nRet = DoWork_MotionDone(stPositionX[0].axis);

					if (nRet == df_MOTION_RV_SUCCESSED)
					{
						if (fabs(GetCurPos(stPositionX[0].axis) - stPositionX[0].dPosition) > 0.01)
						{
							nRet = MoveCmdPosA(stPositionX[0].axis, stPositionX[0].dPosition, true);
						}
					}
				}
				else
				{
					nRet = DoWork_MotionDone(stPositionX[1].axis);

					if (nRet == df_MOTION_RV_SUCCESSED)
					{
						if (fabs(GetCurPos(stPositionX[1].axis) - stPositionX[1].dPosition) > 0.01)
						{
							nRet = MoveCmdPosA(stPositionX[1].axis, stPositionX[1].dPosition, true);
						}
					}
				}
			}
		}

		// Move X Second
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (nMoveX > 0)
			{
				if (bFirstMoveX2 == true)
				{
					nRet = MoveCmdPosA(stPositionX[1].axis, stPositionX[1].dPosition, true);
				}
				else
				{
					nRet = MoveCmdPosA(stPositionX[0].axis, stPositionX[0].dPosition, true);
				}
			}
		}

		// Move Z
		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			for (size_t i = 0; i < nAxis; i++)
			{
				axis = pPos[i].axis;
				if (axis == AXIS_Z1)
				{
					dPos = pPos[i].dPosition + dOffsetZ[0];
					nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);
					break;
				}
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (bDoneCheck == true)
			{
				for (size_t i = 0; i < nAxis; i++)
				{
					axis = pPos[i].axis;
					nRet = DoWork_MotionDone(axis);
					if (nRet != df_MOTION_RV_SUCCESSED)
						break;
				}
			}
		}
	}

	return nRet;
}

long CMaintControlMgr::MoveCmdPosAngle(stMotorPosition* pPos, int nAxis, int iSpeed, bool bDoneCheck)
{
	// TODO: 여기에 구현 코드 추가.
	long nRet = df_MOTION_RV_SUCCESSED;

	double dGantryGap = 0;
	GetInterlockPos(&dGantryGap, nullptr, nullptr);

	double dOffsetX[4], dOffsetY[4], dOffsetZ[4];
	// jsyoon 2022.07.06 add
	ZeroMemory(&dOffsetX, sizeof(dOffsetX));
	ZeroMemory(&dOffsetY, sizeof(dOffsetY));
	ZeroMemory(&dOffsetZ, sizeof(dOffsetZ));

	for (size_t i = 0; i < 2; i++)
	{
		m_pPositionConfigMgr->GetHeadOffset(i, 1, &dOffsetX[i], &dOffsetY[i], &dOffsetZ[i]);	// Angle
	}

	for (size_t i = 0; i < 2; i++)
	{
		m_pPositionConfigMgr->GetHeadOffset(i, 2, &dOffsetX[i + 2], &dOffsetY[i + 2], &dOffsetZ[i + 2]);		// Vision
	}

	double dGlassOffsetX = 0., dGlassOffsetY = 0.;
	//dGlassOffsetX = dGlassAlignOffset[0];
	//dGlassOffsetY = dGlassAlignOffset[1];

	int axis = 0;
	double dPos = 0.;

	// LYS 2026-08-26 선두의 Z1(BACK Z) 이동 제거. Angle은 FRONT 갠트리(X3/Z2) 기반이라 Z1 지령 불필요.

	// LYS 2026-08-19 Angle 모듈 광학계(Scheimpflug / Rotate / Zoom / Tilt / Azimuth x2).
	// 레시피 기반이라 호출부는 pPos에 덧붙이기만 한다. 아래 X/Y/Z 헤드 이동보다 먼저
	// 지령해 병렬로 움직이게 하고, 대기는 끝으로 미룬다.
	stMotorPosition stPositionAngle[10];
	ZeroMemory(&stPositionAngle, sizeof(stPositionAngle));
	int nMoveAngle = 0;

	for (int i = 0; i < nAxis; i++)
	{
		if (pPos[i].axis < AXIS_ANGLE_SF1 || pPos[i].axis > AXIS_ANGLE_AZM2) continue;
		if (nMoveAngle >= _countof(stPositionAngle)) break;

		// machine may not carry the angle module - skip axes the config disabled
		axis_data_type* pAxisInfo = m_pMotorControlMgr->GetAxisProperty(pPos[i].axis);
		if (pAxisInfo == nullptr || pAxisInfo->bUse == FALSE) continue;

		// 입력 값 0일 때 가드(추후 적용)
		//if (fabs(pPos[i].dPosition) < 0.0001) continue;

		stPositionAngle[nMoveAngle].axis = pPos[i].axis;
		stPositionAngle[nMoveAngle].dPosition = pPos[i].dPosition;
		nMoveAngle++;
	}

	if (nRet == df_MOTION_RV_SUCCESSED && nMoveAngle > 0)
	{
		nRet = MoveCmdPosMulti(stPositionAngle, nMoveAngle, SPEED_HIGH, false, false);
	}

	//stMotorPosition stPosition[10];
	//ZeroMemory(&stPosition, sizeof(stPosition));
	//int nMove = 0;
	stMotorPosition stPositionX[10];
	ZeroMemory(&stPositionX, sizeof(stPositionX));
	stMotorPosition stPositionY[10];
	ZeroMemory(&stPositionY, sizeof(stPositionY));
	int nMoveX = 0, nMoveY = 0;

	bool bSetMoveAxisX = false;
	double dMoveAxisX = 0.;

	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (size_t i = 0; i < nAxis; i++)
		{
			axis = pPos[i].axis;
			if (axis == AXIS_Y1)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[0] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[0]);
			}
			else if (axis == AXIS_Y2)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[1] + dGlassOffsetY;
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[1]);
			}
			else if (axis == AXIS_Y3)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[2];
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[2]);
			}
			else if (axis == AXIS_Y4)
			{
				dPos = pPos[i].dPosition;
				stPositionY[nMoveY].axis = axis;
				stPositionY[nMoveY].dPosition = dPos + dOffsetY[3];
				nMoveY++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetY[3]);
			}

			else if (axis == AXIS_X2)
			{
			//	dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X3;
				stPositionX[nMoveX].dPosition = m_pMotorControlMgr->GetMinSWLimit(AXIS_X2) - (dGantryGap + 50); //　dPos + dOffsetX[0] - (dGantryGap + 100);
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X3, dOffsetX[0]);

				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGlassOffsetX;

				bSetMoveAxisX = true;
				dMoveAxisX = stPositionX[nMoveX].dPosition;

				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);
			}

			else if (axis == AXIS_X3)
			{
				dPos = pPos[i].dPosition;
				stPositionX[nMoveX].axis = AXIS_X2;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGantryGap;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(AXIS_X2, dOffsetX[0]);

				stPositionX[nMoveX].axis = axis;
				stPositionX[nMoveX].dPosition = dPos + dOffsetX[0] + dGlassOffsetX;
				nMoveX++;

				m_pMotorControlMgr->SetHeadOffset(axis, dOffsetX[0]);
			}
		}

		if (bSetMoveAxisX == true)
		{
			// LYS 2026-08-25 restored - the OCP gantry X moves now.
			if (GetCurPos(AXIS_PROBE_X9) > dMoveAxisX - 20)
			{
				nRet = MoveCmdPosA(AXIS_Z2, 0, true, SPEED_HIGH, -1, -1);
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (nMoveX > 0)
			{
				nRet = MoveCmdPosMulti(stPositionX, nMoveX, SPEED_HIGH, true, true);
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			nRet = MoveCmdPosMulti(stPositionY, nMoveY, SPEED_HIGH, false, true);
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			for (size_t i = 0; i < nAxis; i++)
			{
				axis = pPos[i].axis;
				if (axis == AXIS_Z2)
				{
					dPos = pPos[i].dPosition + dOffsetZ[0];
					nRet = MoveCmdPosA(axis, dPos, true, SPEED_HIGH);
					break;
				}
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			// LYS 2026-08-28 Sub Z(Z5/Z6) - VISION/ANGLE(화질/시야각) 측정 공용, DoWork에서 넘어온 레시피 값 그대로 이동.
			stMotorPosition stPositionSubZ[2];
			ZeroMemory(&stPositionSubZ, sizeof(stPositionSubZ));
			int nMoveSubZ = 0;
			for (size_t i = 0; i < nAxis; i++)
			{
				if (pPos[i].axis == AXIS_Z5 || pPos[i].axis == AXIS_Z6)
				{
					stPositionSubZ[nMoveSubZ].axis = pPos[i].axis;
					stPositionSubZ[nMoveSubZ].dPosition = pPos[i].dPosition;
					nMoveSubZ++;
				}
			}
			if (nMoveSubZ > 0)
			{
				nRet = MoveCmdPosMulti(stPositionSubZ, nMoveSubZ, SPEED_HIGH, true, false);
			}
		}

		if (nRet == df_MOTION_RV_SUCCESSED)
		{
			if (bDoneCheck == true)
			{
				for (size_t i = 0; i < nAxis; i++)
				{
					axis = pPos[i].axis;
					nRet = DoWork_MotionDone(axis);
					if (nRet != df_MOTION_RV_SUCCESSED)
						break;
				}
			}
		}
	}

	// LYS 2026-08-19 Angle 축은 앞에서 지령했으므로 위의 X / Z2 대기로 대개 이동이 끝난다.
	// bDoneCheck와 무관하게 대기한다 - 측정 스텝의 자체 대기 루프는 pPos[0..1]만 커버하고,
	// 측정 트리거 전에 광학계가 안정돼 있어야 한다.
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		for (int i = 0; i < nMoveAngle; i++)
		{
			nRet = DoWork_MotionDone(stPositionAngle[i].axis);
			if (nRet != df_MOTION_RV_SUCCESSED)
				break;
		}
	}

	return nRet;
}

int CMaintControlMgr::MoveCmdPos_CompareMS(int iProbe)
{
	double dProbeXMPos = 0;
	double dProbeXSPos = 0;
	int iSlaveAxis = 0;;
	int nRtn = VTM_RV_SUCCESSED;

	switch (iProbe)
	{
		case df_PROBE_AGING1:
		{
			dProbeXMPos = GetCurPos(AXIS_PROBE_X1); // M
			dProbeXSPos = GetCurPos(AXIS_PROBE_X2); // S
			iSlaveAxis = AXIS_PROBE_X2;
		}
		break;
		case df_PROBE_AGING2:
		{
			dProbeXMPos = GetCurPos(AXIS_PROBE_X3); // M
			dProbeXSPos = GetCurPos(AXIS_PROBE_X4); // S
			iSlaveAxis = AXIS_PROBE_X4;
		}
		break;
		case df_PROBE_AGING3:
		{
			dProbeXMPos = GetCurPos(AXIS_PROBE_X5); // M
			dProbeXSPos = GetCurPos(AXIS_PROBE_X6); // S
			iSlaveAxis = AXIS_PROBE_X6;
		}
		break;
		case df_PROBE_AGING4:
		{
			dProbeXMPos = GetCurPos(AXIS_PROBE_X7); // M
			dProbeXSPos = GetCurPos(AXIS_PROBE_X8); // S
			iSlaveAxis = AXIS_PROBE_X8;
		}
		break;
		case df_PROBE_MEAS:
		{
			dProbeXMPos = GetCurPos(AXIS_PROBE_X9); // M
			dProbeXSPos = GetCurPos(AXIS_PROBE_X10); // S
			iSlaveAxis = AXIS_PROBE_X10;
		}
	break;
	}	

	/* 소수점 4자리 까지 비교 
	dProbeXMPos = floor(dProbeXMPos * 1000) / 1000;
	dProbeXSPos = floor(dProbeXSPos * 1000) / 1000;*/

	// Move
	if ( fabs(dProbeXMPos - dProbeXSPos) > 0.001)
	{
		nRtn = MoveCmdPosR(iSlaveAxis, dProbeXMPos - dProbeXSPos , true, SPEED_LOW);
	}
	else
	{
		nRtn = VTM_RV_SUCCESSED;
	}

	return nRtn;
}

int CMaintControlMgr::MoveCmdPos_ProbeOffset(int iProbe)
{
	int nRet = df_MOTION_RV_SUCCESSED;

	// Probe X, Y Offset 위치 받음
	double dPosProbeOffsetX = 0;
	double dPosProbeOffsetY = 0;
	double dPosProbeOffsetT = 0;
	GetPositionConfigMgr()->GetProbeOffsetPos(iProbe-1, &dPosProbeOffsetX, &dPosProbeOffsetY, &dPosProbeOffsetT);

	stMotorPosition stPositionProbe[3];

	switch (iProbe)
	{
		case df_PROBE_AGING1:
		{
			stPositionProbe[0].axis = AXIS_PROBE_X1;
			stPositionProbe[1].axis = AXIS_PROBE_Y1;
			stPositionProbe[2].axis = AXIS_PROBE_X2; // Slave만 이동	
		}
		break;
		case df_PROBE_AGING2:
		{
			stPositionProbe[0].axis = AXIS_PROBE_X3;
			stPositionProbe[1].axis = AXIS_PROBE_Y2;
			stPositionProbe[2].axis = AXIS_PROBE_X4; // Slave만 이동			
		}
		break;
		case df_PROBE_AGING3:
		{
			stPositionProbe[0].axis = AXIS_PROBE_X5;
			stPositionProbe[1].axis = AXIS_PROBE_Y3;
			stPositionProbe[2].axis = AXIS_PROBE_X6; // Slave만 이동			
		}
		break;
		case df_PROBE_AGING4:
		{
			stPositionProbe[0].axis = AXIS_PROBE_X7;
			stPositionProbe[1].axis = AXIS_PROBE_Y4;
			stPositionProbe[2].axis = AXIS_PROBE_X8; // Slave만 이동			
		}
		break;
		case df_PROBE_MEAS:
		{
			stPositionProbe[0].axis = AXIS_PROBE_X9;
			stPositionProbe[1].axis = AXIS_PROBE_Y5;
			stPositionProbe[2].axis = AXIS_PROBE_X10; // Slave만 이동			
		}
	break;
	}	

	stPositionProbe[0].dPosition = dPosProbeOffsetX;
	stPositionProbe[1].dPosition = dPosProbeOffsetY;
	stPositionProbe[2].dPosition = dPosProbeOffsetT;

	// Move
	// X
	nRet = MoveOrgPosA(stPositionProbe[0].axis, stPositionProbe[0].dPosition, true, SPEED_LOW);

	if (nRet == VTM_RV_SUCCESSED)  // Y
	{
		nRet = MoveCmdPosR(stPositionProbe[1].axis, stPositionProbe[1].dPosition, true, SPEED_LOW);
	}
	if (nRet == VTM_RV_SUCCESSED)  // T
	{
		nRet = MoveCmdPosR(stPositionProbe[2].axis, stPositionProbe[2].dPosition, true, SPEED_LOW);
	}
	
	return nRet;
}

int CMaintControlMgr::GetCmdPos_ProbeX(stMotorPosition* pPos, int iProbe, double dPos, double dGap, BOOL bOffset)
{
	// LYS 2026-08-25 아래 switch는 5슬롯을 쓰고 모든 호출부가 stMotorPosition[5]를 넘긴다.
	// switch가 다루지 않는 프로브 id나 향후 덜 채우는 케이스가 AXIS_X 항목을 남기지 않도록 먼저 비운다.
	ClearMotorPos(pPos, 5);

	double dProbeGap = 0.;
	double fOffsetGap = 2.;
	if (bOffset == TRUE)
	{
		GetInterlockPos(nullptr, nullptr, &dProbeGap);
	}
	else
	{
		fOffsetGap = 0.0;
		dProbeGap = dGap;
	}

	switch (iProbe)
	{
		case df_PROBE_AGING1:
		{
			//Probe Gantry Move 
			pPos[0].axis = AXIS_PROBE_X1;
			pPos[0].dPosition = dPos;
			pPos[1].axis = AXIS_PROBE_X3;
			pPos[1].dPosition = dPos + dProbeGap + fOffsetGap;
			pPos[2].axis = AXIS_PROBE_X5;
			pPos[2].dPosition = dPos + (dProbeGap * 2) + (fOffsetGap * 2);
			pPos[3].axis = AXIS_PROBE_X7;
			pPos[3].dPosition = dPos + (dProbeGap * 3) + (fOffsetGap * 3);
			pPos[4].axis = AXIS_PROBE_X9;
			pPos[4].dPosition = dPos + (dProbeGap * 4) + (fOffsetGap * 4);
			break;
		}
		case df_PROBE_AGING2:
		{
			//Probe Gantry Move 
			pPos[0].axis = AXIS_PROBE_X1;
			pPos[0].dPosition = dPos - dProbeGap - fOffsetGap;
			pPos[1].axis = AXIS_PROBE_X3;
			pPos[1].dPosition = dPos;
			pPos[2].axis = AXIS_PROBE_X5;
			pPos[2].dPosition = dPos + dProbeGap + fOffsetGap;
			pPos[3].axis = AXIS_PROBE_X7;
			pPos[3].dPosition = dPos + (dProbeGap * 2) + (fOffsetGap * 2);
			pPos[4].axis = AXIS_PROBE_X9;
			pPos[4].dPosition = dPos + (dProbeGap * 3) + (fOffsetGap * 3);
			break;
		}
		case df_PROBE_AGING3:
		{
			//Probe Gantry Move 
			pPos[0].axis = AXIS_PROBE_X1;
			pPos[0].dPosition = dPos - (dProbeGap * 2) - (fOffsetGap * 2);
			pPos[1].axis = AXIS_PROBE_X3;
			pPos[1].dPosition = dPos - dProbeGap - fOffsetGap;
			pPos[2].axis = AXIS_PROBE_X5;
			pPos[2].dPosition = dPos;
			pPos[3].axis = AXIS_PROBE_X7;
			pPos[3].dPosition = dPos + dProbeGap + fOffsetGap;
			pPos[4].axis = AXIS_PROBE_X9;
			pPos[4].dPosition = dPos + (dProbeGap * 2) + (fOffsetGap * 2);
			break;
		}
		case df_PROBE_AGING4:
		{
			//Probe Gantry Move 
			pPos[0].axis = AXIS_PROBE_X1;
			pPos[0].dPosition = dPos - (dProbeGap * 3) - (fOffsetGap * 3);
			pPos[1].axis = AXIS_PROBE_X3;
			pPos[1].dPosition = dPos - (dProbeGap * 2) - (fOffsetGap * 2);
			pPos[2].axis = AXIS_PROBE_X5;
			pPos[2].dPosition = dPos - dProbeGap - fOffsetGap;
			pPos[3].axis = AXIS_PROBE_X7;
			pPos[3].dPosition = dPos;
			pPos[4].axis = AXIS_PROBE_X9;
			pPos[4].dPosition = dPos + dProbeGap + fOffsetGap;
			break;
		}
		case df_PROBE_MEAS:
		{
			//Probe Gantry Move 
			pPos[0].axis = AXIS_PROBE_X1;
			pPos[0].dPosition = dPos - (dProbeGap * 4) - (fOffsetGap * 4);
			double dMinPos = 0.;
			dMinPos = GetMinSWLimit(AXIS_PROBE_X1) + 1; 
			if (dMinPos > pPos[0].dPosition)
				pPos[0].dPosition = dMinPos;
			pPos[1].axis = AXIS_PROBE_X3;
			pPos[1].dPosition = dPos - (dProbeGap * 3) - (fOffsetGap * 3);
			dMinPos = GetMinSWLimit(AXIS_PROBE_X3) + 1;
			if (dMinPos > pPos[1].dPosition)
				pPos[1].dPosition = dMinPos;
			pPos[2].axis = AXIS_PROBE_X5;
			pPos[2].dPosition = dPos - (dProbeGap * 2) - (fOffsetGap * 2);
			pPos[3].axis = AXIS_PROBE_X7;
			pPos[3].dPosition = dPos - dProbeGap - fOffsetGap;
			pPos[4].axis = AXIS_PROBE_X9;
			pPos[4].dPosition = dPos;
			break;
		}
	}
	return 0;
}

