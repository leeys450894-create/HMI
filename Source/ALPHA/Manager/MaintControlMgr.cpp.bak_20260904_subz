			nStep = df_POS_DOWN;
		}
	}

	// jsyoon 2022.05.30 for Test
	if (nRet == VTM_RV_SUCCESSED)
	{
		nRet = WaitForLiftPinPosComplete(bUp, PLC_IO_ACTION_DONE_TIME);
	}

	CString strTactTime, strLog;
	dTactEnd = GetTickCount();
	if (dTactEnd >= dTactStart)
