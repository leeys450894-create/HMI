		{
			dMove = EContatZ + dOD;

			stPositionProbeZ[0].dPosition = dMove;
			stPositionProbeZ[1].dPosition = dMove;
			stPositionProbeZ[2].dPosition = dMove;
			stPositionProbeZ[3].dPosition = dMove;
			stPositionProbeZ[4].dPosition = dMove;

