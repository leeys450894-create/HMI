// LYS 2026-08-25 ACS 멀티 이동에는 bUse 검사가 없고 SetSpeed()가 비활성 축에도 성공을
// 반환해, 미장착 축이 자기 HW 맵을 달고 컨트롤러까지 간다. 단순 낭비가 아니다 -
// 비활성 슬롯 일부가 사용 중인 축과 HW 인덱스를 공유하고(PBY3/PBY4 = ACS0 30/31 = Z3/Z4),
// 호출부는 갠트리 수와 무관하게 5슬롯 배열을 만든다. 그래서 미리 걸러낸다.
static int PackUsedAxes(CMotorControlMgr* pMotor, const stMotorPosition* pSrc, int nAxis,
	stMotorPosition* pDst, int nDstMax)
{
	int nUsed = 0;

	for (int i = 0; i < nAxis && nUsed < nDstMax; i++)
	{
		// LYS 2026-08-26 enum 범위 밖 id도 제거. 미초기화 슬롯의 양수 쓰레기값이
		// m_dAlignOffset[axis] 범위 밖 접근(크래시)으로 이어지는 것을 막는다.
		if (pSrc[i].axis < 0 || pSrc[i].axis >= AXIS_TYPE_END)
			continue;

		axis_data_type* pAxisInfo = (pMotor != nullptr) ? pMotor->GetAxisProperty(pSrc[i].axis) : nullptr;
		if (pMotor != nullptr && (pAxisInfo == nullptr || pAxisInfo->bUse == FALSE))
			continue;

		pDst[nUsed++] = pSrc[i];
	}

	return nUsed;
}

// LYS 2026-08-25 stMotorPosition 배열은 5갠트리 기준으로 잡고 필요한 만큼만 채운다.
// ZeroMemory는 나머지를 axis 0 = AXIS_X, 즉 "스테이지 갠트리를 0으로" 라는 유효 지령으로
// 남긴다. AXIS_NONE으로 채우면 PackUsedAxes()가 컨트롤러에 닿기 전에 버린다.
void CMaintControlMgr::ClearMotorPos(stMotorPosition* pPos, int nCount)
{
	if (pPos == nullptr || nCount <= 0)
		return;

	ZeroMemory(pPos, sizeof(stMotorPosition) * nCount);

	for (int i = 0; i < nCount; i++)
	{
		pPos[i].axis = AXIS_NONE;
	}
}


long CMaintControlMgr::MoveCmdPosMulti(stMotorPosition* pPos, int iAxis, int iSpeed, bool bDoneCheck, bool bUseOffset)
{
	// LYS 2026-08-25 see PackUsedAxes above.
	stMotorPosition stPackedPos[AXIS_TYPE_END];
	int nPackedAxis = PackUsedAxes(m_pMotorControlMgr, pPos, iAxis, stPackedPos, _countof(stPackedPos));
	if (nPackedAxis <= 0)
		return df_MOTION_RV_SUCCESSED;
	pPos = stPackedPos;
	iAxis = nPackedAxis;

	// TODO: 여기에 구현 코드 추가.
	long nRet = df_MOTION_RV_ERROR;

	int nAlarm = CAlarmController::GetInstance()->GetAlarmCount();
	if (nAlarm > 0)
	{
		nRet = MOTION_MOVE_ALARM;
	}
	else
	{
		if (m_pIOMapControlMgr != nullptr)
		{
			nRet = m_pIOMapControlMgr->GetMoveInterlock();
		}

		if (nRet == VTM_RV_SUCCESSED)
		{
			if (m_pMotorControlMgr != nullptr)
			{
				if (GetIOMapControlMgrPtr()->IsOutOfService() != true)
				{
					int nBit = 0;
					nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_DOWN01);
					if (nBit != -1)
					{
						if (nBit != 1)
						{
							nRet = MOTION_INTERLOCK_1;
						}
					}

					// jsyoon 2022.06.09 add
					if (nRet == VTM_RV_SUCCESSED)
					{
						nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTOCHANGE_DOWN_01);
						if (nBit != -1)
						{
							if (nBit != 1)
							{
								nRet = MOTION_INTERLOCK_9;
							}
						}
					}
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					if (bUseOffset == false)
					{
						for (size_t i = 0; i < iAxis; i++)
						{
							int axis = 0;
							axis = pPos[i].axis;
							m_pMotorControlMgr->SetHeadOffset(axis, 0);
						}
					}

					int axis = 0;
					double pos = 0;
					for (size_t i = 0; i < iAxis; i++)
					{
						axis = pPos[i].axis;

						pPos[i].dPosition += m_dAlignOffset[axis];


						if (axis == AXIS_PROBE_X1 || axis == AXIS_PROBE_X3 || axis == AXIS_PROBE_X5 || axis == AXIS_PROBE_X7 || axis == AXIS_PROBE_X9)
						{
							pPos[i].dPosition += m_dProbeAlignOffset[0];
						}
						else if (axis == AXIS_PROBE_Y1 || axis == AXIS_PROBE_Y2 || axis == AXIS_PROBE_Y3 || axis == AXIS_PROBE_Y4 || axis == AXIS_PROBE_Y5)
						{
						//	pPos[i].dPosition += m_dProbeAlignOffset[1]; 
							pPos[i].dPosition += (m_dGlassAlignOffset[1] - m_dProbeAlignOffset[1]);	// jsyoon 2022.05.31 change
						}
					}

					nRet = m_pMotorControlMgr->MoveCmdPosMulti(pPos, iAxis, iSpeed, bDoneCheck);
				}
				else
				{
					CString strLog;
					strLog.Format(_T("MoveCmdPosM Fail(AXIS:%d, POS:%.3f, nAXIS:%d, SPPED:%d, RET:%d)"), pPos[0].axis, pPos[0].dPosition, iAxis, iSpeed, nRet);
					m_pMotorControlMgr->GetLogFileAccessorPtr()->KMLOG(WARN, strLog, true);
				}
			}
		}
	}

	return nRet;
}


double CMaintControlMgr::GetCurPos(int iAxis, int iLens, int iTube)
{
	// TODO: 여기에 구현 코드 추가.
	double dRet = 0;

	if (m_pMotorControlMgr != nullptr)
	{
		dRet = m_pMotorControlMgr->GetCurPos(iAxis, iLens, iTube) - m_dAlignOffset[iAxis];

		if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X9 || iAxis == AXIS_PROBE_X10 )
		{
			dRet -= m_dProbeAlignOffset[0];
		}
		else if (iAxis == AXIS_PROBE_Y1 || iAxis == AXIS_PROBE_Y2 || iAxis == AXIS_PROBE_Y3 || iAxis == AXIS_PROBE_Y4 || iAxis == AXIS_PROBE_Y5)
		{
		//	dRet -= m_dProbeAlignOffset[1];
			dRet -= (m_dGlassAlignOffset[1] - m_dProbeAlignOffset[1]);	// jsyoon 2022.05.31 change
		}
	}

	return dRet;
}


