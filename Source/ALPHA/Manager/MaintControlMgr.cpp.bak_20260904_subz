long CMaintControlMgr::MoveCmdPosA(int iAxis, double dPos, bool bBlockMode, int iSpeed, bool bUseOffset, int iLens, int iTube)
{
	// TODO: 여기에 구현 코드 추가.
	long nRet = df_MOTION_RV_ERROR;

	if (iAxis == AXIS_PROBE_X2 || iAxis == AXIS_PROBE_X4 || iAxis == AXIS_PROBE_X6 || iAxis == AXIS_PROBE_X8 || iAxis == AXIS_PROBE_X10)
	{
		return df_MOTION_RV_ERROR;
	}


	if (GetIOMapControlMgrPtr()->IsOutOfService() == true) 
	{
		if (iAxis == AXIS_X)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR03, false);
		}
		if (iAxis == AXIS_X2)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR01, false);
		}
		if (iAxis == AXIS_X3)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_SENSOR02, false);
		}
		if (iAxis == AXIS_Y1)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR01, false);
		}
		if (iAxis == AXIS_Y2)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR02, false);
		}
		if (iAxis == AXIS_Y3)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR03, false);
		}
		if (iAxis == AXIS_Y4)
		{
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_UNLOAD_HEAD_SENSOR04, false);
		}
	}
	

	int nAlarm = 0; // CAlarmController::GetInstance()->GetAlarmCount();
	if (nAlarm > 0)
	{
		nRet = MOTION_MOVE_ALARM;
	}
	else
	{
		if (m_pMotorControlMgr != nullptr)
		{
			if (m_pMotorControlMgr->GetAxisProperty(iAxis)->bUse == TRUE)
			{
				if (m_pIOMapControlMgr != nullptr)
				{
					nRet = m_pIOMapControlMgr->GetMoveInterlock();
				}

				if (nRet == VTM_RV_SUCCESSED)
				{
					int nBit = 0;

					if (GetIOMapControlMgrPtr()->IsOutOfService() != true) // jsyoon 2022.07.06 add
					{
						if (iAxis != AXIS_LOADER_Z)
						{
							nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_DOWN01);
							if (nBit != -1)
							{
								if (nBit != 1)
								{
									nRet = MOTION_INTERLOCK_1;
								}
							}
						}

						if (nRet == VTM_RV_SUCCESSED)
						{
							if (iAxis == AXIS_X || iAxis == AXIS_R)
							{
								nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTO_CHANGE_X0_POSITION_04);
								if (nBit != -1)
								{
									if (nBit != 1)
									{
										nRet = MOTION_INTERLOCK_9;
									}
								}
							}
							else if (iAxis == AXIS_X4 || iAxis == AXIS_LOADER_Z || iAxis == AXIS_Z9)
							{
								nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_UNLOAD_SENSOR03);
								if (nBit != -1)
								{
									if (nBit != 1)
									{
										nRet = MOTION_INTERLOCK_9;
									}
								}
							}
							// jsyoon 2022.06.09 add
							else if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X9)
							{
								nBit = GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTOCHANGE_DOWN_01);
								if (nBit != -1)
								{
									if (nBit != 1)
									{
										nRet = MOTION_INTERLOCK_9;
									}
								}
							}
						}
					}
				}

				if (nRet == VTM_RV_SUCCESSED)
				{
					if (m_pMotorControlMgr != nullptr)
					{
						if (bUseOffset == false)
						{
							m_pMotorControlMgr->SetHeadOffset(iAxis, 0);
						}

						double dMovePos = 0.;

						dMovePos = dPos + m_dAlignOffset[iAxis];

						if (iAxis == AXIS_PROBE_X1 || iAxis == AXIS_PROBE_X3 || iAxis == AXIS_PROBE_X5 || iAxis == AXIS_PROBE_X7 || iAxis == AXIS_PROBE_X9 )
						{
							dMovePos += m_dProbeAlignOffset[0];
						}
						else if (iAxis == AXIS_PROBE_Y1 || iAxis == AXIS_PROBE_Y2 || iAxis == AXIS_PROBE_Y3 || iAxis == AXIS_PROBE_Y4 || iAxis == AXIS_PROBE_Y5)
						{
							//dMovePos += (m_dProbeAlignOffset[1]);
							dMovePos += (m_dGlassAlignOffset[1] - m_dProbeAlignOffset[1]);	// jsyoon 2022.05.31 change
						}

						if (iAxis == AXIS_X)
						{
							int h = 1;
						}
						nRet = m_pMotorControlMgr->MoveCmdPosA(iAxis, dMovePos, bBlockMode, iSpeed, iLens, iTube);
					}
				}
				else
				{
					CString strLog;
					strLog.Format(_T("MoveCmdPosA Fail(AXIS:%s, POS:%.3f, RET:%d)"), m_pMotorControlMgr->GetAxisMapProperty(iAxis)->m_strAxisName, dPos, nRet);
					m_pMotorControlMgr->GetLogFileAccessorPtr()->KMLOG(WARN, strLog, true);
				}
			}
		}
	}

	return nRet;
}


