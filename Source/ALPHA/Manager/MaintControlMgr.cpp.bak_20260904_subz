		// Probe Z 교체 위치 받음
		double dPosProbeZ = 0;
		GetPositionConfigMgr()->GetProbeZChangePos(nullptr, &dPosProbeZ, nullptr);

		// Probe Z Safety
		nRet = MoveCmdPos_ProbeMove(AXIS_ALL_Z, dPosProbeZ, SPEED_HIGH);

		SetProbeAlignXYR(0, 0, 0, iProbe);
	}
	
	// Probe Y
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		stMotorPosition stPositionProbeY[5];
		ZeroMemory(&stPositionProbeY, sizeof(stPositionProbeY));
		stPositionProbeY[0].axis = AXIS_PROBE_Y1;
		stPositionProbeY[0].dPosition = 0;
		stPositionProbeY[1].axis = AXIS_PROBE_Y2;
		stPositionProbeY[1].dPosition = 0;
		stPositionProbeY[2].axis = AXIS_PROBE_Y3;
		stPositionProbeY[2].dPosition = 0;
		stPositionProbeY[3].axis = AXIS_PROBE_Y4;
		stPositionProbeY[3].dPosition = 0;
		stPositionProbeY[4].axis = AXIS_PROBE_Y5;
		stPositionProbeY[4].dPosition = 0;

//		nRet = MoveCmdPosMulti(stPositionProbeY, 5, SPEED_HIGH, true);
		nRet = MoveOrgPosMulti(stPositionProbeY, 5, SPEED_HIGH, true);
	}

	// Probe Gantry(X) Move 
	stMotorPosition stPositionProbeX[5];
	ZeroMemory(&stPositionProbeX, sizeof(stPositionProbeX));

	if (nRet == df_MOTION_RV_SUCCESSED)
	{		
		// Probe Gantry(1~5) Move 
		GetCmdPos_ProbeX(stPositionProbeX, iProbe, dPos, 200, TRUE);

		// 2023.04.05 change
		if (bDoneCheck == true)
		{
			nRet = MoveOrgPosMulti(stPositionProbeX, 5, SPEED_HIGH, true);
			//	nRet = MoveCmdPosMulti(stPositionProbeX, 5, SPEED_HIGH, true);

				// 측정할 Probe Gantry M/S Position 체크
			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				MoveCmdPos_CompareMS(iProbe);

				// 측정할 Probe Offset Move
				nRet = MoveCmdPos_ProbeOffset(iProbe);
			}
		}
		else
		{
			nRet = MoveOrgPosMulti(stPositionProbeX, 5, SPEED_HIGH, false);
		}		
	}

	return nRet;
}

