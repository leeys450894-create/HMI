	return nRet;
}


long CMaintControlMgr::DoWork_RotateMove(double dPos, int nType)
{
	long lRet = VTM_RV_SUCCESSED;
	lRet = MoveCmdPosA(AXIS_LOADER_R, dPos, true);

	if (GetIOMapControlMgrPtr()->IsOutOfService() == true)
	{
		GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_0, false); 
		GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_1, false);
		GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_2, false);
		GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_3, false);

		// LYS 2026-08-07 rotation-change: select degree bit by commanded angle (was caller type index)
		int nDegSel = -1;
		{
			int nDeg = ((int)(fabs(dPos) + 0.5)) % 360;
			if (nDeg == 0) nDegSel = 0;
			else if (nDeg == 90) nDegSel = 1;
			else if (nDeg == 180) nDegSel = 2;
			else if (nDeg == 270) nDegSel = 3;
		}
		switch (nDegSel)
		{
		case 0:	// 0
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_0, true);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_1, false);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_2, false);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_3, false);
			break;
		case 1:	// 90
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_0, false);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_1, true);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_2, false);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_3, false);
			break;
		case 2:	// 180
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_0, false);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_1, false);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_2, true);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_3, false);
			break;
		case 3:	// 270
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_0, false);
			GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_R_MOTION_LOADER_DEGREE_1, false);
