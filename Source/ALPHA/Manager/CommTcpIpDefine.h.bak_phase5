typedef struct {
	int			iCmd;		// 
	int			iActiveID;
	int			iFilter;
	int			iError;
	double		dMotion;
	TCHAR		szModel[100];
}VisMotionPROTOCOL, * PVisMotionPROTOCOL;


// Property
typedef struct
{
	int               cmd;
	int               len;
} req_head;

typedef struct
{
	int		iCmd;
	int		iError;
	int		iCause;
	int		iLen;
	int		iResult;
} response_head;

typedef struct {
	req_head	hrd;
	TCHAR		szModel[32];

	int       Select;					// PG 0x31 : Left    0x32 : Right     0x33 : Left/Right
	int       UseAverageMTPLeft;
	int       UseAverageMTPRight;
	int       Retest;					// 0X30 : Normal, 0x31 : Offline, 0x32 : ReAvt, 0x033 : ReConnect etc Undefined

	TCHAR       InnerID[2][32];
	TCHAR       MCRID[2][32];

}ELPPROTOCOL, * PELPPPROTOCOL;