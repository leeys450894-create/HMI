enum enumTCPIpFactoryt_Event_PG
{
	enumTCPIpFactoryt_PGEvent_0 = 0,  // Model Change
	enumTCPIpFactoryt_PGEvent_1,	  // Model Change Wait, Download Done 대기시간 걸림
	enumTCPIpFactoryt_PGEvent_2,	  // Recipe Change
	enumTCPIpFactoryt_PGEvent_3,	  // Status check

	// PG
	enumTCPIpFactoryt_PGEvent_5,     // Turn On
	enumTCPIpFactoryt_PGEvent_6,     // Pattern Next
	enumTCPIpFactoryt_PGEvent_7,     // Pattern Previous
	enumTCPIpFactoryt_PGEvent_8,     // Turn Off

	// PG1
	enumTCPIpFactoryt_PGEvent_9,	 // Cell Turn On
	enumTCPIpFactoryt_PGEvent_10,	 // Cell Pattern Next
	enumTCPIpFactoryt_PGEvent_11,	 // Cell Pattern Previous
	enumTCPIpFactoryt_PGEvent_12,	 // Cell Turn Off

	// PG2
	enumTCPIpFactoryt_PGEvent_13,	 // Cell Turn On
	enumTCPIpFactoryt_PGEvent_14,	 // Cell Pattern Next
	enumTCPIpFactoryt_PGEvent_15,	 // Cell Pattern Previous
	enumTCPIpFactoryt_PGEvent_16,	 // Cell Turn Off

	// TEST
	enumTCPIpFactoryt_PG_TEST_1,	  // PTP(Pin To Pin Test)
	enumTCPIpFactoryt_PG_TEST_2,	  // OST(Open/short Test)
	enumTCPIpFactoryt_PG_TEST_3,	  // R-TEST
	enumTCPIpFactoryt_PG_TEST_4,	  // AGING
	enumTCPIpFactoryt_PG_TEST_5,	  // TEST STOP

	enumTCPIpFactoryt_PG_TEST_11,	  // PTP(Pin To Pin Test)
	enumTCPIpFactoryt_PG_TEST_12,	  // OST(Open/short Test)
	enumTCPIpFactoryt_PG_TEST_13,	  // R-TEST
	enumTCPIpFactoryt_PG_TEST_14,	  // AGING  // For Ensis PG 

	// TEST Program
	enumTCPIpFactoryt_PG_TP_1,		// TP : 특성검사
	enumTCPIpFactoryt_PG_TP_2,      // TP : 화질검사
	enumTCPIpFactoryt_PG_TP_3,		// TP : 색이상 검사
	enumTCPIpFactoryt_PG_TP_4,		// TP : 시야각 검사
	enumTCPIpFactoryt_PG_TP_5,		// TP : TSP
//	enumTCPIpFactoryt_PG_TP_6,		// TP : LCR

	// CELL Select
	enumTCPIpFactoryt_PG_SET_LEFT,     // CELL Select Left
	enumTCPIpFactoryt_PG_SET_RIGHT,    // CELL Select Right
};

