		// LYS 2026-09-12 CCD 얼라인 카메라 방향이 바뀌어 XYR 보상 부호를 전부 반전. 2026-09-12 16:35 Glass XYZero 실측이 -0.0794→-0.1588→-0.3175 / 0.1436→0.2835→0.5708 로 정확히 2배씩 커지는 1:1 발산(=부호 반대)이었다. 아래 2026-09-05 주석은 방향 변경 전 근거라 참고용으로 남긴다.
		int iDirX = -1, iDirY = 1;	// LYS 2026-09-12 카메라 방향 변경으로 1,-1 -> -1,1 반전
		// LYS 2026-09-05 부호 반전 - 14:33 실측에서 X9/PBY5 모두 측정 오프셋 방향 이동 시 오프셋이 커짐(발산). Probe는 대상(크로스/갠트리)을 움직이므로 Glass(카메라 이동)와 반대 부호
		double dDistanceX = 0., dDistanceY = 0;
		double dX = 0, dY = 0;
		// 
		// Angle 계산
		COORDINATE stBase[2];		// Align Mark 좌표 위치
		COORDINATE stDetect[2];

		// Probe
	//	dY = ((dPixelx[0] + dPixelx[1]) / 2 ) * iDirX;		// PROBE Y
	//	dX = ((dPixely[0] + dPixely[1]) / 2 ) * iDirY;		// PROBE X
		dY = dPixelx[0] * iDirX;		// PROBE Y
		dX = dPixely[0] * iDirY;		// PROBE X	// 2023.04.06 change

	
		/*
		// Save Image
		CString strPath, strSaveImage;
		CString strCellID;
		strCellID = CSystemParamShare::GetInstance()->GetCellID();
		strPath.Format(_T("%s%s%s\\%s\\"), m_pShareItem->GetSystemConfigMgrPtr()->GetLogFilePath(), _T("ALIGN\\"), m_pShareItem->GetRecipeEditMgrPtr()->GetRecipeID(), strCellID);
		MakeDir(strPath);

		strSaveImage.Format(_T("%s%s_%s.png"), strPath, _T("AlignGlassThetaZeroSrc1"), GetCurTimeStr());
		imaqWritePNGFile2(pSnapImageCCD1, CStrToChar(strSaveImage), 750, NULL, FALSE);

		strSaveImage.Format(_T("%s%s_%s.png"), strPath, _T("AlignGlassThetaZeroSrc2"), GetCurTimeStr());
		imaqWritePNGFile2(pSnapImageCCD2, CStrToChar(strSaveImage), 750, NULL, FALSE);
		*/

		// Margin 
		if (nRet == VTM_RV_SUCCESSED)
		{
			CString str;
			str.Format(_T("CDoWorkProbeSWAlignStep, XYZero %d/%d, %.4f, %.4f < %.4f, %.4f"), iReTry + 1, nRetrylimit, dX, dY, dAlignMarginX, dAlignMarginY);
			m_pShareItem->GetLogFileAccessorPtr()->KMLOG(SYST, str);

			if (pImpl->IsOutOfServiceMC() == true)
			{
				bCentered = true;	// LYS 2026-09-05 시뮬 모드는 통과 처리
				break;
			}

			if (fabs(dX) < dAlignMarginX && fabs(dY) < dAlignMarginY)
			{
				bCentered = true;	// LYS 2026-09-05 마진 통과
				break;
			}
			else
			{
				nRet = VISION_ALIGN_CENTERING_FAIL;

				//*pdMovX += dX;
				//*pdMovY += dY;

				// Move
				if (pImpl != nullptr)
				{
					pImpl->MoveOrgPosR(iAxisX, dX, false, SPEED_MID);
					pImpl->MoveOrgPosR(iAxisX + 1, dX, false, SPEED_MID);	// LYS 2026-09-05 슬레이브(X10)도 같은 양 이동 - 마스터만 움직이면 갠트리 한쪽만 이동해 마크가 절반(0.48)만 이동(14:33 실측). 수동 조그(CD_PopUp_Motion_Move nAxis+1)와 동일. TZero 스큐는 보존
					pImpl->MoveOrgPosR(iAxisY, dY, false, SPEED_MID);

					nRet = pImpl->DoWork_MotionDone(iAxisX);
					if (nRet != df_MOTION_RV_SUCCESSED)
					{
						break;
					}
					nRet = pImpl->DoWork_MotionDone(iAxisX + 1);	// LYS 2026-09-05 슬레이브(X10) 완료 대기
					if (nRet != df_MOTION_RV_SUCCESSED)
					{
						break;
					}

					nRet = pImpl->DoWork_MotionDone(iAxisY);
					if (nRet != df_MOTION_RV_SUCCESSED)
					{
						break;
					}

					/*pImpl->MoveOrgPosR(AXIS_PROBE_X9, dX, false, SPEED_MID);
					pImpl->MoveOrgPosR(AXIS_PROBE_Y5, dY, false, SPEED_MID);

					nRet = pImpl->DoWork_MotionDone(AXIS_PROBE_X9);
					if (nRet != df_MOTION_RV_SUCCESSED)
					{
						break;
					}

					nRet = pImpl->DoWork_MotionDone(AXIS_PROBE_Y5);
					if (nRet != df_MOTION_RV_SUCCESSED)
					{
						break;
					}*/
				}
			}
		}

		iReTry++;


	} while (iReTry < nRetrylimit);

	// LYS 2026-09-05 재시도 한도 내에 마진을 못 맞추면 실패로 반환 (구 코드는 마지막 MotionDone 성공이 실패 상태를 지워 발산한 오프셋이 그대로 적용됨)
	if (nRet == VTM_RV_SUCCESSED && bCentered == false)
	{
		nRet = VISION_ALIGN_CENTERING_FAIL;
		m_pShareItem->GetLogFileAccessorPtr()->KMLOG(WARN, _T("Align_ProbeXYZero centering NOT converged within retry limit - align FAIL"));
	}

	if (nRet == VTM_RV_SUCCESSED)
	{
		*pdMovX = pImpl->GetOrgPos(iAxisX) - dStartX;
	//	*pdMovY = pImpl->GetOrgPos(iAxisY) - dStartY;
		*pdMovY = pImpl->GetOrgPos(iAxisY) - dStartY;	// LYS 2026-09-05 잔차(최종-시작)로 복원. jsyoon 2022.08.16의 "- 0"은 절대위치를 반환해 Glass-Probe 차분이 깨짐
		CString strRes;
		strRes.Format(_T("CDoWorkProbeSWAlignStep, XYZero residual X:%.4f (%.3f->%.3f)  Y:%.4f (%.3f->%.3f)"),
			*pdMovX, dStartX, pImpl->GetOrgPos(iAxisX), *pdMovY, dStartY, pImpl->GetOrgPos(iAxisY));
		m_pShareItem->GetLogFileAccessorPtr()->KMLOG(SYST, strRes);

		/**pdMovX = pImpl->GetCurPos(AXIS_PROBE_X9) - dStartX;
		*pdMovY = pImpl->GetCurPos(AXIS_PROBE_Y5) - 0;*/
	}
	else
	{
		CString str;
		str.Format(_T("CDoWorkProbeSWAlignStep, XYZero Fail %d"), nRet);
		m_pShareItem->GetLogFileAccessorPtr()->KMLOG(WARN, str);
	}

	return nRet;
}

int CDoWorkProbeSWAlignStep::Align_Probe()
{
	m_pShareItem->GetLogFileAccessorPtr()->KMLOG(SYST, _T("CDoWorkProbeSWAlignStep_Align_Probe Start."));

	int nRet = VTM_RV_SUCCESSED;
	int iProbe = 0;
	double dMovX = 0, dMovY = 0, dMovR = 0;

	// Probe 확인 
	iProbe = CSequenceManager::GetInstance()->GetFunctionModuleProbeACC()->GetProbe();
	if (iProbe < df_PROBE_AGING1)
	{
		nRet = false;
	}
	else
	{
		//if (m_pShareItem->GetSystemConfigMgrPtr()->IsOCP()) iProbe = df_PROBE_MEAS;		// LYS 2026-08-24 OCP ProbeAlign Init 1-4 Skip
		//if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeExistSensorOn(iProbe) == true)
		{

			CString strLog;
			strLog.Format(_T("Align_Probe Start. %d"), iProbe);
			m_pShareItem->GetLogFileAccessorPtr()->KMLOG(SYST, strLog);

			// ALL Probe Offset Move
			CMaintControlMgr* pImpl = nullptr;
			pImpl = m_pShareItem->GetMaintControlMgrPtr();
			if (pImpl != nullptr)
			{
				if (m_pShareItem->GetMaintControlMgrPtr()->GetShareMemoryMgrPtr()->GetSys_ProbeChange() == 1)
					pImpl->SetProbeAlignXYR(dMovX, dMovY, dMovR, iProbe);
				else
					pImpl->SetProbeAlignXYR(dMovX, dMovY, dMovR, 0);

				nRet = Align_ProbeSearch(iProbe - df_PROBE_AGING1);


				if (m_pShareItem->GetMaintControlMgrPtr()->IsOutOfServiceMC() != true)
				{
					if (m_pShareItem->GetMaintControlMgrPtr()->GetShareMemoryMgrPtr()->GetSys_ProbeChange() == 1)
					{
						if (nRet == VTM_RV_SUCCESSED)
						{
							nRet = Align_ProbeTZero(iProbe - df_PROBE_AGING1, &dMovR);
						}
					}

					if (nRet == VTM_RV_SUCCESSED)
					{
						nRet = Align_ProbeXYZero(iProbe - df_PROBE_AGING1, &dMovX, &dMovY);
					}
				}
				else
				{
					Sleep(500);
				}

				if (nRet == VTM_RV_SUCCESSED)
				{
					// jsyoon 2022.08.16 add
					CString strLog;
					strLog.Format(_T("Align_Probe (XYR:%.4f,%.4f,%.4f)"), dMovX, dMovY, dMovR);
					m_pShareItem->GetLogFileAccessorPtr()->KMLOG(SYST, strLog);

					if (m_pShareItem->GetMaintControlMgrPtr()->GetShareMemoryMgrPtr()->GetSys_ProbeChange() == 1)
						pImpl->SetProbeAlignXYR(dMovX, dMovY, dMovR, iProbe);
					else
						pImpl->SetProbeAlignXYR(dMovX, dMovY, dMovR, 0);

					pImpl->SetProbeAlignDone(true);	// LYS 2026-09-15 Probe Align 완료 표시(타이틀바 파랑)
				}
			}
		}
	}

	m_pShareItem->GetLogFileAccessorPtr()->KMLOG(SYST, _T("CDoWorkProbeSWAlignStep_Align_Probe End."));

	return nRet;
}


