int CDoWorkProbeSWAlignStep::Align_MovePosition(int nHead, int nIndex)
{
	int nRet = df_MOTION_RV_SUCCESSED;

	int nMeasMode = 0;
	int iLampIntensity[2];
	int iExposureTime[2];
	int iCCDGain[2];

	ZeroMemory(&iLampIntensity, sizeof(iLampIntensity));
	ZeroMemory(&iExposureTime, sizeof(iExposureTime));
	ZeroMemory(&iCCDGain, sizeof(iCCDGain));

	S_Align* pAlignInfo = nullptr;
	pAlignInfo = &m_pShareItem->GetRecipeEditMgrPtr()->GetRecipeMgrPtr()->m_sAlign;

	if (pAlignInfo != nullptr)
	{
		iLampIntensity[0] = pAlignInfo->m_sCcdSet.m_sBackLeft.m_nLed;
		iLampIntensity[1] = pAlignInfo->m_sCcdSet.m_sBackRight.m_nLed;

		iExposureTime[0] = pAlignInfo->m_sCcdSet.m_sBackLeft.m_nExposureTime;
		iExposureTime[1] = pAlignInfo->m_sCcdSet.m_sBackRight.m_nExposureTime;

		iCCDGain[0] = pAlignInfo->m_sCcdSet.m_sBackLeft.m_nGain;
		iCCDGain[1] = pAlignInfo->m_sCcdSet.m_sBackRight.m_nGain;
	}


		// Set CCD and Light
	int iCh[2] = { 3, 2 };

	// Probe Change 시 X3 으로 이동
	bool bProbeChange = false;	// jsyoon 2022.05.10 add

	// jsyoon 2022.05.19 add
	if( m_pShareItem->GetMaintControlMgrPtr()->GetShareMemoryMgrPtr()->GetSys_ProbeChange() == 1)
	{
		bProbeChange = true;
	}

	if (bProbeChange == true)	// jsyoon 2022.05.10 add
	{
		iCh[0] = 0;
		iCh[1] = 1;
	}

	CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_CHNG_LAMP, true);

	for (size_t i = 0; i < 2; i++)
	{
		m_pShareItem->GetLightControlMgrPtr()->SetLedLampIntensity(0, iCh[i], iLampIntensity[i]); // SPO
		m_pShareItem->GetAlignCameraMgr(i)->SetParam_CameraExposureTime_ms(iExposureTime[i]);
		m_pShareItem->GetAlignCameraMgr(i)->SetParam_CameraGain(iCCDGain[i]);
	}

	CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_CHNG_LAMP, false);

	// Position
	double dPosX = 0., dPosX2 = 0, dPosY1 = 700, dPosY2 = -700, dPosR = 0, dPosZ = 0;
	double dPosZR = 0., dPosZL = 0.;	// LYS 2026-09-05 Sub Z RIGHT/LEFT(Z3/Z4) 목표 - 구 BACK Z(Z1) 대체
	double dProbeX = 0, dProbeY = 0;

	// LYS 2026-08-24 Move Probe Align Position TEMP
	//if (m_pShareItem->GetMaintControlMgrPtr()->GetIOMapControlMgrPtr()->IsOutOfService() != true)
	{
		dProbeX = pAlignInfo->m_sProbeAlign.m_fProbeY;
		dProbeY = pAlignInfo->m_sProbeAlign.m_fProbeX;

		dPosX2 = pAlignInfo->m_sProbeAlign.m_fBackY;
		dPosY2 = pAlignInfo->m_sProbeAlign.m_fBackRight;
		dPosY1 = pAlignInfo->m_sProbeAlign.m_fBackLeft;
		dPosZ = pAlignInfo->m_sProbeAlign.m_fBackZ;
		dPosZR = pAlignInfo->m_sProbeAlign.m_fSubZRight;	// LYS 2026-09-05 Align 레시피 Sub Z RIGHT(Z3)
		dPosZL = pAlignInfo->m_sProbeAlign.m_fSubZLeft;	// LYS 2026-09-05 Align 레시피 Sub Z LEFT(Z4)
		dPosX = pAlignInfo->m_sProbeAlign.m_fStageY;
	}

	bool bRet = false;
	if (nRet == df_MOTION_RV_SUCCESSED)
	{
		CMaintControlMgr* pImpl = nullptr;
		pImpl = m_pShareItem->GetMaintControlMgrPtr();

		if (pImpl != nullptr)
		{
			// LYS 2026-09-05 AXIS_Z2(FRONT Z) 후퇴 이동 제거 - Probe Align은 Glass Align과 동일하게 X2 / Y1,Y2 / Sub Z(Z3,Z4)만 사용 (AXIS_Z1/Z2 미사용)
			//if (nRet == df_MOTION_RV_SUCCESSED)
			//{
				//if (bProbeChange == true)
				//{
					//double dPos = 0.0;
					//dPos = pImpl->GetMinSWLimit(AXIS_Z2) + 10;
					//if (pImpl->GetCurPos(AXIS_Z2) > dPos )
					//{
						//nRet = pImpl->MoveOrgPosA(AXIS_Z2, dPos, true, SPEED_HIGH, -1, -1);
					//}
				//}
				//else
				//{
					//if (pImpl->GetCurPos(AXIS_Z2) > 0)
					//{
						//nRet = pImpl->MoveOrgPosA(AXIS_Z2, 0, true, SPEED_HIGH, -1, -1);
					//}
				//}
			//}

			// Probe Zero
			if (nRet == VTM_RV_SUCCESSED)
			{
				//for (size_t i = df_PROBE_AGING1; i <= df_PROBE_MEAS; i++)
				//{
				//	bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(i);
				//	if (bRet != true)
				//	{
				//		nRet = MOTION_INTERLOCK_6;
				//		break;
				//	}
				//}
				// LYS 2026-09-05 Probe Align P5만 감지
				bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(df_PROBE_MEAS);
				if (bRet != true)
				{
					nRet = MOTION_INTERLOCK_6;
				}

				if (nRet == MOTION_INTERLOCK_6)
				{
					nRet = pImpl->MoveCmdPos_ProbeMove(AXIS_ALL_Z, 0, SPEED_HIGH);

					if (nRet == VTM_RV_SUCCESSED)
					{
						//for (size_t i = df_PROBE_AGING1; i <= df_PROBE_MEAS; i++)
						//{
						//	bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(i);
						//	if (bRet != true)
						//	{
						//		nRet = MOTION_INTERLOCK_6;
						//		break;
						//	}
						//}
						bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(df_PROBE_MEAS);
						if (bRet != true)
						{
							nRet = MOTION_INTERLOCK_6;
						}
					}
				}
			}

			if (nRet == VTM_RV_SUCCESSED)
			{
				bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsLoaderArmSensorOn();
				if (bRet == true)
				{
					nRet = PLC_ARM_SENSOR_DETECT;
				}
			}

			if (nRet == VTM_RV_SUCCESSED)
			{
				bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsShutterSensorClose();
				if (bRet != true)
				{
					nRet = PLC_LOADER_SHUTTER_UP_ERROR;
				}
			}

			if (nRet == VTM_RV_SUCCESSED)
			{
				//bRet = pImpl->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTO_CHANGE_X0_POSITION_04);

				if (pImpl->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTO_CHANGE_X0_POSITION_03) || pImpl->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_AUTO_CHANGE_X0_POSITION_04))
					bRet = true;
				if (bRet != true)
				{
					nRet = MOTION_INTERLOCK_9;
				}
			}

			if (nRet == VTM_RV_SUCCESSED)
			{
				//for (size_t i = df_PROBE_AGING1; i <= df_PROBE_MEAS; i++)
				//{
				//	bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(i);
				//	if (bRet != true)
				//	{
				//		nRet = MOTION_INTERLOCK_6;
				//		break;
				//	}
				//}

				// LYS 2026-09-05 Probe Align P5만 감지
				bRet = CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeUnContactSensorOn(df_PROBE_MEAS);
				if (bRet != true)
				{
					nRet = MOTION_INTERLOCK_6;
				}
			} 

			if (bProbeChange == true)
			{
				double dChangePos = 0.;	// jsyoon 2022.05.19 add

				// 
				// Probe X, Y Offset 위치 받음
				double dPosProbeOffsetY = 0;
				double dPosProbeOffsetT = 0;
				int nAxis_Probe = AXIS_PROBE_X9;
				int nAxis_Probe2 = AXIS_PROBE_X10;
				int nAxis_ProbeY = AXIS_PROBE_Y5;

				

				int iProbe = CSequenceManager::GetInstance()->GetFunctionModuleProbeACC()->GetProbe();
				if (iProbe < df_PROBE_AGING1)
				{
					nRet = JOB_PROC_ALIGN_ERROR;
				}
				else
				{
					switch (iProbe)
					{
					case df_PROBE_AGING1:
						nAxis_Probe = AXIS_PROBE_X1;
						nAxis_Probe2 = AXIS_PROBE_X2;
						nAxis_ProbeY = AXIS_PROBE_Y1;
						break;
					case df_PROBE_AGING2:
						nAxis_Probe = AXIS_PROBE_X3;
						nAxis_Probe2 = AXIS_PROBE_X3;
						nAxis_ProbeY = AXIS_PROBE_Y2;
						break;
					case df_PROBE_AGING3:
						nAxis_Probe = AXIS_PROBE_X5;
						nAxis_Probe2 = AXIS_PROBE_X6;
						nAxis_ProbeY = AXIS_PROBE_Y3;
						break;
					case df_PROBE_AGING4:
						nAxis_Probe = AXIS_PROBE_X7;
						nAxis_Probe2 = AXIS_PROBE_X8;
						nAxis_ProbeY = AXIS_PROBE_Y4;
						break;
					case df_PROBE_MEAS:
						nAxis_Probe = AXIS_PROBE_X9;
						nAxis_Probe2 = AXIS_PROBE_X10;
						nAxis_ProbeY = AXIS_PROBE_Y5;
						break;
					default:
						break;
					}

					pImpl->SetProbeAlignXYR(0, 0, 0, iProbe);

					pImpl->GetPositionConfigMgr()->GetProbeOffsetPos(iProbe - 1, &dChangePos, &dPosProbeOffsetY, &dPosProbeOffsetT);
				}

				CString strLog;
				strLog.Format(_T("Align_MovePosition Start. %d"), iProbe);
				m_pShareItem->GetLogFileAccessorPtr()->KMLOG(SYST, strLog);

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					double dGantryGap = 0;
					pImpl->GetInterlockPos(&dGantryGap, nullptr, nullptr);

					double dCurX2 = 0;
					dCurX2 = pImpl->GetCurPos(AXIS_X2);

					// jsyoon 2022.05.19 change
					//if (true)
					{
						stMotorPosition stPosition[2];
						ZeroMemory(&stPosition, sizeof(stPosition));

						// << AXIS_X2 << AXIS_X3
						stPosition[0].axis = AXIS_X2;
						//stPosition[0].dPosition = dPosX2;
						stPosition[0].dPosition = pImpl->GetMaxSWLimit(AXIS_X2) - 0.5;

						stPosition[1].axis = AXIS_X3;
						stPosition[1].dPosition = dChangePos;
						
						nRet = pImpl->MoveOrgPosMulti(stPosition, 2, SPEED_HIGH, true);
					}
					//else
					//{
					//	nRet = pImpl->MoveOrgPosA(AXIS_X3, dChangePos, true, SPEED_HIGH, -1, -1);
					//}
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					stMotorPosition stPosition[2];
					ZeroMemory(&stPosition, sizeof(stPosition));
					stPosition[0].axis = AXIS_Y3;
					stPosition[0].dPosition = dPosY1;
					stPosition[1].axis = AXIS_Y4;
					stPosition[1].dPosition = dPosY2;

					nRet = pImpl->MoveOrgPosMulti(stPosition, 2, SPEED_HIGH);
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					nRet = pImpl->MoveOrgPosA(nAxis_ProbeY, 0, true, SPEED_HIGH, -1, -1);
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					double dPos = 0.;
					dPos = pImpl->GetCurPos(nAxis_Probe) - pImpl->GetCurPos(nAxis_Probe2);

					nRet = pImpl->MoveCmdPosR(nAxis_Probe2, dPos, true, SPEED_LOW);
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					// jsyoon 2022.05.19 change
					if (fabs(pImpl->GetCurPos(nAxis_Probe) - dChangePos) > 1)
					{
						// Probe X
						stMotorPosition stPositionProbeX[5];
						pImpl->GetCmdPos_ProbeX(stPositionProbeX, iProbe, dChangePos, 200, TRUE);

						nRet = pImpl->MoveOrgPosMulti(stPositionProbeX, 5, SPEED_HIGH, true);
					}
					else
					{
						nRet = pImpl->MoveOrgPosA(nAxis_Probe, dChangePos, true, SPEED_HIGH, 0, 0);
					}
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					nRet = pImpl->MoveOrgPosA(AXIS_LOADER_R, 0.0, true, SPEED_HIGH, -1, -1);
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					nRet = pImpl->MoveOrgPosA(AXIS_X, 400.0, true, SPEED_HIGH, -1, -1);
				}
			}
			else
			{
				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					stMotorPosition stPosition[2];
					ZeroMemory(&stPosition, sizeof(stPosition));
					stPosition[0].axis = AXIS_Y1;
					stPosition[0].dPosition = dPosY1;
					stPosition[1].axis = AXIS_Y2;
					stPosition[1].dPosition = dPosY2;

					nRet = pImpl->MoveOrgPosMulti(stPosition, 2, SPEED_HIGH);
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					double dProbeGap = 0;
					pImpl->GetInterlockPos(nullptr, nullptr, &dProbeGap);

					if (fabs(pImpl->GetCurPos(AXIS_PROBE_X9) - dProbeX) > 0.1 )  // 2023.04.06 change 0.5 to 0.1
					{
						/*!
						* Probe 이동 개선
						* 이동 전 간격 여유가 있으면 이동 안함
						*/
						double dPosProbe4 = 0;
						dPosProbe4 = pImpl->GetCurPos(AXIS_PROBE_X7);
						if (dProbeX - dProbeGap < dPosProbe4)
						{
							// Probe X
							stMotorPosition stPositionProbeX[5];
							ZeroMemory(&stPositionProbeX, sizeof(stPositionProbeX));
							pImpl->GetCmdPos_ProbeX(stPositionProbeX, df_PROBE_MEAS, dProbeX, 190, FALSE);

							nRet = pImpl->MoveOrgPosMulti(stPositionProbeX, 5, SPEED_HIGH, true);
						}
						else
						{
							if( fabs( dProbeX - pImpl->GetCurPos(AXIS_PROBE_X9) ) < 5 )		// 2023.04.06 add
								nRet = pImpl->MoveOrgPosA(AXIS_PROBE_X9, dProbeX, true, SPEED_LOW, 0, 0);
							else
								nRet = pImpl->MoveOrgPosA(AXIS_PROBE_X9, dProbeX, true, SPEED_HIGH, 0, 0);
						}

						// LYS 2026-09-12 얼라인 실행에서도 저장된 PROBE Y(PBY5, PROBE CROSS)로 먼저 이동한다.
						//   dProbeY(= Align 레시피 m_sProbeAlign.m_fProbeX)를 위에서 읽어만 두고 쓰는 곳이 없어
						//   PROBE CROSS 가 저장 위치로 가지 않았다(MOVE 버튼 경로 MoveCmdAlignPos_Probe 만 이동시켰다).
						//   바로 위 PROBE X9 와 같은 규칙 - 0.1mm 초과일 때만 이동, 5mm 이내면 저속으로 붙인다.
						if (nRet == df_MOTION_RV_SUCCESSED)
						{
							if (fabs(pImpl->GetCurPos(AXIS_PROBE_Y5) - dProbeY) > 0.1)
							{
								if (fabs(dProbeY - pImpl->GetCurPos(AXIS_PROBE_Y5)) < 5)
									nRet = pImpl->MoveOrgPosA(AXIS_PROBE_Y5, dProbeY, true, SPEED_LOW, 0, 0);
								else
									nRet = pImpl->MoveOrgPosA(AXIS_PROBE_Y5, dProbeY, true, SPEED_HIGH, 0, 0);
							}
						}
					}
					

//					if (fabs(pImpl->GetCurPos(AXIS_PROBE_X9) - dProbeX) > 0.5 || fabs(pImpl->GetCurPos(AXIS_PROBE_X7) - dProbeX) <= dProbeGap )
//					{
//						// Probe X
//						stMotorPosition stPositionProbeX[5];
//						ZeroMemory(&stPositionProbeX, sizeof(stPositionProbeX));
//;						pImpl->GetCmdPos_ProbeX(stPositionProbeX, df_PROBE_MEAS, dProbeX, 200, TRUE);
//
//						nRet = pImpl->MoveOrgPosMulti(stPositionProbeX, 5, SPEED_HIGH, true);
//					}
//					else
//					{
//						nRet = pImpl->MoveOrgPosA(AXIS_PROBE_X9, dProbeX, true, SPEED_LOW, 0, 0);
//					}
				}

				if (nRet == df_MOTION_RV_SUCCESSED)
				{
					double dGantryGap = 0;
					pImpl->GetInterlockPos(&dGantryGap, nullptr, nullptr);

					double dCurX3 = 0;
					dCurX3 = pImpl->GetCurPos(AXIS_X3);

					if ((dPosX2 - dGantryGap) < dCurX3)
					{
						stMotorPosition stPosition[2];
						ZeroMemory(&stPosition, sizeof(stPosition));

						stPosition[0].axis = AXIS_X2;
						stPosition[0].dPosition = dPosX2;
						stPosition[1].axis = AXIS_X3;
						stPosition[1].dPosition = pImpl->GetMinSWLimit(AXIS_X2) - (dGantryGap + 50); // dPosX2 - dGantryGap;	// jsyoon 2022.06.07 change
						nRet = pImpl->MoveOrgPosMulti(stPosition, 2, SPEED_HIGH);
					}
					else
					{
						nRet = pImpl->MoveOrgPosA(AXIS_X2, dPosX2, false, SPEED_HIGH, -1, -1);
					}
				}
			}

			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				for (int iAxis = AXIS_X; iAxis < AXIS_TYPE_END; iAxis++)
				{
					if (iAxis == AXIS_X)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP2, false);
					}
					else if (iAxis == AXIS_X2)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP5, false);
					}
					else if (iAxis == AXIS_X3)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);
					}
					else if (iAxis == AXIS_Y1)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP3, false);
					}
					else if (iAxis == AXIS_Y2)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP4, false);
					}
					else if (iAxis == AXIS_Y3)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP3, false);
					}
					else if (iAxis == AXIS_Y4)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP4, false);
					}
					else if (iAxis == AXIS_PROBE_X9)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP4, false);
					}
					else if (iAxis == AXIS_PROBE_Y5)
					{
						nRet = pImpl->DoWork_MotionDone(iAxis);

			//			CMCCLogMgr::GetInstance()->SetMCC_Action(MCC_A_PROC_ALIGN_MOVE_STEP4, false);
					}

					if (nRet != df_MOTION_RV_SUCCESSED)
					{
						break;
					}
				}
			}

			// LYS 2026-09-05 분기 없이 Sub Z RIGHT/LEFT(Z3/Z4) 이동 - Glass Align과 동일(갠트리 MotionDone 후 하강). AXIS_Z1/Z2 미사용
			if (nRet == df_MOTION_RV_SUCCESSED)
			{
				nRet = pImpl->MoveOrgPosA(AXIS_Z3, dPosZR, true, SPEED_HIGH, -1, -1);	// LYS 2026-09-05 Sub Z RIGHT(Z3)
				if (nRet == df_MOTION_RV_SUCCESSED) nRet = pImpl->MoveOrgPosA(AXIS_Z4, dPosZL, true, SPEED_HIGH, -1, -1);	// LYS 2026-09-05 Z3 성공 시 Sub Z LEFT(Z4)
			}
		}
	}

	return nRet;
}

int CDoWorkProbeSWAlignStep::Align_ProbeSearch(int iProbe)
{
	int nRet = df_MOTION_RV_SUCCESSED;
	float Score = 1.0;
	float MaxSorce = -1;
	int iPtrn[2] = { -1, -1 };
	CPtrnInfo ptrnInfo[df_MAX_PTRNINFO];
	for (size_t i = 0; i < df_MAX_PTRNINFO; i++)
	{
		ptrnInfo[i].ClearInfo();
	}

