bool CCommTcpIpObjectWAD::WaitInspectionComplete(DWORD dwTimeOut, int nRetry)
{
	if (IsOutOfService() == true)
		return true;

	int nRet = VTM_RV_SUCCESSED;
	CString strLog;
	if (nRet == VTM_RV_SUCCESSED)
	{
		HANDLE hRecvEvent3[2] = { m_hRecvDEvent[enumRecvEventID_INSP_COMPLETE_OK], m_hRecvDEvent[enumRecvEventID_INSP_COMPLETE_NG] };
		DWORD dw3 = WaitForMultipleObjects(2, hRecvEvent3, FALSE, dwTimeOut * 1000);
		if (dw3 == WAIT_TIMEOUT) // Start Event 가 set될 때까지 기다린다.
		{
			strLog.Format(_T("[%s] : WaitInspectionComplete, %s"), GetName(), _T("HEAD_ACK_TIMEOUT"));
			m_pLogFileAccessor->KMLOG(WARN, strLog);
			CAlarmController::GetInstance()->SetAlarm(HEAD_ACK_TIMEOUT + m_iAlarmIndex);
			nRet = HEAD_ACK_FAIL;
		}
		else if (dw3 == (WAIT_OBJECT_0 + 1)) // NG
		{
			strLog.Format(_T("[%s] : WaitInspectionComplete, %s"), GetName(), _T("HEAD_ACK_FAIL"));
			m_pLogFileAccessor->KMLOG(WARN, strLog);
			CAlarmController::GetInstance()->SetAlarm(HEAD_ACK_FAIL + m_iAlarmIndex);
			nRet = HEAD_ACK_FAIL;
		}
		else
		{
			TossResultFile(m_pShareMemory->GetSharedMemory()->stLotInfo.m_szInnerID[0], m_pCommTcpIpFactoryMgr->m_nAreaNum[0], 0, nRetry);
			nRet = VTM_RV_SUCCESSED;
		}
	}

	//if (nRet == VTM_RV_SUCCESSED)
	//{
	//	HANDLE hRecvEvent4[2] = { m_hRecvDEvent[enumRecvEventID_INSP2_COMPLETE_OK], m_hRecvDEvent[enumRecvEventID_INSP2_COMPLETE_NG] };
	//	DWORD dw4 = WaitForMultipleObjects(2, hRecvEvent4, FALSE, dwTimeOut * 1000);
	//	if (dw4 == WAIT_TIMEOUT) // Start Event 가 set될 때까지 기다린다.
	//	{
	//		strLog.Format(_T("[%s] : WaitInspectionComplete2, %s"), GetName(), _T("HEAD_ACK_TIMEOUT"));
	//		m_pLogFileAccessor->KMLOG(WARN, strLog);
	//		CAlarmController::GetInstance()->SetAlarm(HEAD_ACK_TIMEOUT + m_iAlarmIndex);
	//		nRet = HEAD_ACK_FAIL;
	//	}
	//	else if (dw4 == (WAIT_OBJECT_0 + 1)) // NG
	//	{
	//		strLog.Format(_T("[%s] : WaitInspectionComplete2, %s"), GetName(), _T("HEAD_ACK_FAIL"));
	//		m_pLogFileAccessor->KMLOG(WARN, strLog);
	//		CAlarmController::GetInstance()->SetAlarm(HEAD_ACK_FAIL + m_iAlarmIndex);
