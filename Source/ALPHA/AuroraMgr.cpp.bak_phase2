		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pAlignMatrixMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pCIMControlMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pVCRControlMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pLightControlMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pPatternMatchMgr));
	//	m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pMotorControlMgr));
	//	m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pIOMapControlMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pMaintControlMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pResultCollectMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pRecipeEditMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pLockCtrlMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pPositionConfigMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pNetworkConfigMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pSystemConfigMgr));
