CAuroraMgr::~CAuroraMgr(void)
{
    ::timeEndPeriod(1);

	//----------------------------------------------------------------------------------------------
	// 다이얼로그 부터 삭제 한다. 통신 연결 상태 메시지나 POSTMESSAGE 가 Dialog 에 전달하는 경우를 해결하기 위함.
	//----------------------------------------------------------------------------------------------

	for (size_t n = 0; n < m_subDlg.size(); ++n)
	{
		if (m_subDlg[n])
		{
			delete m_subDlg[n];
			m_subDlg[n] = nullptr;
		}
	}
	m_subDlg.clear();

	for (size_t i = 0; i < m_subMgr.size(); ++i)
    {
		ULONGLONG dwStart = GetTickCount();

        if (m_subMgr[i])
        {
            m_subMgr[i]->Finalize();
            delete m_subMgr[i];
            m_subMgr[i] = nullptr;
        }

		TRACE("Finalize %d, %d\n", i, GetTickCount() - dwStart);
    }
	m_subMgr.clear();


	CWindowEventHandler::GetInstance()->DelInstance();
    CSystemParamShare::GetInstance()->DelInstance();
    CSequenceManager::GetInstance()->DelInstance();    
	CLogWrapper::GetInstance()->DelInstance();
	CSACCMgr::GetInstance()->DelInstance();
	CResultMgr::GetInstance()->DelInstance();
	CMCCLogMgr::GetInstance()->DelInstance();
	CRecipeMgr::GetInstance()->DelInstance();

	// LYS 2026-07-03 Resume inspection cleanup
	if (m_AuroraMgrPool.pResumeInfoMgr) { delete m_AuroraMgrPool.pResumeInfoMgr; m_AuroraMgrPool.pResumeInfoMgr = nullptr; }
}

void CAuroraMgr::Finalize()
{
	ULONGLONG dwStart = GetTickCount();
	GetMaintControlMgr()->GetIOMapControlMgrPtr()->DisConnect(); // 2023.03.07 add
	GetCommTcpIpFactoryMgrPtr()->DisConnect();	// jsyoon 20211130 add

	//m_AuroraMgrPool.pCommTcpIpFactoryMgr->DisConnect();
	TRACE("Finalize %d\n", GetTickCount() - dwStart); 

	//m_AuroraMgrPool.pIOMapControlMgr->DisConnect();;

	/*for (size_t i = 0; i < m_subMgr.size(); ++i)
	{
		ULONGLONG dwStart = GetTickCount();
		if (m_subMgr[i])
		{
			m_subMgr[i]->Finalize();
		}

		TRACE("Finalize %d, %d\n", i, GetTickCount() - dwStart);
	}*/
}

void CAuroraMgr::Notify(UINT nID, UINT msgID, WPARAM wp, LPARAM lp)
{
    if ((int)m_subDlg.size() <= 0) return;
    if (!m_subDlg[nID] || !m_subDlg[nID]->GetSafeHwnd()) return;

    m_subDlg[nID]->PostMessage(msgID, wp, lp);
}

void CAuroraMgr::Notify_Direct(UINT nID, UINT msgID, WPARAM wp, LPARAM lp)
{
    if ((int)m_subDlg.size() <= 0) return;
    if (!m_subDlg[nID] || !m_subDlg[nID]->GetSafeHwnd()) return;

    m_subDlg[nID]->SendMessage(msgID, wp, lp);
}

void CAuroraMgr::PushSubDlg(int nID, CWnd *pWnd)
{
    m_subDlg[nID] = pWnd;
}

int CAuroraMgr::GetSubMgrCount() const
{
    return (int)m_subMgr.size();
}

CAuroraSubMgr *CAuroraMgr::GetSubMgrPtr(int index)
{
    return m_subMgr[index];
}

int CAuroraMgr::GetSubDlgCount() const
{
    return (int)m_subDlg.size();
}

CWnd *CAuroraMgr::GetSubDlgPtr(int index)
{
    return m_subDlg[index];
}

void CAuroraMgr::ChangeDlgView(int nID)
{
	if ((int)m_subDlg.size() <= 0) return;
	if (!m_subDlg[nID] || !m_subDlg[nID]->GetSafeHwnd()) return;
	
	for (int n = enumWndID_FRAME; n < enumWndIDCount; n++)
    {
		if (m_subDlg[n])
		{
			m_subDlg[n]->ShowWindow(SW_HIDE);
		}
    }

	m_subDlg[nID]->ShowWindow(SW_SHOW);
}

CString CAuroraMgr::GetVersionInfo(CString strAppName)
{
	CString		csRet;
	CString     szVersion, szString;
	szVersion.Empty();

	// 파일버전 정보를 읽기위한 버퍼크기 결정
	CString strAppPath;

	TCHAR szBuff[_MAX_PATH];
	memset(szBuff, 0, MAX_PATH);
	::GetModuleFileName(::AfxGetApp()->m_hInstance, szBuff, _MAX_PATH);
	TCHAR* pch = _tcsrchr(szBuff, _T('\\'));
	strAppPath = CString(szBuff, pch - szBuff + 1);

	DWORD dummy;
	CString strFilePath;
	strFilePath.Format(_T("%s%s.exe"), strAppPath, strAppName);

	DWORD dwSize = GetFileVersionInfoSize(strFilePath, &dummy);
	if (dwSize == 0)
	{
		TRACE("GetFileVersionInfoSize failed with error %d\n", GetLastError());
		return szVersion;
	}

	BYTE*	pData = new BYTE[dwSize];
	// 파일버전 정보 읽기
	//	if ( !GetFileVersionInfo( (LPSTR)(LPCTSTR)strFilePath, NULL, dwSize, pData ) )
	if (!GetFileVersionInfo(strFilePath, NULL, dwSize, pData))
	{
		TRACE("GetFileVersionInfo failed with error %d\n", GetLastError());
		delete[] pData;	//	jsyoon 20180221 delete pData; -> delete [] pData;
		return szVersion;
	}

	// 파일버전 정보를 읽기위한 변수설정 ( 파일버전 정보는 언어 리소스별로 구분되어 저장됨. )
	LPVOID pvProductVersion = NULL;
	LPVOID pvFileVersion = NULL;
	struct LANGANDCODEPAGE
	{
		WORD wLanguage;
		WORD wCodePage;
	} *lpTranslate;

	UINT		cbTranslate;
	CString		strSubBlock;
	VerQueryValue(pData, _T("\\VarFileInfo\\Translation"), (LPVOID*)&lpTranslate, (PUINT)&cbTranslate);

	// 파일버전 정보에서 첫번째 언어에 해당하는 data를 읽어옴
	// 다중언어 리소스에서는 정확한 동작을 위해서는 data를 읽기 전에 언어코드, 코드페이지 정보를 지정하여야 함.
	// 버전에 관한 언어, 코드페이지 정보는 리소스파일의 "Block Header"에 기입되어 있음.

	strSubBlock.Format(_T("\\StringFileInfo\\%04x%04x\\ProductVersion"), lpTranslate[0].wLanguage, lpTranslate[0].wCodePage);
	if (!VerQueryValue(pData, strSubBlock, &pvProductVersion, (PUINT)&dummy))
		//	if ( !VerQueryValue(pData, (LPSTR)(LPCTSTR)strSubBlock, &pvProductVersion, (PUINT)&dummy) )
	{
		TRACE("Can't obtain ProductVersion from resources\n");
		delete[] pData;	//	jsyoon 20180221 delete pData; -> delete [] pData;
		return szVersion;
	}

	strSubBlock.Format(_T("\\StringFileInfo\\%04x%04x\\FileVersion"), lpTranslate[0].wLanguage, lpTranslate[0].wCodePage);
	if (!VerQueryValue(pData, strSubBlock, &pvFileVersion, (PUINT)&dummy))
		//	if ( !VerQueryValue(pData, (LPSTR)(LPCTSTR)strSubBlock, &pvFileVersion, (PUINT)&dummy) )
	{
		TRACE("Can't obtain FileVersion from resources\n");
		delete[] pData;	//	jsyoon 20180221 delete pData; -> delete [] pData;
		return szVersion;
	}

	szVersion = (LPCTSTR)pvFileVersion;
	delete[] pData;	//	jsyoon 20180221 delete pData; -> delete [] pData;

	return szVersion;
}

CString CAuroraMgr::GetCompiledDate(int nType)
{
	CString temp_str;
	CString year, month, date, time;

	char* temp_chr = __DATE__;   
	temp_str = temp_chr;

	year = temp_str.Right(4);
	date = temp_str.Mid(temp_str.GetLength() - 7, 2);
	month = temp_str.Left(3);

	if (month == _T("Jan"))
	{
		month = _T(" 1");
	}
	else if (month == _T("Feb"))
	{
		month = _T(" 2");
	}
	else if (month == _T("Mar"))
	{
		month = _T(" 3");
	}
	else if (month == _T("Apr"))
	{
		month = _T(" 4");
	}
	else if (month == _T("May"))
	{
		month = _T(" 5");
	}
	else if (month == _T("Jun"))
	{
		month = _T(" 6");
	}
	else if (month == _T("Jul"))
	{
		month = _T(" 7");
	}
	else if (month == _T("Aug"))
	{
		month = _T(" 8");
	}
	else if (month == _T("Sep"))
	{
		month = _T(" 9");
	}
	else if (month == _T("Oct"))
	{
		month = _T("10");
	}
	else if (month == _T("Nov"))
	{
		month = _T("11");
	}
	else if (month == _T("Dec"))
	{
		month = _T("12");
	}
	else
	{
		month = _T("xx");
	}

	CString date_str;

	if(nType == 0)
		date_str.Format(_T("%s.%s.%s"), year, month, date);
	else
		date_str.Format(_T("%04d%02d%02d"), _ttoi(year), _ttoi(month), _ttoi(date));

	return date_str;
}