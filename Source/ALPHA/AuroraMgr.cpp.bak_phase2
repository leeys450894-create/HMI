CAuroraMgr::CAuroraMgr(CString strName, CString strAppPath, CString strConfigPath, CString strRecipePath, CString strLogPath)
{
    ::timeBeginPeriod(1);

	CString strVersion;
	CString strAppName, strResultPath;
	strAppName.Format(_T("%s"), AfxGetAppName());
	strVersion.Format(_T("%s(%s)"), GetVersionInfo(strAppName), GetCompiledDate());

	m_systemInfo.name	 = strName; //  _T("UTG");
	m_systemInfo.version = strVersion; //  _T("1.0.1 (21.05.24)");
	m_loginInfo.level						= _T("operator");
	m_loginInfo.user						= _T("user1");
	
	// 환경 변수 관련
	m_AuroraMgrPool.strAppPath				= strAppPath;
	m_AuroraMgrPool.strConfigPath			= strConfigPath;
	

	//// 환경 설정 관련
	m_AuroraMgrPool.pSystemConfigMgr		= new CSystemConfigMgr(strConfigPath);

	strRecipePath.Format(_T("%s\\Recipe\\"), GetSystemConfigMgrPtr()->GetRecipePath());
	strLogPath.Format(_T("%s\\Logs\\"), GetSystemConfigMgrPtr()->GetLogFilePath());
	strResultPath.Format(_T("%s\\"), GetSystemConfigMgrPtr()->GetResultFilePath());


	strRecipePath.Replace(_T("\\\\"), _T("\\"));
	strLogPath.Replace(_T("\\\\"), _T("\\"));
	strResultPath.Replace(_T("\\\\"), _T("\\"));

	m_AuroraMgrPool.strRecipePath = strRecipePath;
	m_AuroraMgrPool.strLogPath = strLogPath;

	CSystemParamShare::GetInstance()->SetLoggerFolderPath(strLogPath);
	CSystemParamShare::GetInstance()->SetResultFolderPath(strResultPath);

	MakeDir(strLogPath);
	MakeDir(strRecipePath);
	MakeDir(strRecipePath + STR_DIR_PATTERN);
	MakeDir(strResultPath);

	//--------------------------------------------------------------------------------
	// LOG configuration
	//--------------------------------------------------------------------------------
	CString logFile, OlogFile;
//	logFile.Format(_T("%s%s.log"), strLogPath.GetString(), AfxGetAppName());
	logFile.Format(_T("%s%s.log"), strLogPath.GetString(), strName);
	OlogFile.Format(_T("%s%s.log"), strLogPath.GetString(), _T("OLOG"));
	CLogWrapper::GetInstance()->Initialize(logFile, OlogFile, 0, 0, strName);

	// Login
	m_AuroraMgrPool.pLogInControlMgr		= new CLogInControlMgr(strConfigPath);
    
	if (true)
	{
		// Review CCD
		for (size_t i = 0; i < MAIN_CCD_MAX_NUM; i++)
		{
			m_AuroraMgrPool.pAlignCameraMgr[i] = new CAlignCameraMgr(strConfigPath, strRecipePath, strResultPath, i);
		}

		// Config
		m_AuroraMgrPool.pNetworkConfigMgr = new CNetworkConfigMgr(strConfigPath);
		m_AuroraMgrPool.pPositionConfigMgr = new CPositionConfigMgr(strConfigPath);

		// Recipe
		m_AuroraMgrPool.pRecipeEditMgr = new CRecipeEditMgr(m_AuroraMgrPool);

		// Share Memory
		m_AuroraMgrPool.pShareMemoryMgr = new CShareMemoryMgr(strAppPath, strConfigPath);

		//// 제어/시퀀스 관련
		m_AuroraMgrPool.pLightControlMgr = new CLightControlMgr(strAppPath, strConfigPath, strLogPath);
		m_AuroraMgrPool.pIOMapControlMgr = new CIOMapControlMgr(strAppPath, strConfigPath, strLogPath);
		m_AuroraMgrPool.pMotorControlMgr = new CMotorControlMgr(strAppPath, strConfigPath, strLogPath);
		m_AuroraMgrPool.pMaintControlMgr = new CMaintControlMgr(m_AuroraMgrPool.pMotorControlMgr, m_AuroraMgrPool.pIOMapControlMgr, m_AuroraMgrPool.pPositionConfigMgr, m_AuroraMgrPool.pLightControlMgr, m_AuroraMgrPool.pShareMemoryMgr);

		// LYS 2026-07-03 Resume inspection manager
		m_AuroraMgrPool.pResumeInfoMgr = new CResumeInfoMgr(strConfigPath);

		m_AuroraMgrPool.pResumeInfoMgr->SetExpireHours(m_AuroraMgrPool.pSystemConfigMgr->GetResumeExpireHours());

		// LYS 2026-06-26 OCP mode: disable unused probe axes
		if (m_AuroraMgrPool.pSystemConfigMgr->IsOCP())
		{
			m_AuroraMgrPool.pMotorControlMgr->DisableAxesForOCP();
		}

		//// 특수 목적 관련
		m_AuroraMgrPool.pSeqTactTimeMgr  = new CSeqTactTimeMgr(strLogPath);		  // Tact time
		m_AuroraMgrPool.pAlarmMonitorMgr = new CAlarmMonitorMgr(m_AuroraMgrPool); // Alarm Monitor

		//// 통신 device 관련
		m_AuroraMgrPool.pCommTcpIpFactoryMgr = new CCommTcpIpFactoryMgr(m_AuroraMgrPool);

		m_AuroraMgrPool.pCommTcpIPMgr        = new CCommTcpIPMgr(m_AuroraMgrPool);

		//
		m_subMgr.clear();
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pCommTcpIPMgr));			// 0
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pAlarmMonitorMgr));			// 1
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pCommTcpIpFactoryMgr));		// 2
	//	m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pAlarmMonitorMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pSeqTactTimeMgr));			// 3
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pShareMemoryMgr));			// 4

		for (size_t i = 0; i < MAIN_CCD_MAX_NUM; i++)
		{
			m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pAlignCameraMgr[i]));	// 5,6,7,8
		}

		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pLightControlMgr));			// 9
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pMaintControlMgr));			// 10

		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pRecipeEditMgr));			// 11
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pPositionConfigMgr));		// 12
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pNetworkConfigMgr));		// 13

		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pSystemConfigMgr));			// 14
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pLogInControlMgr));			// 15
	}
	else
	{
		// Review CCD
		for (size_t i = 0; i < MAIN_CCD_MAX_NUM; i++)
		{
			m_AuroraMgrPool.pAlignCameraMgr[i] = new CAlignCameraMgr(strConfigPath, strRecipePath, strResultPath, i);
		}

		m_AuroraMgrPool.pNetworkConfigMgr = new CNetworkConfigMgr(strConfigPath);
		m_AuroraMgrPool.pPositionConfigMgr = new CPositionConfigMgr(strConfigPath);
		//m_AuroraMgrPool.pLockCtrlMgr			= new CLockControlMgr(m_AuroraMgrPool);
		m_AuroraMgrPool.pRecipeEditMgr = new CRecipeEditMgr(m_AuroraMgrPool);
		//m_AuroraMgrPool.pResultCollectMgr		= new CResultCollectMgr(m_AuroraMgrPool);

		m_AuroraMgrPool.pShareMemoryMgr = new CShareMemoryMgr(strAppPath, strConfigPath);

		//// 제어/시퀀스 관련
		m_AuroraMgrPool.pLightControlMgr = new CLightControlMgr(strAppPath, strConfigPath, strLogPath);
		m_AuroraMgrPool.pIOMapControlMgr = new CIOMapControlMgr(strAppPath, strConfigPath, strLogPath);
		m_AuroraMgrPool.pMotorControlMgr = new CMotorControlMgr(strAppPath, strConfigPath, strLogPath);
		m_AuroraMgrPool.pMaintControlMgr = new CMaintControlMgr(m_AuroraMgrPool.pMotorControlMgr, m_AuroraMgrPool.pIOMapControlMgr, m_AuroraMgrPool.pPositionConfigMgr, m_AuroraMgrPool.pLightControlMgr, m_AuroraMgrPool.pShareMemoryMgr);

		//	m_AuroraMgrPool.pIOMapControlMgr		= new CIOMapControlMgr(strConfigPath, strLogPath, strLogPath);
		//	m_AuroraMgrPool.pMotorControlMgr		= new CMotorControlMgr(strAppPath, strConfigPath, strLogPath, m_AuroraMgrPool.pIOMapControlMgr);
			//m_AuroraMgrPool.pPatternMatchMgr		= new CPatternMatchMgr(strAppPath, strConfigPath);

			//m_AuroraMgrPool.pVCRControlMgr			= new CVCRControlMgr(strAppPath, strConfigPath);
			//m_AuroraMgrPool.pCIMControlMgr			= new CCIMControlMgr(strAppPath, strConfigPath);
			//m_AuroraMgrPool.pAlignMatrixMgr			= new CAlignMatrixMgr(strAppPath, strConfigPath);

			//m_AuroraMgrPool.pReviewCameraHead1Mgr	= new CReviewCameraHead1Mgr(strAppPath, strConfigPath);
			//m_AuroraMgrPool.pReviewCameraHead2Mgr	= new CReviewCameraHead2Mgr(strAppPath, strConfigPath);

			//m_AuroraMgrPool.pMeasureItemMgr			= new CMeasureItemMgr(strConfigPath);	
			//m_AuroraMgrPool.pVisionConfigMgr		= new CVisionConfigMgr(strConfigPath);

			//// 특수 목적 관련
		m_AuroraMgrPool.pSeqTactTimeMgr = new CSeqTactTimeMgr(strLogPath);
		m_AuroraMgrPool.pAlarmMonitorMgr = new CAlarmMonitorMgr(m_AuroraMgrPool);

		//// 통신 device 관련
		m_AuroraMgrPool.pCommTcpIpFactoryMgr = new CCommTcpIpFactoryMgr(m_AuroraMgrPool);

		m_AuroraMgrPool.pCommTcpIPMgr = new CCommTcpIPMgr(m_AuroraMgrPool);
		//m_AuroraMgrPool.pSensorMonitorMgr		= new CSensorMonitorMgr(m_AuroraMgrPool);

		m_subMgr.clear();
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pCommTcpIPMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pCommTcpIpFactoryMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pAlarmMonitorMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pSeqTactTimeMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pSensorMonitorMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pMeasureItemMgr));
		m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pShareMemoryMgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pReviewCameraHead1Mgr));
		//m_subMgr.push_back(dynamic_cast<CAuroraSubMgr*>(m_AuroraMgrPool.pReviewCameraHead2Mgr));

		for (size_t i = 0; i < MAIN_CCD_MAX_NUM; i++)
