void CDlgSubAlarm::OnShowWindow(BOOL bShow, UINT nStatus)
{
	CMainSubDlgWin::OnShowWindow(bShow, nStatus);


	// TODO: 여기에 메시지 처리기 코드를 추가합니다.
	if (bShow == FALSE)
	{
		if (CAlarmController::GetInstance()->GetAlarmWnd())
		{
			CAlarmController::GetInstance()->GetAlarmWnd()->ShowWindow(SW_HIDE);
		}

		if (CAlarmController::GetInstance()->GetReportAlarmWnd())
		{
			CAlarmController::GetInstance()->GetReportAlarmWnd()->ShowWindow(SW_HIDE);
		}
	}
}

LRESULT CDlgSubAlarm::OnAlarmOccured(WPARAM wp, LPARAM lp)
{
	UINT id = (UINT)wp;

	CString str;
	CAlarmController::GetInstance()->GetAlarmText(id, str);
	CLogWrapper::GetInstance()->KMLOG(WARN, _T("***** ALARM OCCURED [ ") + str + _T(" ] *****"));


	// LYS 2026-07-20 CIM Alarm not-report: skip SendAlarmCode, do stop+AT0 instead
	if (m_pAuroraMgr->GetSystemConfigMgrPtr()->IsUseCIMAlarmNotReport() == true)
	{
		if (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() == df_HOST_ONLINE_REMOTE)
		{
			CIMAlarmReportInfo(id);
		}
		else
		{
#ifdef _USE_IOBOARD
			m_pAuroraMgr->GetIOMapControlMgrPtr()->SetMemoryBitToDevice(IO_BOARD_READ_OUTPUT_000, true);
#else
			m_pAuroraMgr->GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_EQ_BUZZER, true);
#endif
		}

		//GetParent()->SendMessage(WM_MSG_UPDATE_CHANGE_VIEW_STATE, (WPARAM)enumNavigateID_ALARM, NULL);
		//CMCCLogMgr::GetInstance()->SetMCC_Alarm(id, TRUE);
		return 0;
	}


	if (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() != df_HOST_ONLINE_REMOTE &&
		m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() != df_HOST_ONLINE_LOCAL)
	{
		// Buzzer on 시킨다.
#ifdef _USE_IOBOARD
		m_pAuroraMgr->GetIOMapControlMgrPtr()->SetMemoryBitToDevice(IO_BOARD_READ_OUTPUT_000, true);
#else
		m_pAuroraMgr->GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_EQ_BUZZER, true);
#endif // _USE_IOBOARD
	}
	else
	{
		m_pAuroraMgr->GetCommTcpIpFactoryMgrPtr()->GetCommTcpIpObjectCIM()->SendAlarmCode(id);
	}


	// 알람이 발생하였으니 ReportAlarm 창을 표시하지 않는다.
	GetParent()->SendMessage(WM_MSG_UPDATE_CHANGE_VIEW_STATE, (WPARAM)enumNavigateID_ALARM, NULL);

	CMCCLogMgr::GetInstance()->SetMCC_Alarm(id, TRUE);

//	m_pAuroraMgr->GetIOMapControlMgrPtr()->SetSinalTowerAlarm();

	return 0;
}

LRESULT CDlgSubAlarm::OnAlarmCleared(WPARAM wp, LPARAM lp)
{
	UINT id = (UINT)wp;

	CString str;
	CAlarmController::GetInstance()->GetAlarmText(id, str);
	CLogWrapper::GetInstance()->KMLOG(WARN, _T("***** ALARM CLEARED() [ ") + str + _T(" ] *****"));

	if (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() != df_HOST_ONLINE_REMOTE &&
		m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() != df_HOST_ONLINE_LOCAL)
	{
		// Buzzer off 시킨다.
#ifdef _USE_IOBOARD
		m_pAuroraMgr->GetIOMapControlMgrPtr()->SetMemoryBitToDevice(IO_BOARD_READ_OUTPUT_000, false);
#else
		m_pAuroraMgr->GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_EQ_BUZZER, false);
#endif // _USE_IOBOARD
	}
	
	// 알람이 클리어 됬으니 ReportAlarm 창을 표시한다.
	GetParent()->SendMessage(WM_MSG_UPDATE_CHANGE_VIEW_STATE, (WPARAM)enumNavigateID_ALARM, NULL);

	CMCCLogMgr::GetInstance()->SetMCC_Alarm(id, FALSE);

//	m_pAuroraMgr->GetIOMapControlMgrPtr()->SetSinalTowerIdle();

	return 0;
}

void CDlgSubAlarm::ShowReportAlarm()
{
	CLogWrapper::GetInstance()->KMLOG(OPER, _T("CD_MainAlarm::ShowReportAlarm"));

	ShowWindow(SW_SHOW);

	if (CAlarmController::GetInstance()->GetAlarmCount() <= 0)
	{
		CAlarmController::GetInstance()->GetAlarmWnd()->ShowWindow(SW_HIDE);
		CAlarmController::GetInstance()->GetReportAlarmWnd()->ShowWindow(SW_SHOW);
	}
	else
	{
		CAlarmController::GetInstance()->GetAlarmWnd()->ShowWindow(SW_SHOW);
		CAlarmController::GetInstance()->GetReportAlarmWnd()->ShowWindow(SW_HIDE);
	}
}

void CDlgSubAlarm::OnBnClickedButtonReload()
{
	// TODO: 여기에 컨트롤 알림 처리기 코드를 추가합니다.
	CString str;
	str.Format(_T("ALARM LIST 를 갱신하시겠습니까??"));

	if (AfxMessageBox(str, MB_YESNO | MB_ICONQUESTION) == IDYES)
	{
		CAlarmController::GetInstance()->ReLoadAlarmList(CSystemParamShare::GetInstance()->GetAlarmFolderPath());
	}
}


void CDlgSubAlarm::OnBnClickedButtonAlarmSearch()
{
	// TODO: 여기에 컨트롤 알림 처리기 코드를 추가합니다.
	CAlarmController::GetInstance()->GetAlarmWnd()->ShowWindow(SW_HIDE);
	CAlarmController::GetInstance()->GetReportAlarmWnd()->ShowWindow(SW_SHOW);
}


void CDlgSubAlarm::OnBnClickedButtonAlarm()
{
	// TODO: 여기에 컨트롤 알림 처리기 코드를 추가합니다.
	CAlarmController::GetInstance()->GetAlarmWnd()->ShowWindow(SW_SHOW);
	CAlarmController::GetInstance()->GetReportAlarmWnd()->ShowWindow(SW_HIDE);
}


CString CDlgSubAlarm::BoolToString(BOOL bItem)
{
	CString strRtn = _T("");

	if (bItem == 0) strRtn = _T("X");
	else			strRtn = _T("O");

	return strRtn;
}

void CDlgSubAlarm::CIMAlarmReportInfo(int nAlarmID)
{
	// TODO: 여기에 구현 코드 추가.
	bool bCIMAlarmNotReport = false, bModelChangeAlarm = false, bCurGlsOneAlarm = false, bValidation = false;
	bCIMAlarmNotReport = m_pAuroraMgr->GetSystemConfigMgrPtr()->IsUseCIMAlarmNotReport();
	bModelChangeAlarm = m_pAuroraMgr->GetSystemConfigMgrPtr()->IsUseModelChangeAlarm();
	bCurGlsOneAlarm = m_pAuroraMgr->GetSystemConfigMgrPtr()->IsUseCurGlsOneAlarm();
//	bValidation = 

	CString str;
	str.Format(_T("Alarm ID %d, ManualNotReport : %s, Model Case : %s, Glass Case : %s, NoAlarmStatus : %s"), nAlarmID, BoolToString(bCIMAlarmNotReport),
		BoolToString(bModelChangeAlarm), BoolToString(bCurGlsOneAlarm), BoolToString(bValidation));
	CLogWrapper::GetInstance()->KMLOG(WARN, str);

	CSequenceManager::GetInstance()->EngineStop();  // LYS 2026-07-20 stop sequence

	m_pAuroraMgr->GetCommTcpIpFactoryMgrPtr()->GetCommTcpIpObjectCIM()->Cmd_Send_AT0();
}
