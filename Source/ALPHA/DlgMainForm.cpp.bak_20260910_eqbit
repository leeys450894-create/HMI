void CDlgMainForm::SetMCCSignal()
{
	bool bMccSignal[100];
	ZeroMemory(&bMccSignal, sizeof(bMccSignal));
	int nBit = 0;

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_LOADER_ARM_SENSOR_01);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_ENTRY_ARM] = false;
		}
		else
		{
			bMccSignal[MCC_S_X_ENTRY_ARM] = true;
		}
	}

	bool bSensorOff = false;
	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitExport(PLC_BIT_W_GLASS_SENSOR_POWER_ON);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_GLASS_EXIST] = true;
			bSensorOff = true;
		}
	}

	if (bSensorOff != true)
	{
		for (int iGlassShort = 0; iGlassShort < 4; iGlassShort++)
		{
			nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_GLASS_EXIST_01 + iGlassShort);
			if (nBit != -1)
			{
				if (nBit == 1)
				{
					bMccSignal[MCC_S_X_GLASS_EXIST] |= true;
				}
				else
				{
					bMccSignal[MCC_S_X_GLASS_EXIST] |= false;
				}
			}
		}
	}
	

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_UP01);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PIN_UP] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PIN_UP] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_LIFT_PIN_SENSOR_DOWN01);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PIN_DOWN] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PIN_DOWN] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_UNLOAD_SENSOR03);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_SAFETY_ON] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_SAFETY_ON] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_R_MOTION_LOADER_DEGREE_0);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_0] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_0] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_R_MOTION_LOADER_DEGREE_1);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_1] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_1] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_R_MOTION_LOADER_DEGREE_2);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_2] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_2] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_R_MOTION_LOADER_DEGREE_3);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_3] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_LOADER_ROT_POS_3] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_RUN_TEACH_SWITCH);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_RUN_AUTO_SWITCH] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_RUN_AUTO_SWITCH] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_SUTTER_SENSOR_OPEN);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PLC_SHUTTER_OPEN] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PLC_SHUTTER_OPEN] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_SUTTER_SENSOR_CLOSE);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PLC_SHUTTER_CLOSE] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PLC_SHUTTER_CLOSE] = false;
		}
	}


	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_INITIALIZE_COMPLETE);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PLC_INIT] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PLC_INIT] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_STATE_READY);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PLC_READY] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PLC_READY] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_STATE_LOAD);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PLC_LOAD] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PLC_LOAD] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_STATE_MEASURE);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_X_PLC_MEAS] = true;
		}
		else
		{
			bMccSignal[MCC_S_X_PLC_MEAS] = false;
		}
	}

	// LYS 2026-06-26 OCP: only check P5 (index 4)
	int nProbeStart = (m_pAuroraMgr->GetSystemConfigMgrPtr() && m_pAuroraMgr->GetSystemConfigMgrPtr()->IsOCP()) ? 4 : 0;

	int nProbeExistNum[5] = { MCC_S_X_PROBE_EXIST_01 , MCC_S_X_PROBE_EXIST_02, MCC_S_X_PROBE_EXIST_03, MCC_S_X_PROBE_EXIST_04, MCC_S_X_PROBE_EXIST_05 };
	for (int iProbe = nProbeStart; iProbe < 5; iProbe++)
	{
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeExistSensorOn(iProbe) == true)
		{
			bMccSignal[nProbeExistNum[iProbe]] = true;
		}
		else
		{
			bMccSignal[nProbeExistNum[iProbe]] = false;
		}
	}

	int nPcbNum[5] = { MCC_S_X_PCB_LOCK_01 , MCC_S_X_PCB_LOCK_02, MCC_S_X_PCB_LOCK_03, MCC_S_X_PCB_LOCK_04, MCC_S_X_PCB_LOCK_05 };
	for (int iProbe = nProbeStart; iProbe < 5; iProbe++)
	{
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbePCBFold(iProbe + df_PROBE_AGING1) == true)
		{
			bMccSignal[nPcbNum[iProbe]] = true;
		}
		else
		{
			bMccSignal[nPcbNum[iProbe]] = false;
		}
	}
	
	int nClampNum[5] = { MCC_S_X_CLAM_LOCK_01 , MCC_S_X_CLAM_LOCK_02, MCC_S_X_CLAM_LOCK_03, MCC_S_X_CLAM_LOCK_04, MCC_S_X_CLAM_LOCK_05 };
	for (int iProbe = nProbeStart; iProbe < 5; iProbe++)
	{
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeClampFold(iProbe + df_PROBE_AGING1) == true)
		{
			bMccSignal[nClampNum[iProbe]] = true;
		}
		else
		{
			bMccSignal[nClampNum[iProbe]] = false;
		}
	}
	
	int nZeroNum[5] = { MCC_S_X_ZERO_LOCK_01 , MCC_S_X_ZERO_LOCK_02, MCC_S_X_ZERO_LOCK_03, MCC_S_X_ZERO_LOCK_04, MCC_S_X_ZERO_LOCK_05 };
	for (int iProbe = nProbeStart; iProbe < 5; iProbe++)
	{
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeZerolockSensorOn(iProbe + df_PROBE_AGING1) == true)
		{
			bMccSignal[nZeroNum[iProbe]] = true;
		}
		else
		{
			bMccSignal[nZeroNum[iProbe]] = false;
		}
	}
	
	int nPcbUnlockNum[5] = { MCC_S_X_PCB_UNLOCK_01 , MCC_S_X_PCB_UNLOCK_02, MCC_S_X_PCB_UNLOCK_03, MCC_S_X_PCB_UNLOCK_04, MCC_S_X_PCB_UNLOCK_05 };
	for (int iProbe = nProbeStart; iProbe < 5; iProbe++)
	{
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbePCBUnFold(iProbe + df_PROBE_AGING1) == true)
		{
			bMccSignal[nPcbUnlockNum[iProbe]] = true;
		}
		else
		{
			bMccSignal[nPcbUnlockNum[iProbe]] = false;
		}
	}

	int nClampUnlockNum[5] = { MCC_S_X_CLAM_UNLOCK_01 , MCC_S_X_CLAM_UNLOCK_02, MCC_S_X_CLAM_UNLOCK_03, MCC_S_X_CLAM_UNLOCK_04, MCC_S_X_CLAM_UNLOCK_05 };
	for (int iProbe = nProbeStart; iProbe < 5; iProbe++)
	{
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeClampUnFold(iProbe + df_PROBE_AGING1) == true)
		{
			bMccSignal[nClampUnlockNum[iProbe]] = true;
		}
		else
		{
			bMccSignal[nClampUnlockNum[iProbe]] = false;
		}
	}

	int nZeroUnlockNum[5] = { MCC_S_X_ZERO_UNLOCK_01 , MCC_S_X_ZERO_UNLOCK_02, MCC_S_X_ZERO_UNLOCK_03, MCC_S_X_ZERO_UNLOCK_04, MCC_S_X_ZERO_UNLOCK_05 };
	for (int iProbe = nProbeStart; iProbe < 5; iProbe++)
	{
		if (CSequenceManager::GetInstance()->GetFunctionModuleEQState()->IsProbeZeroUnlockSensorOn(iProbe + df_PROBE_AGING1) == true)
		{
			bMccSignal[nZeroUnlockNum[iProbe]] = true;
		}
		else
		{
			bMccSignal[nZeroUnlockNum[iProbe]] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_INITIALIZE);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_Y_PLC_INIT] = true;
		}
		else
		{
			bMccSignal[MCC_S_Y_PLC_INIT] = false;
		}
	}


	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_MEAS2READY_START);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_Y_PLC_READY] = true;
		}
		else
		{
			bMccSignal[MCC_S_Y_PLC_READY] = false;
		}
	}

	nBit = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_READY2MEAS_START);
	if (nBit != -1)
	{
		if (nBit == 1)
		{
			bMccSignal[MCC_S_Y_PLC_MEAS] = true;
		}
		else
		{
			bMccSignal[MCC_S_Y_PLC_MEAS] = false;
		}
	}




	for (size_t i = 0; i < MCC_S_PLC_END; i++)
	{
		if (bMccSignal[i] != m_bMccSignal[i])
		{
			if (bMccSignal[i] == true)
			{
				CMCCLogMgr::GetInstance()->SetMCC_Signal(i, true); 
			}
			else
			{
				CMCCLogMgr::GetInstance()->SetMCC_Signal(i, false);
			}

			m_bMccSignal[i] = bMccSignal[i];
		}
	}
}

