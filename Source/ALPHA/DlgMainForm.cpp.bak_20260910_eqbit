void CDlgMainForm::__RefreshListData2()
{
	m_gridListIOnfo.SetRedraw(FALSE);

	bool bHomeDone = false, bChkPos = false, bChkNeg = false;
	int i = 0;
	CString strData;
	CIOMapControlMgr* pImpl = nullptr;
	pImpl = m_pAuroraMgr->GetIOMapControlMgrPtr();
	if (pImpl != nullptr)
	{
		for (int nIO = 4000; nIO < 4000 + _df_MAX_IO_INFO; nIO++)
		{
			// Number 
			strData.Format(_T("%s"), pImpl->GetParam_DIOMapAddressBitImport(nIO));
			strData.TrimRight();
			if (strData.IsEmpty())
				continue;

			m_gridListIOnfo.GetCell(i + 1, enumColumnName2_No)->SetFormat(DT_CENTER | DT_VCENTER | DT_SINGLELINE);
			m_gridListIOnfo.SetItemState(i + 1, enumColumnName2_No, GVIS_READONLY);
