	m_vecpMainSubDlg[enumNavigateID_RESULT_DATA] = dynamic_cast<CMainSubDlgWin*>(new CDlgSubData(pAuroraMgr));
////	m_vecpMainSubDlg[enumNavigateID_RESULT_DATA] = dynamic_cast<CMainSubDlgWin*>(new CD_MainResultData(pAuroraMgr->GetResultCollectMgrPtr()));
	m_vecpMainSubDlg[enumNavigateID_MAINT] = dynamic_cast<CMainSubDlgWin*>(new CDlgSubMaint(pAuroraMgr));
