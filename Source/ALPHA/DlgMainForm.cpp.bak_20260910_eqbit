void CDlgMainForm::__InitialListData()
{
	// 결과값 리스트를 갱신한다.
	m_gridListMotionInfo.DeleteAllItems();
	m_gridListMotionInfo.SetColumnCount(enumColumnName_End);
	m_gridListMotionInfo.SetFixedRowCount(1);

	for (long n = 0; n < enumColumnName_End; ++n)
	{
		m_gridListMotionInfo.SetColumnWidth(n, ColumnSize[n]);
		m_gridListMotionInfo.SetItemText(0, n, ColumnName[n]);
		m_gridListMotionInfo.SetItemState(0, n, GVIS_READONLY);
		m_gridListMotionInfo.SetItemBkColour(0, n, RGB(172, 172, 172));
		m_gridListMotionInfo.SetItemFgColour(0, n, RGB(255, 255, 255));
	}

	int iMaxMotion = 0;
	CMotorControlMgr *pImpl = nullptr;
	pImpl = m_pAuroraMgr->GetMaintControlMgr()->GetMotorControlMgrPtr();
	if (pImpl != nullptr)
	{
		for (int iAxis = 0; iAxis < AXIS_TYPE_END; iAxis++)
		{
			if (pImpl->GetAxisProperty(iAxis)->bUse == FALSE)
				continue;

			iMaxMotion++;
		}
	}

	// Items + Header
	m_gridListMotionInfo.SetEditable(TRUE);

	m_gridListMotionInfo.SetRowCount(iMaxMotion + 1);	// Axis type end 
//	m_gridListMotionInfo.SetRowCount(_df_MAX_MOTION +1);	// Axis type end 

	m_gridListMotionInfo.SetRowHeight(0, 18);
	for (long i = 0; i < iMaxMotion; i++)
	{
		m_gridListMotionInfo.SetRowHeight(i + 1, 15);
	}

	__RefreshListData();
}


