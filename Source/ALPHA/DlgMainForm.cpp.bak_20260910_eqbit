int CDlgMainForm::TerminateWorkerThread()
{
	m_bCloseSystem = true;

	if (m_pWorkThread != NULL)	// jsyoon 20141126 add
	{
		SetEvent(m_hEvtKillThread);
	}

	for (int i = 0; i < MAIN_CCD_MAX_NUM; i++)
	{
		if (m_pMainAlignCCD[i] != nullptr)
		{
			m_pMainAlignCCD[i]->TerminateWorkerThread();
		}
	}

	return 0;
}


int CDlgMainForm::WaitTerminateWorkerThread()
{
	if (m_pWorkThread != NULL)	// jsyoon 20141126 add
	{
		if (WaitForSingleObject(m_hEvtThreadKilled, 1000)
			== WAIT_OBJECT_0)
		{
			m_pWorkThread = NULL;
		}
	}

	if (m_pWorkThread == NULL)
		TRACE("m_pWorkThread NULL @@@@@@@@@@@\n");

	return 0;
}

UINT CDlgMainForm::WorkThreadProbeProc(LPVOID pParam)
{
	CDlgMainForm* pProc = (CDlgMainForm*)pParam;

	while (TRUE)
	{
		// m_hEvtKillThread Event 시그널이 Set 되면 Loop를 빠져 나간다
		if (WaitForSingleObject(pProc->m_hEvtKillThread, 50)
			== WAIT_OBJECT_0)
		{
			break; // Terminate this thread by exiting the proc.
		}

		///////////////////////////////
		pProc->GetMonitor();	//실제 작업을 진행하는 함수
	}

	SetEvent(pProc->m_hEvtThreadKilled);				// "나(쓰레드) 죽었다"라고 해 줌

	return 0;
}

