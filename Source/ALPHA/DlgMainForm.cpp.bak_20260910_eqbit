	m_vecpMainSubDlg[enumNavigateID_RECIPE] = dynamic_cast<CMainSubDlgWin*>(new CDlgSubRecipe(pAuroraMgr));
	m_vecpMainSubDlg[enumNavigateID_SYSTEM_LOG] = dynamic_cast<CMainSubDlgWin*>(new CDlgSubLog(pAuroraMgr));
	m_vecpMainSubDlg[enumNavigateID_CONFIG] = dynamic_cast<CMainSubDlgWin*>(new CDlgSubConfig(pAuroraMgr));
	m_vecpMainSubDlg[enumNavigateID_ALARM] = dynamic_cast<CMainSubDlgWin*>(new CDlgSubAlarm(pAuroraMgr));

	// Navi
	m_pMainNavigateDlg = new CDlgNaviBar(pAuroraMgr);

	// CCD
	for (int  i = 0; i < MAIN_CCD_MAX_NUM; i++)
	{
		m_pMainAlignCCD[i] = new CDlgAlignCCD(pAuroraMgr, i);
	}

	// Alarm
//	m_pPopUp_AlarmDlg = nullptr;
	m_pPopUp_AlarmDlg = new CD_PopUp_Alarm_F(pAuroraMgr->GetMaintControlMgr());

	//----------------------------------------------------------
	// FONT 만들기
	//----------------------------------------------------------
	LOGFONT lf;
	memset(&lf, 0, sizeof(LOGFONT));
	lf.lfHeight = 15;
	_tcscpy_s(lf.lfFaceName, _countof(lf.lfFaceName), _T("Arial"));
	VERIFY(m_logFont.CreateFontIndirect(&lf));

	m_hEvtKillThread = CreateEvent(NULL, FALSE, FALSE, NULL);	// auto reset, initially Reset
	m_hEvtThreadKilled = CreateEvent(NULL, FALSE, FALSE, NULL);	// auto reset, initially Reset

	ZeroMemory(&m_stTriggerInfo, sizeof(m_stTriggerInfo));
	ZeroMemory(&m_stMoterInfo, sizeof(m_stMoterInfo));
	ZeroMemory(&m_bMccSignal, sizeof(m_bMccSignal));
	
}

CDlgMainForm::~CDlgMainForm()
{
	// 2023.03.06 add
	KillTimer(MAIN_STATE_TIMER_ID);
	KillTimer(MAIN_STATE_TIMER_ID + 1);
	KillTimer(MAIN_STATE_TIMER_ID + 2);
	KillTimer(MAIN_STATE_TIMER_ID + 3);

	WaitTerminateWorkerThread();

	for (int i = 0; i < MAIN_CCD_MAX_NUM; i++)
	{
		if (m_pMainAlignCCD[i])
		{
			m_pMainAlignCCD[i]->DestroyWindow();
			delete m_pMainAlignCCD[i];
			m_pMainAlignCCD[i] = nullptr;
		}
	}

	if (m_pMainNavigateDlg)
	{
		m_pMainNavigateDlg->DestroyWindow();
		delete m_pMainNavigateDlg;
		m_pMainNavigateDlg = nullptr;
	}

	if (m_pPopUp_AlarmDlg)
	{
		m_pPopUp_AlarmDlg->DestroyWindow();
		delete m_pPopUp_AlarmDlg;
		m_pPopUp_AlarmDlg = nullptr;
	}

	// 2023.03.06 add
	for (int i = 0; i < m_vecpMainSubDlg.size(); ++i)
	{
		if (m_vecpMainSubDlg[i])
		{
			m_vecpMainSubDlg[i]->DestroyWindow();
			delete m_vecpMainSubDlg[i];
			m_vecpMainSubDlg[i] = nullptr;
		}
	}

	m_logFont.DeleteObject();

	CloseHandle(m_hEvtKillThread);
	CloseHandle(m_hEvtThreadKilled);
}

