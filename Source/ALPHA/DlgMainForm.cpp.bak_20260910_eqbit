LRESULT CDlgMainForm::OnUpdateChangeNotInitialize(WPARAM wp, LPARAM lp)
{
	for (size_t i = 0; i < m_vecpMainSubDlg.size(); ++i)
	{
		if (i == enumNavigateID_OPERATE || i == enumNavigateID_ALARM)
			continue;

		if (m_vecpMainSubDlg[i])
		{
			m_vecpMainSubDlg[i]->EnableWindow(FALSE);
		}
	}

	return 0;
}

LRESULT CDlgMainForm::OnUpdateChangeInitialize(WPARAM wp, LPARAM lp)
{
	// 하위 창들에게 정보를 전달한다.
	bool bInitialize = (bool)lp;
	

	for (size_t i = 0; i < m_vecpMainSubDlg.size(); ++i)
	{
		if (m_vecpMainSubDlg[i])
		{
			m_vecpMainSubDlg[i]->EnableWindow(TRUE);

			if (bInitialize == true)
				m_vecpMainSubDlg[i]->UpdateChangeInitialize();

			m_vecpMainSubDlg[i]->ShowWindow(SW_HIDE);
		}
	}

	m_vecpMainSubDlg[enumNavigateID_OPERATE]->ShowWindow(SW_SHOW);


	// 툴바도 업데이트 해준다.
	m_pMainNavigateDlg->UpdateChangeInitialize();

	return 0;
}

