			m_vecpMainSubDlg[i]->UpdateCycleInspectionComplete();
		}
	}

	// 툴바도 업데이트 해준다.
	m_pMainNavigateDlg->UpdateCycleInspectionComplete();

	m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->SetMemoryBitToDevice(PLC_BIT_W_GLASS_SENSOR_POWER_ON, false);	// jsyoon 2022.05.26 add

	bool bFail = (bool)lp;
	if (bFail == true)
	{
		CD_DisplayMessage dlg(_T("The Inspection is Fail.!!"));
		dlg.DoModal();
	}
	else
	{
		// 검사 완료 확인 버튼을 표시해준다.
		if (CSystemParamShare::GetInstance()->IsForceStopByUser() == true)
		{
			CSystemParamShare::GetInstance()->SetForceStopByUser(false);

			//CD_DisplayMessage dlg(_T("Stoped By User!!"));
			//dlg.DoModal();

			CD_DisplayMessage dlg(_T("Need to initialize.. because, force stop by user!!"));
			dlg.DoModal();
		}
		else
		{
			if (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() != df_HOST_ONLINE_REMOTE)
			{
				CD_DisplayMessage dlg(_T("The Inspection is Complete.!!"));
				dlg.DoModal();
			}
		}
	}

	// cycle mode 가 완료 되었으므로 
	CSystemParamShare::GetInstance()->SetCycleState(false);

//	m_pAuroraMgr->GetIOMapControlMgrPtr()->SetSinalTowerIdle();

	return 0;
}



