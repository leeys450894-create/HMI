			}
			else
			{
				for (long n = enumColumnName2_Value1; n < enumColumnName2_End; ++n)
				{
					m_gridListIOnfo.SetItemBkColour(i + 1, n, CLR_GRAY);
				}
			}

			i++;
		}
	}

	m_gridListIOnfo.ExpandColumnsToFit(TRUE);
	m_gridListIOnfo.SetRedraw(TRUE, TRUE);
}

