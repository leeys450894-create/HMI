void CDlgMainForm::OnTimer(UINT_PTR nIDEvent)
{
	// TODO: 여기에 메시지 처리기 코드를 추가 및/또는 기본값을 호출합니다.
	if (nIDEvent == MAIN_STATE_TIMER_ID)
	{
		UpdateInformation();
	}

	else if (nIDEvent == MAIN_STATE_TIMER_ID+1)
	{
		KillTimer(MAIN_STATE_TIMER_ID + 1);
		//--------------------------------------------------------------------
		// 알람을 처리 할 수 있도록 Monitoring 을 시작한다.
		//--------------------------------------------------------------------
		m_pAuroraMgr->GetAlarmMonitorMgrPtr()->SetMonitoringStart();
	}

	else if (nIDEvent == MAIN_STATE_TIMER_ID+2)
	{
		__RefreshListData2();
	}

	else if (nIDEvent == MAIN_STATE_TIMER_ID + 3)
	{
		if (m_pPopUp_AlarmDlg)
		{
			int nRet = 0;
			nRet = m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_STATE_ALARM) || m_pAuroraMgr->GetMaintControlMgr()->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_BIT_STATE_WARN);

			if (nRet != -1)
			{
				if (nRet == 1)
				{
					m_pPopUp_AlarmDlg->ShowWindow(SW_SHOW);
				}
				else
				{
					m_pPopUp_AlarmDlg->ShowWindow(SW_HIDE);
				}
			}
		}

	//	CWindowEventHandler::GetInstance()->SendMessageToUI(enumWndID_FRAME, WM_MSG_UPDATE_POSITION_STATE, enumDoWorkStateID_WORK_SACC_End, NULL);
	}

	CD_AuroraDlgWin::OnTimer(nIDEvent);
}


