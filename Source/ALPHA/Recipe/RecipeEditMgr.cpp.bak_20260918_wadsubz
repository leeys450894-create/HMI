int	CRecipeEditMgr::SetDetectAlignPtrn(int nIndex)
{
	int nRet = VTM_RV_SUCCESSED;

	float Score = 1.0;
	float MaxSorce = -1;
	
	double dPixelx = 0, dPixely = 0;
	CPtrnInfo ptrnInfo[df_MAX_PTRNINFO];
	for (size_t i = 0; i < df_MAX_PTRNINFO; i++)
	{
		ptrnInfo[i].ClearInfo();
	}

	S_Align* pAlignInfo = nullptr;
	pAlignInfo = &GetRecipeMgrPtr()->m_sAlign;

	CPtrnInfo* pPtrnInfo = NULL;

	bool bGlass = true;

	int iCCD = 0;
	switch (nIndex)
	{
	case 0:
	{
		for (size_t k = 0; k < df_MAX_PTRNINFO; k++)
		{
			if (k < 5)
			{
				ptrnInfo[k].m_nThreshold = pAlignInfo->m_sCcdSet.m_sFrontLeft.m_nMatchingScore;
				ptrnInfo[k].m_strName.Format(_T("%s"), pAlignInfo->m_chPtnFrontLeft[k]);
			}
		}

		iCCD = 0;
	}
	break;
	case 1:
	{
		for (size_t k = 0; k < df_MAX_PTRNINFO; k++)
		{
			if (k < 5)
			{
				ptrnInfo[k].m_nThreshold = pAlignInfo->m_sCcdSet.m_sFrontRight.m_nMatchingScore;
				ptrnInfo[k].m_strName.Format(_T("%s"), pAlignInfo->m_chPtnFrontRight[k]);
			}

		}

		iCCD = 1;
	}
	break;
	case 2:
	{
		for (size_t k = 0; k < df_MAX_PTRNINFO; k++)
		{
			if (k < 5)
			{
				ptrnInfo[k].m_nThreshold = pAlignInfo->m_sCcdSet.m_sBackLeft.m_nMatchingScore;
				ptrnInfo[k].m_strName.Format(_T("%s"), pAlignInfo->m_chPtnBackLeft[k]);
			}

		}

		iCCD = 0;

		bGlass = false;
	}
	break;
	case 3:
	{
		for (size_t k = 0; k < df_MAX_PTRNINFO; k++)
		{
			if (k < 5)
			{
				ptrnInfo[k].m_nThreshold = pAlignInfo->m_sCcdSet.m_sBackRight.m_nMatchingScore;
				ptrnInfo[k].m_strName.Format(_T("%s"), pAlignInfo->m_chPtnBackRight[k]);
			}

		}

		iCCD = 1;

		bGlass = false;
	}
	break;
	case 4:
	{
		for (size_t k = 0; k < df_MAX_PTRNINFO; k++)
		{
			if (k < 5)
			{
				ptrnInfo[k].m_nThreshold = pAlignInfo->m_sCcdSet.m_sBackLeft.m_nMatchingScore;
				ptrnInfo[k].m_strName.Format(_T("%s"), pAlignInfo->m_chPtnBackLeft[k]);
			}

		}

		iCCD = 2;

		bGlass = false;
	}
	break;
	case 5:
	{
		for (size_t k = 0; k < df_MAX_PTRNINFO; k++)
		{
			if (k < 5)
			{
				ptrnInfo[k].m_nThreshold = pAlignInfo->m_sCcdSet.m_sBackRight.m_nMatchingScore;
				ptrnInfo[k].m_strName.Format(_T("%s"), pAlignInfo->m_chPtnBackRight[k]);
			}

		}

		iCCD = 3;

		bGlass = false;
	}
	break;
	default:
		break;
	}


	// 이미지 패턴 매칭
	for (size_t k = 0; k < 5; k++)	// Pattern
	{
		pPtrnInfo = &ptrnInfo[k];
		nRet = m_pMgrPool_link->pAlignCameraMgr[iCCD]->PtrnMatch(pPtrnInfo, &Score, LENS_USE_ALIGN, bGlass);
		if (nRet == VTM_RV_SUCCESSED)
		{
			if (Score > MaxSorce)
			{
				MaxSorce = Score;
				dPixelx = pPtrnInfo->m_dRealX;	// 차이값(mm)
				dPixely = pPtrnInfo->m_dRealY;	// 차이값(mm)
			}

			break;
		}
	}

	return nRet;
}

