	, m_pMgrPool_link(&MgrPool)
{
	SetName(_T("RECIPE_EDIT_MGR"));	
	m_bRecipeDeleteFlag = false;
	m_iTestModeLastStick = -1;	// LYS 2026-09-18 TestMode MOVE : 아직 선택된 스틱 없음

	m_ptrnReview.ClearPtrn();

	m_pRecipeFunc = nullptr;

	//----------------------------------------------------------------------
	// Thread 생성
	//----------------------------------------------------------------------
	m_pThread = AfxBeginThread(ThreadRun, this);
	m_bThreadLive = false;
	m_hCloseEvent = CreateEvent(NULL, FALSE, FALSE, NULL);	// auto reset, initial reset

	
}

CRecipeEditMgr::~CRecipeEditMgr(void)
{
	Finalize();
}

bool CRecipeEditMgr::Initialize()
{
	CString strRecipeID = _T("DEFAULT");

	m_pBinaryHelper->SetFilePath(CSystemParamShare::GetInstance()->GetDefaultRecipeFolderPath() + strRecipeID + _RCP_EXT_FILE_NAME);
	m_pIniHelper->SetFilePath(CSystemParamShare::GetInstance()->GetDefaultRecipeFolderPath() + strRecipeID + _RCP_EXT_FILE_NAME);

	bool ret = LinkDataBase(false);

	m_strRecipeID = _T("");


	

	return ret;
}

void CRecipeEditMgr::Finalize()
{
	//----------------------------------------------------------------------
   // Thread 종료
   //----------------------------------------------------------------------
	if(m_bThreadLive == true)
	{ 
		SetEvent(m_hCloseEvent);
	}
		
	if(m_pRecipeData)
	{
		delete m_pRecipeData;
		m_pRecipeData = nullptr;
	}

	if (m_pBinaryHelper)
	{
		delete m_pBinaryHelper;
		m_pBinaryHelper = nullptr;
	}

	if (m_pIniHelper)
	{
		delete m_pIniHelper;
		m_pIniHelper = nullptr;
	}

	if (m_pThread && m_bThreadLive)
	{
		WaitForSingleObject(m_pThread->m_hThread, INFINITE);

		if (m_hCloseEvent) CloseHandle(m_hCloseEvent);

		m_pThread = nullptr;
	}
}

int CRecipeEditMgr::RecipeChange(CString strRecipeID)
{

	// 레시피 명이 없다. - 문제네..
	if (strRecipeID.IsEmpty())
	{
		CLogWrapper::GetInstance()->KMLOG(OPER, _T("Fail : Recipe Name is Empty"));
		return -1;
	}

	//// 이미 OPEN 한 레시피 명이다. 그냥 OK 날리자.
	//if (m_strRecipeID == strRecipeID && !GetRecipePosDeleteFlag())
	//{
	//	return 1;
	//}


//	m_pRecipeFunc = GetRecipeMgr(); //220317
	if (m_pRecipeFunc->LoadRcpFile(strRecipeID) != TRUE)
	{
		return  JOB_RECIPE_NOT_EXIST;
	}

	CString strAlignRecipe;
	strAlignRecipe.Format(_T("%s"), GetRecipeInfo()->m_sOptionItem.m_chAlignName);
	if (m_pRecipeFunc->LoadAlignRcpFile(strAlignRecipe) != TRUE)
	{
		return  JOB_RECIPE_NOT_EXIST;
	}

	// for Test 
	m_strRecipeID = strRecipeID;

	RecipeUpdateUI();

	return 1;

	// 새로운 레시피를 OPEN 한다.
	m_strRecipeFileFullPath.Format(_T("%s\\%s%s"), m_strRecipeFolderPath.GetString(), strRecipeID.GetString(), _RCP_EXT_FILE_NAME);
	m_strRecipeFileFullPath.Replace(_T("\\\\"), _T("\\"));

 	//m_pBinaryHelper->SetFilePath(m_strRecipeFileFullPath);
	m_pIniHelper->SetFilePath(m_strRecipeFileFullPath);

	SetRecipePosDeleteFlag(false);

	bool bRet = false;

	//if (m_pBinaryHelper->IsReadEnable())
	if (m_pIniHelper->IsReadEnable())
	{
		m_strRecipeID = strRecipeID;

		bRet = LinkDataBase(false);

		if (bRet == false)
		{
			CLogWrapper::GetInstance()->KMLOG(OPER, _T("Fail : Recipe Open"));
		}
	}
	else
	{
		CLogWrapper::GetInstance()->KMLOG(OPER, _T("Fail : can not read Recipe file"));
	}
	return (bRet == true) ? 2 : -1;
}

