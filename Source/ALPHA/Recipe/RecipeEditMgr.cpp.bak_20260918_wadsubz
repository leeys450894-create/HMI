void CRecipeEditMgr::UpdateRecipeList()
{
	m_vecRcpList.clear();

	// find List
	CString sFind;
	sFind.Format(_T("%s%s%s"), m_strRecipeFolderPath.GetString(), STR_DIR_RECIPE, _RCP_ALL_FILE_NAME);

	CFileFind find;
	BOOL bFound = find.FindFile(sFind);
	while (bFound)
	{
		bFound = find.FindNextFile();

        if (find.IsDots()) continue;
        if (find.IsDirectory()) continue;

		FILETIME refTime;
		find.GetLastWriteTime(&refTime);
		SYSTEMTIME st;
		if(FileTimeToSystemTime(&refTime, &st))
		{
			SRECIPE_FILEINFO temp;
			temp.strName = find.GetFileName();
			temp.strName.Replace(_RCP_EXT_FILE_NAME, _T(""));
			temp.strDate.Format(_T("%04d%02d%02d_%02d:%02d:%02d"), st.wYear, st.wMonth, st.wDay, st.wHour,st.wMinute, st.wSecond);
					
			m_vecRcpList.push_back(temp);
		}
		
		Sleep(1);
	}

	find.Close();
}

