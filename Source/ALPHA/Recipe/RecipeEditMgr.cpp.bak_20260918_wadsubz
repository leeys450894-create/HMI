bool CRecipeEditMgr::SaveRecipe(CString strRecipeID)
{
	m_strRecipeFileFullPath.Format(_T("%s%s%s"), m_strRecipeFolderPath.GetString(), strRecipeID.GetString(), _RCP_EXT_FILE_NAME);

	CString sTime;
	SYSTEMTIME st;
	::GetLocalTime(&st);
	sTime.Format(_T("%04d%02d%02d-%02d%02d%02d"), st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);

	CString strNewRecipeFilePath, strBackupRecipeFile;
	strNewRecipeFilePath.Format(_T("%s%s\\%s"), m_strRecipeFolderPath.GetString(), _T("BACKUP"), strRecipeID.GetString() );
	MakeDir(strNewRecipeFilePath);
	strBackupRecipeFile.Format(_T("%s\\%s_%s%s"), strNewRecipeFilePath, strRecipeID.GetString(), sTime, _RCP_EXT_FILE_NAME);

	// Backup
	if (CopyFile(m_strRecipeFileFullPath, strBackupRecipeFile, FALSE) == TRUE)
	{
		//m_pBinaryHelper->SetFilePath(m_strRecipeFileFullPath);

		m_pIniHelper->SetFilePath(m_strRecipeFileFullPath);

		//if (m_pBinaryHelper->IsReadEnable())
		if (m_pIniHelper->IsReadEnable())
		{
			return LinkDataBase(true);
		}
	}

	return false;
}

