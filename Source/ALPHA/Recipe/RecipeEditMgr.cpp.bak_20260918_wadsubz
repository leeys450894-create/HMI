							}
						}

						if (nRet != VTM_RV_SUCCESSED)
						{
							CAlarmController::GetInstance()->SetAlarm(nRet);
						}
					}
				}
				break;
				case M_CMD_CCD_SET:
				{
					int iLampIntensity = pRecipeEvent->m_sRunState.m_nData[2];
					int iExposureTime = pRecipeEvent->m_sRunState.m_nData[0];
					int iCCDGain = pRecipeEvent->m_sRunState.m_nData[1];
