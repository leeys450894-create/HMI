	//Calc Multi Head Index Step 1
	int nMultiHeadIndex = 0;

	for (int i = 0; i < m_pRecipeData->GetParam_RecipeMeasAreaCount(); i++)
	{
		if (m_pRecipeData->GetParam_RecipeMeasArea(i)->nMultiHeadMeasArea >= 0) continue;

