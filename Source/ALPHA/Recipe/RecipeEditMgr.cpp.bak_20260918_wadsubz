				case M_CMD_GLASS_GET_POS:
				{
					pRecipeEvent->m_sRunState.m_fData[0] = m_pMgrPool_link->pMaintControlMgr->GetCurPos(AXIS_X); // < -STAGE Y
					pRecipeEvent->m_sRunState.m_fData[1] = m_pMgrPool_link->pMaintControlMgr->GetCurPos(AXIS_LOADER_R); // < -STAGE ROTATE
					pRecipeEvent->m_sRunState.m_fData[2] = m_pMgrPool_link->pMaintControlMgr->GetCurPos(AXIS_X2); // < -BACK Y
