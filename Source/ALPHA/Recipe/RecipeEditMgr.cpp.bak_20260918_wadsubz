// LYS 2026-09-09 Stick별 PROBE Z CONTACT OFFSET - 레시피 STAGE MOVE 그리드 5행(CONTACT OFFSET). End Contact 목표(End+OD)에만 가산, PreContact/UnContact 높이는 스틱 공통
double CRecipeEditMgr::GetStickProbeZOffset(int iStick)
{
	S_RecipeData* pData = GetRecipeData();
	if (pData == nullptr) return 0.0;
	if (iStick < 0 || iStick >= (int)pData->m_vecStick.size()) return 0.0;

	double dOffset = pData->m_vecStick[iStick].m_fProbeZOffset;
	const double dLimit = 1.0;	// mm - 오입력 보호(프로브 과압입 방지)
	if (fabs(dOffset) > dLimit)
	{
		CString strLog;
		strLog.Format(_T("Stick %d PROBE Z CONTACT OFFSET %.4f exceeds +/-%.1f mm -> clamped"), iStick + 1, dOffset, dLimit);
		CLogWrapper::GetInstance()->KMLOG(WARN, strLog);
		dOffset = (dOffset > 0.0) ? dLimit : -dLimit;
	}
	return dOffset;
}

UINT CRecipeEditMgr::ThreadRun(LPVOID p1)
{
	CRecipeEditMgr* pThis = (CRecipeEditMgr*)p1;

	pThis->m_bThreadLive = true;

	while (1)
	{
		// Close Event 가 set될 때까지 기다린다.
		if (WaitForSingleObject(pThis->m_hCloseEvent, 10) == WAIT_OBJECT_0)
		{
			break;
		}

		pThis->ThreadRun();
	}

	pThis->m_bThreadLive = false;

	return 0;
}

UINT CRecipeEditMgr::ThreadRun()
{
	VTM_RECIPE* pRecipeEvent = nullptr;
	pRecipeEvent = Recipe_GetSharedMemory();
	if (pRecipeEvent != nullptr)
	{
		if (pRecipeEvent->m_sRunState.m_nRunStatus != M_RUN_REQ)
		{
			return 0;
		}

		if (GetShareMemoryMgrPtr() != nullptr)
		{
			// 2023.08.09 add Online Interlock
			if ( GetShareMemoryMgrPtr()->GetSys_MachineMode() != df_HOST_OFFLINE )
			{
				CD_DisplayMessage dlg(_T("Onlien 모드 입니다. OFFLine 변경 후 사용하세요."));
				dlg.DoModal();

				pRecipeEvent->m_sRunState.m_nRunStatus = M_RUN_NG;
				return 0;
			}

			// 2023.08.09 add Process Interlock
			if ( GetShareMemoryMgrPtr()->GetSys_ProcessStatus() != SPS_IDLE || CSequenceManager::GetInstance()->IsEngineCompleteAll() != true)
			{
				// LYS 2026-09-16 거부 사유를 OCP 로그에 남긴다(모달은 이 워커 스레드에서 뜨므로 메인 창 뒤에 숨을 수 있다)
				{
					CString strLog;
					strLog.Format(_T("Recipe cmd %d rejected - ProcessStatus=%d, EngineCompleteAll=%d"), (int)pRecipeEvent->m_sRunState.m_dwData1, GetShareMemoryMgrPtr()->GetSys_ProcessStatus(), CSequenceManager::GetInstance()->IsEngineCompleteAll() ? 1 : 0);
					CLogWrapper::GetInstance()->KMLOG(WARN, strLog);
				}
				CD_DisplayMessage dlg(_T("프로세스 진행 중 입니다. 정지 후 사용하세요."));
				dlg.DoModal();

				pRecipeEvent->m_sRunState.m_nRunStatus = M_RUN_NG;

				return 0;
			}

			if (GetShareMemoryMgrPtr()->GetSys_MachineMode() == df_HOST_OFFLINE && GetShareMemoryMgrPtr()->GetSys_ProcessStatus() == SPS_IDLE )
			{
				GetShareMemoryMgrPtr()->SetSys_ProcessStatus(SPS_CYCLETEST);

				pRecipeEvent->m_sRunState.m_nRunStatus = M_RUN_PROC;

				bool bCmdNG = false;	// LYS 2026-09-16 Align PROC 실패 시 M_RUN_NG 로 응답

				switch (pRecipeEvent->m_sRunState.m_dwData1)
				{
					// Set
				case M_CMD_SHOW_REF_SET:
				{
					double dPos = 0;
					dPos = m_pMgrPool_link->pMaintControlMgr->GetCurPos(AXIS_X3);	// jsyoon 2022.05.10 add 
					if (fabs(dPos) < 15)
					{ 
						switch (pRecipeEvent->m_sRunState.m_dwData2)
						{
						case M_HEAD_FRONT_LEFT:
							SetROIAlignPtrn(0);
							break;
						case M_HEAD_FRONT_RIGHT:
							SetROIAlignPtrn(1);
							break;
						case M_HEAD_BACK_LEFT:
							SetROIAlignPtrn(2);
							break;
						case M_HEAD_BACK_RIGHT:
							SetROIAlignPtrn(3);
							break;
						default:
							break;
						}
					}
					else
					{
						switch (pRecipeEvent->m_sRunState.m_dwData2)
						{
						case M_HEAD_FRONT_LEFT:
							SetROIAlignPtrn(0);
							break;
						case M_HEAD_FRONT_RIGHT:
							SetROIAlignPtrn(1);
							break;
						case M_HEAD_BACK_LEFT:
							SetROIAlignPtrn(0);
							break;
						case M_HEAD_BACK_RIGHT:
							SetROIAlignPtrn(1);
							break;
						default:
							break;
						}
					}
				}
				break;
				case M_CMD_PATTERN_SEARCH:
				{
					if (GetRecipeMgrPtr() != nullptr)
					{
						GetRecipeMgrPtr()->m_sAlign.Clear();

						GetRecipeMgrPtr()->m_sAlign = pRecipeEvent->m_sAlign;

						int nRet = VTM_RV_SUCCESSED;

						S_Align* pAlignInfo = nullptr;
						pAlignInfo = &GetRecipeMgrPtr()->m_sAlign;


						double dPos = 0;
						dPos = m_pMgrPool_link->pMaintControlMgr->GetCurPos(AXIS_X3);	// jsyoon 2022.05.10 add 
						if (fabs(dPos) < 15)
						{
							switch (pRecipeEvent->m_sRunState.m_dwData2)
							{
							case M_HEAD_FRONT_LEFT:

								pAlignInfo->m_sCcdSet.m_sFrontLeft.m_nMatchingScore = pRecipeEvent->m_sRunState.m_nData[0];
								memcpy(pAlignInfo->m_chPtnFrontLeft[0], pRecipeEvent->m_sRunState.m_chData1, sizeof(wchar_t) * CH_LEN);

								nRet = SetDetectAlignPtrn(0);
								break;
							case M_HEAD_FRONT_RIGHT:

								pAlignInfo->m_sCcdSet.m_sFrontRight.m_nMatchingScore = pRecipeEvent->m_sRunState.m_nData[0];
								memcpy(pAlignInfo->m_chPtnFrontRight[0], pRecipeEvent->m_sRunState.m_chData1, sizeof(wchar_t) * CH_LEN);
								nRet = SetDetectAlignPtrn(1);
								break;
							case M_HEAD_BACK_LEFT:

								pAlignInfo->m_sCcdSet.m_sBackLeft.m_nMatchingScore = pRecipeEvent->m_sRunState.m_nData[0];
								memcpy(pAlignInfo->m_chPtnBackLeft[0], pRecipeEvent->m_sRunState.m_chData1, sizeof(wchar_t) * CH_LEN);
								nRet = SetDetectAlignPtrn(4);
								break;
							case M_HEAD_BACK_RIGHT:

								pAlignInfo->m_sCcdSet.m_sBackRight.m_nMatchingScore = pRecipeEvent->m_sRunState.m_nData[0];
								memcpy(pAlignInfo->m_chPtnBackRight[0], pRecipeEvent->m_sRunState.m_chData1, sizeof(wchar_t) * CH_LEN);
								nRet = SetDetectAlignPtrn(5);
								break;
							default:
								break;
							}
						}
						else
						{
							switch (pRecipeEvent->m_sRunState.m_dwData2)
							{
							case M_HEAD_FRONT_LEFT:

								pAlignInfo->m_sCcdSet.m_sFrontLeft.m_nMatchingScore = pRecipeEvent->m_sRunState.m_nData[0];
								memcpy(pAlignInfo->m_chPtnFrontLeft[0], pRecipeEvent->m_sRunState.m_chData1, sizeof(wchar_t) * CH_LEN);

								nRet = SetDetectAlignPtrn(0);
								break;
