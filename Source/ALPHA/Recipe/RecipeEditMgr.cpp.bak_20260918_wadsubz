			double dPosY = m_pRecipeData->GetParam_RecipeMeasArea(j)->stMeasCoordinate.dy;

			if (fabs(dRefPosX - dPosX) < df_Gantry_Compare)
			{
				double dPos = fabs(dRefPosY - dPosY);

				if (dPos > df_Head_Gap)
				{
