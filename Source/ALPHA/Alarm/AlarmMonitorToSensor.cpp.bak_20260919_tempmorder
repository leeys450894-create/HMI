CAlarmMonitorToSensor::~CAlarmMonitorToSensor()
{
    //----------------------------------------------------------------------
    // 데이터 삭제
    //----------------------------------------------------------------------
	if(m_pSensorCurtain)
	{
		delete m_pSensorCurtain;
		m_pSensorCurtain = nullptr;
	}

	if (m_pVaccumSwitch)
	{
		delete m_pVaccumSwitch;
		m_pVaccumSwitch = nullptr;
	}

	for (size_t i = 0; i < m_vecItem.size(); ++i)
	{
		delete m_vecItem[i];
		m_vecItem[i] = nullptr;
	}

	for (size_t i = 0; i < m_vecItemFan.size(); ++i)
	{
		delete m_vecItemFan[i];
		m_vecItemFan[i] = nullptr;
	}

	for (size_t i = 0; i < m_vecItemPressure.size(); ++i)
	{
		delete m_vecItemPressure[i];
		m_vecItemPressure[i] = nullptr;
	}

	for (size_t i = 0; i < m_vecItemSmoke.size(); ++i)
	{
		delete m_vecItemSmoke[i];
		m_vecItemSmoke[i] = nullptr;
	}

	for (size_t i = 0; i < m_vecItemTemperature.size(); ++i)
	{
		delete m_vecItemTemperature[i];
		m_vecItemTemperature[i] = nullptr;
	}

	for (size_t i = 0; i < m_vecItemTemperatureLow.size(); ++i)
	{
		delete m_vecItemTemperatureLow[i];
		m_vecItemTemperatureLow[i] = nullptr;
	}

	for (size_t i = 0; i < m_vecItemLampTime.size(); ++i)
	{
		delete m_vecItemLampTime[i];
		m_vecItemLampTime[i] = nullptr;
	}

	if (m_pSafetyPLC)
	{
		delete m_pSafetyPLC;
		m_pSafetyPLC = nullptr;
	}
}

void CAlarmMonitorToSensor::SetStart()
{
	m_pSensorCurtain->SetStart();
	m_pVaccumSwitch->SetStart();

	for (size_t i = 0; i < m_vecItem.size(); ++i)
	{
		m_vecItem[i]->SetStart();
	}

	for (size_t i = 0; i < m_vecItemFan.size(); ++i)
	{
		m_vecItemFan[i]->SetStart();
	}

	for (size_t i = 0; i < m_vecItemPressure.size(); ++i)
	{
		m_vecItemPressure[i]->SetStart();
	}

	for (size_t i = 0; i < m_vecItemSmoke.size(); ++i)
	{
		m_vecItemSmoke[i]->SetStart();
	}

	for (size_t i = 0; i < m_vecItemTemperature.size(); ++i)
	{
		m_vecItemTemperature[i]->SetStart();
	}

	for (size_t i = 0; i < m_vecItemTemperatureLow.size(); ++i)
	{
		m_vecItemTemperatureLow[i]->SetStart();
	}

	for (size_t i = 0; i < m_vecItemLampTime.size(); ++i)
	{
		m_vecItemLampTime[i]->SetStart();
	}

	m_pSafetyPLC->SetStart();
}

void CAlarmMonitorToSensor::SetStop()
{
	m_pSafetyPLC->SetStop();
	m_pSensorCurtain->SetStop();
	m_pVaccumSwitch->SetStop();

	for (size_t i = 0; i < m_vecItem.size(); ++i)
	{
		m_vecItem[i]->SetStop();
	}

	for (size_t i = 0; i < m_vecItemFan.size(); ++i)
	{
		m_vecItemFan[i]->SetStop();
	}

	for (size_t i = 0; i < m_vecItemPressure.size(); ++i)
	{
		m_vecItemPressure[i]->SetStop();
	}

	for (size_t i = 0; i < m_vecItemSmoke.size(); ++i)
	{
		m_vecItemSmoke[i]->SetStop();
	}

	for (size_t i = 0; i < m_vecItemTemperature.size(); ++i)
	{
		m_vecItemTemperature[i]->SetStop();
	}

	for (size_t i = 0; i < m_vecItemTemperatureLow.size(); ++i)
	{
		m_vecItemTemperatureLow[i]->SetStop();
	}

	for (size_t i = 0; i < m_vecItemLampTime.size(); ++i)
	{
		m_vecItemLampTime[i]->SetStop();
	}

	
}
