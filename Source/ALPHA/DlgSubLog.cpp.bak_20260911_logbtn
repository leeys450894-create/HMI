CDlgSubLog::CDlgSubLog(CAuroraMgr *pAuroraMgr, CWnd* pParent /*=NULL*/)
	: CMainSubDlgWin(IDD_DLG_SUB_LOG, pParent)
	, m_pAuroraMgr(pAuroraMgr)
	, m_iCurLogFileView(enumLogItemID_DLOG)
{
	for (int i = 0; i < enumLogItemIDCount; ++i)
	{
		m_pMainLoggingFile[i] = nullptr;
	}
}

CDlgSubLog::~CDlgSubLog()
{
	

	for (int i = 0; i < enumLogItemID_DLOG; ++i)
	{
		if (m_pMainLoggingFile[i])
		{
			m_pMainLoggingFile[i]->DestroyWindow();
			delete m_pMainLoggingFile[i];
			m_pMainLoggingFile[i] = nullptr;
		}
	}
}

