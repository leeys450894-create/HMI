void CFunctionModuleProbeACC::ThreadRun()
{
	GoToInitStep();

    for (size_t i = m_lEQStatusStepStart[m_lCurrentStep]; i < m_lEQStatusStepEnd[m_lCurrentStep]; ++i)
    {
        CFunctionModuleProbeACCStep* pSeqItem = m_vecSeqStepALL[i];  

		if (pSeqItem)
		{
			if (pSeqItem->Run() == true) // 동작
			{
				GoToNextStep();
			}
            else if (GetCurStep() == GetExitStepIndex())
            {
                CString strLog;
                strLog.Format(_T("CFunctionModuleProbeACC Thread End"));
                m_pLogFileAccessor->KMLOG(INSP, strLog);
                break;
            }
            else
            {
				int nCurStep = GetCurStep();
				GoToExitStep();

				//int nExitStep = GetCurStep();
				int nExitStep = m_lEQStatusStepStart[m_lCurrentStep] + GetCurStep();
                CString strLog;
				strLog.Format(_T("CFunctionModuleProbeACC Thread NG, Start = %d, Step = %d, Exit = %d"), m_lEQStatusStepStart[m_lCurrentStep], nCurStep, nExitStep);
                m_pLogFileAccessor->KMLOG(WARN, strLog);

				this->SetFail(true, JOB_PROC_SACC_SEQ_ERROR);	// jsyoon 2022.08.30

           //   CFunctionModuleProbeACCStep* pSeqItem = m_vecSeqStepALL[m_lEQStatusStepEnd[m_lCurrentStep] - 1];
				CFunctionModuleProbeACCStep* pSeqItem = m_vecSeqStepALL[nExitStep];
                if (pSeqItem)
                {
                    pSeqItem->Run();
                } 

                return;
            }
		}
    }
}

void CFunctionModuleProbeACC::GetIOModuleProbeACC(PLCRDATA* pbIO)
{
    int nRet = -1;

    // M adress
    for (size_t i = 0; i < 2000; i++)
    {
        nRet = m_pAuroraMgrPool->pMaintControlMgr->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(4000 + i);
        if (nRet != -1)
        {
            if (nRet == 1) pbIO->bMData[i] = true;
            else           pbIO->bMData[i] = false;
        }
        else
        {
            pbIO->bMData[i] = false;
        }
    } 

//	nRet = m_pAuroraMgrPool->pMaintControlMgr->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryBitImport(PLC_PACC_AUTO_MODE);

    // D adress
    long lSize = 0;
    
    TCHAR* szProbeInfo[30];  
    for (size_t i = 0; i < 30; i++)
    {
        szProbeInfo[i] = pbIO->szData[i];
    }
  
    TCHAR** ppProbe = nullptr;
    ppProbe = szProbeInfo;
    m_pAuroraMgrPool->pMaintControlMgr->GetIOMapControlMgrPtr()->GetParam_DIOMapMemoryWordImportArray(2100, ppProbe, &lSize);


    VTM_SYSTEM* pShare = nullptr;
    pShare = m_pAuroraMgrPool->pShareMemoryMgr->GetSharedMemory();

    // 2 Buffer
    // 10 Cassette
    // 10 EQ ProbeID
    if (pShare != nullptr)
    {
        _tcscpy_s(pShare->m_szBufferPROBEID[0], _countof(pShare->m_szBufferPROBEID[0]), szProbeInfo[0]);
        _tcscpy_s(pShare->m_szBufferPROBEID[1], _countof(pShare->m_szBufferPROBEID[1]), szProbeInfo[1]);

        // LYS 2026-06-26 OCP: only write P5 PROBEID
        if (!(GetSystemConfigMgrPtr() && GetSystemConfigMgrPtr()->IsOCP()))
        {
            _tcscpy_s(pShare->m_szPROBEID[0], _countof(pShare->m_szPROBEID[0]), szProbeInfo[13]);
            _tcscpy_s(pShare->m_szPROBEID[1], _countof(pShare->m_szPROBEID[1]), szProbeInfo[14]);
            _tcscpy_s(pShare->m_szPROBEID[2], _countof(pShare->m_szPROBEID[2]), szProbeInfo[15]);
            _tcscpy_s(pShare->m_szPROBEID[3], _countof(pShare->m_szPROBEID[3]), szProbeInfo[16]);
        }
        else
        {
            // LYS 2026-09-16 OCP: P1~P4 프로브 모듈이 없으므로 D2110~D2140(szProbeInfo[13..16]) 값을 비운다.
            //                szProbeInfo[k] 는 pbIO->szData[k] 를 가리키므로 SACC DLL 의 'PROBE ID'(EQ Inside) 스프레드 1~4행도 빈칸이 되고 5행(P5, D2150)만 남는다.
            for (int k = 13; k <= 16; k++)
            {
                szProbeInfo[k][0] = _T('\0');
            }
        }
        _tcscpy_s(pShare->m_szPROBEID[4], _countof(pShare->m_szPROBEID[4]), szProbeInfo[17]);

		// jsyoon 2022.08.17 add
		_tcscpy_s(pShare->m_szCassettePROBEID[0], _countof(pShare->m_szCassettePROBEID[0]), szProbeInfo[3]);
		_tcscpy_s(pShare->m_szCassettePROBEID[1], _countof(pShare->m_szCassettePROBEID[1]), szProbeInfo[4]);
		_tcscpy_s(pShare->m_szCassettePROBEID[2], _countof(pShare->m_szCassettePROBEID[2]), szProbeInfo[5]);
		_tcscpy_s(pShare->m_szCassettePROBEID[3], _countof(pShare->m_szCassettePROBEID[3]), szProbeInfo[6]);
		_tcscpy_s(pShare->m_szCassettePROBEID[4], _countof(pShare->m_szCassettePROBEID[4]), szProbeInfo[7]);
		_tcscpy_s(pShare->m_szCassettePROBEID[5], _countof(pShare->m_szCassettePROBEID[5]), szProbeInfo[8]);
		_tcscpy_s(pShare->m_szCassettePROBEID[6], _countof(pShare->m_szCassettePROBEID[6]), szProbeInfo[9]);

		

		_tcscpy_s(pShare->m_szLoadPROBEID, _countof(pShare->m_szLoadPROBEID), szProbeInfo[2]);	// Loading Probe 
	//	_tcscpy_s(pShare->m_szLoadPROBEID, _countof(pShare->m_szLoadPROBEID), szProbeInfo[0]);	// Loading Probe 
    }
