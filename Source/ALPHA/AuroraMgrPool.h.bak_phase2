struct stAuroraMgrPool
{
	CString strAppPath;
	CString strConfigPath;
	CString strRecipePath;
	CString strLogPath;

	CLogInControlMgr		*pLogInControlMgr;
	CSystemConfigMgr		*pSystemConfigMgr;   
	CNetworkConfigMgr		*pNetworkConfigMgr;
	CPositionConfigMgr		*pPositionConfigMgr;
	CLockControlMgr			*pLockCtrlMgr;
    CRecipeEditMgr			*pRecipeEditMgr;
	CResultCollectMgr		*pResultCollectMgr;
	CIOMapControlMgr		*pIOMapControlMgr;
	CMotorControlMgr		*pMotorControlMgr;
	CPatternMatchMgr		*pPatternMatchMgr;
	CLightControlMgr		*pLightControlMgr;
	CVCRControlMgr			*pVCRControlMgr;
	CCIMControlMgr			*pCIMControlMgr;
	CAlignMatrixMgr			*pAlignMatrixMgr;
	CAlignCameraMgr			*pAlignCameraMgr[MAIN_CCD_MAX_NUM];
	CReviewCameraHead1Mgr	*pReviewCameraHead1Mgr;
	CReviewCameraHead2Mgr	*pReviewCameraHead2Mgr;
	CShareMemoryMgr			*pShareMemoryMgr;
	CMeasureItemMgr			*pMeasureItemMgr;
    CCommTcpIpFactoryMgr	*pCommTcpIpFactoryMgr;
    CCommTcpIPMgr			*pCommTcpIPMgr;
	CSensorMonitorMgr		*pSensorMonitorMgr;	
	CAlarmMonitorMgr		*pAlarmMonitorMgr;
	CSeqTactTimeMgr			*pSeqTactTimeMgr;
	CVisionConfigMgr		*pVisionConfigMgr;
	CTriggerControlMgr      *pTriggerControlMgr;
	CSEMControlMgr			*pSEMControlMgr;
	CMaintControlMgr		*pMaintControlMgr;
	CResumeInfoMgr			*pResumeInfoMgr;		// LYS 2026-07-03 Resume inspection

	stAuroraMgrPool()
	{
		pLogInControlMgr = nullptr;
		pSystemConfigMgr = nullptr;
		pNetworkConfigMgr = nullptr;
		pPositionConfigMgr = nullptr;
		pLockCtrlMgr = nullptr;
		pRecipeEditMgr = nullptr;
		pResultCollectMgr = nullptr;
		pIOMapControlMgr = nullptr;
		pMotorControlMgr = nullptr;
		pPatternMatchMgr = nullptr;
		pLightControlMgr = nullptr;
		pVCRControlMgr = nullptr;
		pCIMControlMgr = nullptr;
		pAlignMatrixMgr = nullptr;
		
		for (int i = 0; i < MAIN_CCD_MAX_NUM; i++)
		{
			pAlignCameraMgr[i] = nullptr;
		}
	
		pReviewCameraHead1Mgr = nullptr;
		pReviewCameraHead2Mgr = nullptr;
		pShareMemoryMgr = nullptr;
		pMeasureItemMgr = nullptr;
		pCommTcpIpFactoryMgr = nullptr;
		pCommTcpIPMgr = nullptr;
		pSensorMonitorMgr = nullptr;
		pAlarmMonitorMgr = nullptr;
		pSeqTactTimeMgr = nullptr;
		pVisionConfigMgr = nullptr;
		pTriggerControlMgr = nullptr;
		pSEMControlMgr = nullptr;
		pMaintControlMgr = nullptr;
		pResumeInfoMgr = nullptr;
	}
};
