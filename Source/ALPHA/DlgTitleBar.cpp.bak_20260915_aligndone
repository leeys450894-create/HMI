void CDlgTitleBar::OnTimer(UINT_PTR nIDEvent)
{
	// TODO: 여기에 메시지 처리기 코드를 추가 및/또는 기본값을 호출합니다.
	if (nIDEvent == TIMERID_PROGRAM_TIME)
	{
		UpdateTime();
	}

	if (nIDEvent == TIMERID_IO_STATE_TIME)
	{
//		SetIOStatus();
		__RefreshListData();
	}

	if (nIDEvent == TIMERID_CONNECT_STATE)
	{
		SetConnectStatus();
	}

	CD_AuroraDlgWin::OnTimer(nIDEvent);
}


void CDlgTitleBar::SetConnectStatus()
{
	COLORREF fgColor = CLR_WHITE;
	COLORREF bkColor = CLR_RED; // RGB(255, 128, 128);

	

	if (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() == df_HOST_ONLINE_REMOTE)
	{
		m_statusInfo[ID_SYSTEM][4].SetTextColor(RGB(255, 0, 0));
		m_statusInfo[ID_SYSTEM][4].SetText(_T("ONLINE REMOTE"));
	}
	else if (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_MachineMode() == df_HOST_OFFLINE)
	{
		m_statusInfo[ID_SYSTEM][4].SetTextColor(RGB(0, 0, 255));
		m_statusInfo[ID_SYSTEM][4].SetText(_T("OFFLINE"));
	}
	else
	{
		m_statusInfo[ID_SYSTEM][4].SetTextColor(RGB(0, 0, 255));
		m_statusInfo[ID_SYSTEM][4].SetText(_T("MAINT/PM"));
	}

	CString strTemp;
	if (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_AlarmStatus() > 0)
	{
		strTemp = _T("ALARM");

		m_statusInfo[ID_SYSTEM][5].SetTextColor(RGB(255, 0, 0));
		m_statusInfo[ID_SYSTEM][5].SetText(strTemp);
	}
	else
	{
		switch (m_pAuroraMgr->GetShareMemoryMgrPtr()->GetSys_ProcessStatus())
		{
		case SPS_IDLE:			strTemp = _T("IDLE");			break;
		case SPS_PROCESS:		strTemp = _T("PROCESS");		break;
		case SPS_INITIAL:		strTemp = _T("INITIAL");		break;
		case SPS_MAINT:			strTemp = _T("MAINT");			break;
		case SPS_MAINTING:		strTemp = _T("MAINTING");		break;
		case SPS_CYCLETEST:		strTemp = _T("MANUAL");			break;
		default:				strTemp = _T("");				break;
		}

		m_statusInfo[ID_SYSTEM][5].SetTextColor(RGB(0, 0, 0));
		m_statusInfo[ID_SYSTEM][5].SetText(strTemp);
	}
	
	long i = 0, n = 0;
	CMaintControlMgr* pCommMaintControlMgrPtr = nullptr;
	pCommMaintControlMgrPtr = m_pAuroraMgr->GetMaintControlMgr();
	if (pCommMaintControlMgrPtr != nullptr)
	{
		const CString strMotionName = _T("MOTION");

		fgColor = CLR_WHITE;
		bkColor = CLR_RED; // RGB(255, 128, 128);

		if (pCommMaintControlMgrPtr->IsOutOfServiceMC() == true)
		{
			fgColor = CLR_WHITE;
			bkColor = CLR_BLUE;
		}
		else
		{
			// LYS 2026-08-31 MOTION lamp 3-state: Yellow=both ACS connected, Green=init/home done, Red=not connected
			if (pCommMaintControlMgrPtr->IsConnectedMC()) 
			{
				fgColor = CLR_BLACK;
				bkColor = CLR_YELLOW;
				if (pCommMaintControlMgrPtr->IsInitializedMC())
				{
					fgColor = CLR_BLACK;
					bkColor = CLR_GREEN; //  RGB(128, 255, 128);
				}
			}
		}

		m_statusInfo[ID_CONNECT][n].ShowWindow(SW_SHOW);
		m_statusInfo[ID_CONNECT][n].SetBorder(TRUE, TRUE);
		m_statusInfo[ID_CONNECT][n].SetBkColor(bkColor);
		m_statusInfo[ID_CONNECT][n].SetTextColor(fgColor);
		m_statusInfo[ID_CONNECT][n].SetFontSize(10);
		m_statusInfo[ID_CONNECT][n].SetText(strMotionName);
		n++;

		const CString strIOName = _T("I/O");

		fgColor = CLR_WHITE;
		bkColor = CLR_RED; // RGB(255, 128, 128);

		if (pCommMaintControlMgrPtr->GetIOMapControlMgrPtr()->IsOutOfService() == true)
		{
			fgColor = CLR_WHITE;
			bkColor = CLR_BLUE;
		}
		else
		{
			if (pCommMaintControlMgrPtr->GetIOMapControlMgrPtr()->IsConnected())
			{
				fgColor = CLR_BLACK;
				bkColor = CLR_GREEN; //  RGB(128, 255, 128);
			}
		}

		m_statusInfo[ID_CONNECT][n].ShowWindow(SW_SHOW);
		m_statusInfo[ID_CONNECT][n].SetBorder(TRUE, TRUE);
		m_statusInfo[ID_CONNECT][n].SetBkColor(bkColor);
		m_statusInfo[ID_CONNECT][n].SetTextColor(fgColor);
		m_statusInfo[ID_CONNECT][n].SetFontSize(10);
		m_statusInfo[ID_CONNECT][n].SetText(strIOName);
		n++;
	}

	// LED 
	for (i = 0; i < m_pAuroraMgr->GetLightControlMgrPtr()->GetCount(); i++)
	{
		if (i > 0)
			continue;

		const CString strLEDName = m_pAuroraMgr->GetLightControlMgrPtr()->GetDeviceName(i);

		fgColor = CLR_WHITE;
		bkColor = CLR_RED; // RGB(255, 128, 128);

		if (m_pAuroraMgr->GetLightControlMgrPtr()->IsOutOfService(i) == true)
		{
			fgColor = CLR_WHITE;
			bkColor = CLR_BLUE;
		}
		else
		{
			if (m_pAuroraMgr->GetLightControlMgrPtr()->IsConnected(i))
			{
				fgColor = CLR_BLACK;
				bkColor = CLR_GREEN; //  RGB(128, 255, 128);
			}
		}

		m_statusInfo[ID_CONNECT][n].ShowWindow(SW_SHOW);
		m_statusInfo[ID_CONNECT][n].SetBorder(TRUE, TRUE);
		m_statusInfo[ID_CONNECT][n].SetBkColor(bkColor);
		m_statusInfo[ID_CONNECT][n].SetTextColor(fgColor);
		m_statusInfo[ID_CONNECT][n].SetFontSize(10);
		m_statusInfo[ID_CONNECT][n].SetText(strLEDName);

		n++;
	}

	// 
	CCommTcpIpFactoryMgr* pCommTcpIpFactoryMgrPtr = nullptr;
	pCommTcpIpFactoryMgrPtr = m_pAuroraMgr->GetCommTcpIpFactoryMgrPtr();
	if (pCommTcpIpFactoryMgrPtr != nullptr)
	{
		for (i = 0; i < 12; i++)
		{
			if( i < pCommTcpIpFactoryMgrPtr->GetCount())
			{
				if (pCommTcpIpFactoryMgrPtr->IsUsed(i) == true)		// jsyoon 2022.07.27 add
				{
					const CString strTcpIpName = pCommTcpIpFactoryMgrPtr->GetParam_Name(i);

					COLORREF fgColor = CLR_WHITE;
					COLORREF bkColor = CLR_RED; // RGB(255, 128, 128);

					if (pCommTcpIpFactoryMgrPtr->IsOutOfService(i) == true)
					{
						fgColor = CLR_WHITE;
						bkColor = CLR_BLUE;
					}
					else
					{
						if (pCommTcpIpFactoryMgrPtr->IsConnected(i))
						{
							fgColor = CLR_BLACK;
							bkColor = CLR_GREEN; //  RGB(128, 255, 128);
						}
					}

					m_statusInfo[ID_CONNECT][n].ShowWindow(SW_SHOW);
					m_statusInfo[ID_CONNECT][n].SetBorder(TRUE, TRUE);
					m_statusInfo[ID_CONNECT][n].SetBkColor(bkColor);
					m_statusInfo[ID_CONNECT][n].SetTextColor(fgColor);
					m_statusInfo[ID_CONNECT][n].SetFontSize(10);
					m_statusInfo[ID_CONNECT][n].SetText(strTcpIpName);
				}
				else
				{
					m_statusInfo[ID_CONNECT][n].ShowWindow(SW_HIDE);
				}
			}
			else
			{
				m_statusInfo[ID_CONNECT][n].ShowWindow(SW_HIDE);
			}

			n++;
		}
	}
}


