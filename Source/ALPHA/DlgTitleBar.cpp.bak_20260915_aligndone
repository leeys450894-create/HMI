				if (n == 0 || n == 1 || n == 2 || n == 8 || n == 14 || n == 15 )	// Interlock
				{
					m_gridListIOnfo.SetItemBkColour(cRow, nCol, CLR_RED);
				}
				else
				{
					m_gridListIOnfo.SetItemBkColour(cRow, nCol, CLR_YELLOW);
				}
			}
			else
				m_gridListIOnfo.SetItemBkColour(cRow, nCol, CLR_GRAY);

			n++;
		}
	}

